[{"start": 1360, "end": 3440, "text": "Loneliness and social isolation"}, {"start": 3440, "end": 7560, "text": "can weigh heavily on your mind and heart."}, {"start": 7560, "end": 8920, "text": "Social isolation"}, {"start": 8920, "end": 10480, "text": "is when we have little contact"}, {"start": 10480, "end": 11480, "text": "with others."}, {"start": 11480, "end": 13280, "text": "Loneliness is the feeling"}, {"start": 13280, "end": 14960, "text": "of being disconnected from others,"}, {"start": 14960, "end": 17160, "text": "even in a crowded room."}, {"start": 17160, "end": 19120, "text": "Both can influence our mood,"}, {"start": 19120, "end": 19960, "text": "our heart health,"}, {"start": 19960, "end": 21880, "text": "and even how well we recover"}, {"start": 21880, "end": 23720, "text": "after a heart event."}, {"start": 23720, "end": 26120, "text": "But connection changes things."}, {"start": 26120, "end": 29560, "text": "Reaching out, sharing a conversation,"}, {"start": 29560, "end": 31160, "text": "making a call,"}, {"start": 31160, "end": 34960, "text": "or taking a walk with someone can ease stress, build resilience,"}, {"start": 34960, "end": 37240, "text": "and protect your heart."}, {"start": 37240, "end": 38640, "text": "If you're finding it hard,"}, {"start": 38640, "end": 40160, "text": "you're not alone."}, {"start": 40160, "end": 43120, "text": "Talk to your doctor and visit the Heart Foundation website"}, {"start": 43120, "end": 45000, "text": "for tools and support to care"}, {"start": 45000, "end": 47960, "text": "for both your mental health and heart health."}]