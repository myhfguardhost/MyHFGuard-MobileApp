[{"start": 1080, "end": 7440, "text": "如果你想降低高胆固醇，"}, {"start": 3280, "end": 7440, "text": "简单的饮食习惯改变就能有所帮助。"}, {"start": 10800, "end": 14720, "text": "食用过多"}, {"start": 12840, "end": 17320, "text": "饱和脂肪含量高的食物会升高"}, {"start": 14720, "end": 17320, "text": "胆固醇。"}, {"start": 19360, "end": 23160, "text": "这些食物（音乐）"}, {"start": 20600, "end": 25545, "text": "饱和脂肪含量很高。 所以，最好少吃一些"}, {"start": 23160, "end": 27960, "text": "。 肥腻的加工肉类，"}, {"start": 25545, "end": 29280, "text": "如牛肉、羊肉、香肠"}, {"start": 27960, "end": 32119, "text": "和培根。"}, {"start": 29280, "end": 35160, "text": "黄油、猪油和酥油，加上全脂"}, {"start": 32119, "end": 38080, "text": "牛奶、奶酪和奶油。 热带植物油，"}, {"start": 35160, "end": 40640, "text": "例如棕榈油和椰子油。 烘焙食品，"}, {"start": 38080, "end": 42040, "text": "如糕点、馅饼、饼干和"}, {"start": 40640, "end": 43520, "text": "蛋糕。"}, {"start": 42040, "end": 46280, "text": "您还可以查看食品包装上的[音乐]交通灯"}, {"start": 43520, "end": 49320, "text": "标签，了解饱和脂肪含量。"}, {"start": 46280, "end": 52640, "text": "红色代表饱和脂肪含量高。 所以，尽量"}, {"start": 49320, "end": 52640, "text": "减少食用这些食物。"}, {"start": 54640, "end": 58680, "text": "鸡蛋、贝类和动物内脏（"}, {"start": 56800, "end": 60260, "text": "如肝脏和肾脏）"}, {"start": 58680, "end": 62680, "text": "含有一种被称为"}, {"start": 60260, "end": 63640, "text": "膳食胆固醇的胆固醇。"}, {"start": 62680, "end": 65880, "text": "但这与"}, {"start": 63640, "end": 67960, "text": "血液中的胆固醇不同。"}, {"start": 65880, "end": 69560, "text": "研究表明，膳食胆固醇"}, {"start": 67960, "end": 71000, "text": "对血液胆固醇的影响很小"}, {"start": 69560, "end": 72960, "text": "。"}, {"start": 71000, "end": 75000, "text": "因此，大多数人都可以将鸡蛋、"}, {"start": 72960, "end": 77200, "text": "贝类和动物内脏作为"}, {"start": 75000, "end": 78960, "text": "健康饮食的一部分。  [音乐]"}, {"start": 77200, "end": 80920, "text": "更重要的是减少"}, {"start": 78960, "end": 82200, "text": "饱和脂肪的摄入。"}, {"start": 80920, "end": 84880, "text": "如果您患有"}, {"start": 82200, "end": 86400, "text": "家族性高胆固醇血症这种遗传性疾病，"}, {"start": 84880, "end": 90600, "text": "您仍然需要注意"}, {"start": 86400, "end": 90600, "text": "鸡蛋等食物中的膳食胆固醇。"}, {"start": 91320, "end": 94200, "text": "有些食物可以帮助"}, {"start": 92640, "end": 96560, "text": "降低胆固醇。"}, {"start": 94200, "end": 99080, "text": "不饱和脂肪，例如橄榄油或"}, {"start": 96560, "end": 101040, "text": "植物油，以及富含纤维的食物，"}, {"start": 99080, "end": 102840, "text": "例如燕麦和大麦。"}, {"start": 101040, "end": 104840, "text": "豆类和扁豆。"}, {"start": 102840, "end": 107120, "text": "坚果和种子。"}, {"start": 104840, "end": 109240, "text": "水果和蔬菜。  [音乐]"}, {"start": 107120, "end": 111760, "text": "订阅我们的频道，获取更多专家"}, {"start": 109240, "end": 113240, "text": "建议和视频。 或者，如果您有任何关于心脏"}, {"start": 111760, "end": 116646, "text": "健康的问题，请访问"}, {"start": 113240, "end": 116646, "text": "bhf.org.uk/hearthealth。  [音乐]"}]