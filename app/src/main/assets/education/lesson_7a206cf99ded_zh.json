[{"start": 0, "end": 4950, "text": "你的心脏是泵血的肌肉"}, {"start": 2250, "end": 6960, "text": "当您有"}, {"start": 4950, "end": 9000, "text": "心力衰竭 你的心脏有麻烦"}, {"start": 6960, "end": 11309, "text": "跟上血液量"}, {"start": 9000, "end": 14009, "text": "需要泵才能正常功能"}, {"start": 11309, "end": 16139, "text": "心力衰竭称为充血性心力衰竭"}, {"start": 14009, "end": 19109, "text": "因为心有更多的烦恼"}, {"start": 16139, "end": 21449, "text": "泵送血液可能导致液体回流"}, {"start": 19109, "end": 23760, "text": "心力衰竭在身体上是一种"}, {"start": 21449, "end": 25980, "text": "慢性病无法治愈"}, {"start": 23760, "end": 28980, "text": "心力衰竭，我们希望您的心脏"}, {"start": 25980, "end": 31080, "text": "每天尽你所能地工作"}, {"start": 28980, "end": 33210, "text": "需要做出好的选择来保护"}, {"start": 31080, "end": 34670, "text": "你的心我们希望你过得好"}, {"start": 33210, "end": 37200, "text": "生活质量"}, {"start": 34670, "end": 40140, "text": "除了服用药物之外"}, {"start": 37200, "end": 42300, "text": "去心脏康复怎么办"}, {"start": 40140, "end": 44070, "text": "吃对你的帮助很重要"}, {"start": 42300, "end": 47579, "text": "你的心脏工作得很好"}, {"start": 44070, "end": 50190, "text": "这里主要介绍三样营养品"}, {"start": 47579, "end": 51210, "text": "为了心脏健康，您可以做些什么"}, {"start": 50190, "end": 54930, "text": "你有心力衰竭"}, {"start": 51210, "end": 58230, "text": "首先是遵循低盐或低盐"}, {"start": 54930, "end": 61320, "text": "饮食中钠含量不超过2000"}, {"start": 58230, "end": 63870, "text": "毫克钠这将帮助您"}, {"start": 61320, "end": 66600, "text": "心脏工作好多了请查看我们的"}, {"start": 63870, "end": 69510, "text": "低钠饮食视频详细介绍如何"}, {"start": 66600, "end": 71490, "text": "为了遵循低钠饮食，这是"}, {"start": 69510, "end": 75810, "text": "心脏饮食的重要组成部分"}, {"start": 71490, "end": 79200, "text": "失败次喝不超过64"}, {"start": 75810, "end": 81900, "text": "每天您想要的液体总量盎司"}, {"start": 79200, "end": 85200, "text": "将您的液体限制在不超过 64"}, {"start": 81900, "end": 88049, "text": "每天盎司或 2,000 毫升"}, {"start": 85200, "end": 90150, "text": "是一两升瓶的量a"}, {"start": 88049, "end": 92310, "text": "汽水我们不想让你喝汽水"}, {"start": 90150, "end": 94530, "text": "因为这对你的身体不好但是"}, {"start": 92310, "end": 96390, "text": "用量与一两升瓶是一个\n【0037】好图时要记在心里"}, {"start": 94530, "end": 98670, "text": "值得记住的好照片"}, {"start": 96390, "end": 100770, "text": "管理您的液体摄入量"}, {"start": 98670, "end": 103950, "text": "平衡您的体液和"}, {"start": 100770, "end": 106320, "text": "保持心脏健康的盐饮食"}, {"start": 103950, "end": 109170, "text": "介意你少吃盐你会"}, {"start": 106320, "end": 112950, "text": "不太口渴的限制性液体包括"}, {"start": 109170, "end": 116490, "text": "常见液体如水、果汁、牛奶"}, {"start": 112950, "end": 118290, "text": "咖啡和茶以及食品"}, {"start": 116490, "end": 122009, "text": "室温下像冰一样的液体"}, {"start": 118290, "end": 124560, "text": "奶油冰棒和果冻汤也可以"}, {"start": 122009, "end": 127079, "text": "它们是高流体的主要来源"}, {"start": 124560, "end": 129989, "text": "通常在钠中，因此最好"}, {"start": 127079, "end": 132540, "text": "完全避免这些让我们回顾一下"}, {"start": 129989, "end": 133040, "text": "跟踪您的体液的方法选择"}, {"start": 132540, "end": 135680, "text": "方法"}, {"start": 133040, "end": 138079, "text": "最适合您使用的医院"}, {"start": 135680, "end": 141319, "text": "水罐，如果你有半升"}, {"start": 138079, "end": 145969, "text": "水罐可重复装填3次"}, {"start": 141319, "end": 148670, "text": "每天1500毫升此叶"}, {"start": 145969, "end": 152180, "text": "多至500毫升用于液体和"}, {"start": 148670, "end": 155090, "text": "冰淇淋等食品中添加冰块"}, {"start": 152180, "end": 157579, "text": "服用药物或饮酒的饮品"}, {"start": 155090, "end": 159379, "text": "刷牙时的水纹"}, {"start": 157579, "end": 162250, "text": "投手上将显示有多少个"}, {"start": 159379, "end": 166069, "text": "您喝的毫升或盎司"}, {"start": 162250, "end": 169069, "text": "注意医院是否有大水源"}, {"start": 166069, "end": 173540, "text": "投手在主场使用限制一和一"}, {"start": 169069, "end": 176209, "text": "半笔芯或早上倒 64"}, {"start": 173540, "end": 179629, "text": "盎司或2,000毫升水"}, {"start": 176209, "end": 182629, "text": "放入一个大水罐或两升苏打水中"}, {"start": 179629, "end": 185359, "text": "每次饮用任何种类的瓶子"}, {"start": 182629, "end": 187430, "text": "液体倒出等量的水"}, {"start": 185359, "end": 189739, "text": "当投手是从投手"}, {"start": 187430, "end": 192889, "text": "空了你就会到达你的液体"}, {"start": 189739, "end": 196159, "text": "限时还可以倒"}, {"start": 192889, "end": 199940, "text": "总共喝入8个8盎司的