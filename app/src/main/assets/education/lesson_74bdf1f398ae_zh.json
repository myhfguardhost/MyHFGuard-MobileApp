[{"start": 3040, "end": 9240, "text": "2型糖尿病诊断可感"}, {"start": 6839, "end": 12120, "text": "压倒性的尤其是当涉及到"}, {"start": 9240, "end": 15400, "text": "食物没有放之四海而皆准的"}, {"start": 12120, "end": 18400, "text": "糖尿病饮食可增小"}, {"start": 15400, "end": 21840, "text": "对您的饮食习惯进行可控的改变"}, {"start": 18400, "end": 25039, "text": "随着时间的推移，您会看到巨大的改进"}, {"start": 21840, "end": 28119, "text": "食物分为五个主要类别"}, {"start": 25039, "end": 31640, "text": "蛋白质、碳水化合物、水果和"}, {"start": 28119, "end": 35480, "text": "蔬菜 乳制品 油脂 各"}, {"start": 31640, "end": 38800, "text": "其中有助于保持身体健康"}, {"start": 35480, "end": 41320, "text": "这不是给食品贴上好或坏的标签"}, {"start": 38800, "end": 44160, "text": "不好的是了解他们"}, {"start": 41320, "end": 47480, "text": "不同的营养价值及发现"}, {"start": 44160, "end": 51320, "text": "健康平衡最重要"}, {"start": 47480, "end": 54920, "text": "事情是要注重适度和"}, {"start": 51320, "end": 58079, "text": "控制进食份量"}, {"start": 54920, "end": 60840, "text": "食物种类丰富，用餐愉快"}, {"start": 58079, "end": 64000, "text": "健康的关键"}, {"start": 60840, "end": 67080, "text": "生活方式 有些人在什么时候会做什么"}, {"start": 64000, "end": 70119, "text": "他们第一次被诊断患有糖尿病是"}, {"start": 67080, "end": 73320, "text": "他们戒掉了所有的糖并且真的"}, {"start": 70119, "end": 75880, "text": "一两周后限制饮食"}, {"start": 73320, "end": 78680, "text": "他们的渴望达到顶峰并且"}, {"start": 75880, "end": 82799, "text": "他们最终会暴饮暴食他们吃的食物"}, {"start": 78680, "end": 85280, "text": "提前做好规划也很重要"}, {"start": 82799, "end": 87880, "text": "每周去一次杂货店并进行规划"}, {"start": 85280, "end": 91640, "text": "您的膳食和零食可以帮助您"}, {"start": 87880, "end": 95119, "text": "做出改变的更健康的选择是"}, {"start": 91640, "end": 99640, "text": "通过支持更容易参与"}, {"start": 95119, "end": 102079, "text": "你的伴侣家人或朋友的食物是"}, {"start": 99640, "end": 105399, "text": "我们的文化的很大一部分是关于如何"}, {"start": 102079, "end": 108360, "text": "我们作为一个社区团结起来，并且我们\n【0032】不想让你输"}, {"start": 105399, "end": 112040, "text": "不想让你失去"}, {"start": 108360, "end": 115479, "text": "那头发是bungol的标准盘"}, {"start": 112040, "end": 118640, "text": "现在的食品发盘是理想的"}, {"start": 115479, "end": 121680, "text": "用于2型患者的Bongol食物"}, {"start": 118640, "end": 124280, "text": "如您所见，您仍然患有糖尿病"}, {"start": 121680, "end": 126759, "text": "吃你唯一喜欢的食物"}, {"start": 124280, "end": 129200, "text": "我们改变的是部分"}, {"start": 126759, "end": 132120, "text": "每件东西的尺寸和重量"}, {"start": 129200, "end": 134640, "text": "一顿饭吃的大约一半的盘子是"}, {"start": 132120, "end": 138720, "text": "蔬菜四分之一的盘子是"}, {"start": 134640, "end": 141319, "text": "蛋白质和板的四分之一是"}, {"start": 138720, "end": 144319, "text": "碳水化合物这里还有一些东西"}, {"start": 141319, "end": 146720, "text": "记住均衡饮食包括"}, {"start": 144319, "end": 149680, "text": "多多蔬菜粗粮瘦肉"}, {"start": 146720, "end": 152440, "text": "肉类和健康脂肪要注意"}, {"start": 149680, "end": 155640, "text": "你的份量尤其是碳水化合物"}, {"start": 152440, "end": 157720, "text": "饱和脂肪和超加工食品"}, {"start": 155640, "end": 160440, "text": "采用我们刚才的制版法"}, {"start": 157720, "end": 163319, "text": "看着你的盘子里装满了一半"}, {"start": 160440, "end": 166760, "text": "蔬菜四分之一含碳水化合物和"}, {"start": 163319, "end": 170000, "text": "季度用蛋白质观察碳水化合物尝试"}, {"start": 166760, "end": 173200, "text": "全天均匀地吃碳水化合物并且"}, {"start": 170000, "end": 176000, "text": "选择全麦豆类和蔬菜"}, {"start": 173200, "end": 178840, "text": "代替白面包或含糖食品"}, {"start": 176000, "end": 181440, "text": "多吃蔬菜等纤维食物"}, {"start": 178840, "end": 184959, "text": "水果全麦豆类含量高"}, {"start": 181440, "end": 188120, "text": "吃纤维并帮助管理血糖"}, {"start": 184959, "end": 190680, "text": "如果吃零食，请经常不吃饭"}, {"start": 188120, "end": 195519, "text": "选择健康的选择，例如水果或"}, {"start": 190680, "end": 198599, "text": "坚果喝水 水是最好的饮料"}, {"start": 195519, "end": 202319, "text": "避免含糖饮料，如可乐或水果"}, {"start": 198599, "end": 204400, "text": "果汁，因为它们会升高你的血糖，所以"}, {"start": 202319, "end": 207200, "text": "你知道了，这不是关于存在\n【0065】完美就是让小稳"}, {"start": 204400, "end": 209799, "text": "完美就是让小稳定"}, {"start": 207200, "end": 213519, "text": "改善您的饮食以帮助管理"}, {"start": 209799, "end": 213519, "text": "您的二型糖尿病"}]