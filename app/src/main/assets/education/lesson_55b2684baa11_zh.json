[{"start": 1440, "end": 4920, "text": "30%的澳大利亚成年人患有高血压"}, {"start": 3760, "end": 7280, "text": "压力。"}, {"start": 4920, "end": 10120, "text": "这可能导致心脏病、中风、"}, {"start": 7280, "end": 12280, "text": "还有肾病，但这不是生命"}, {"start": 10120, "end": 14200, "text": "一句话。高血压可以是"}, {"start": 12280, "end": 15800, "text": "通过健康预防或降低"}, {"start": 14200, "end": 18160, "text": "人生选择。"}, {"start": 15800, "end": 20920, "text": "以下是降低压力的方法。"}, {"start": 18160, "end": 23880, "text": "目标是吃五份蔬菜并且"}, {"start": 20920, "end": 25760, "text": "每天两份水果。"}, {"start": 23880, "end": 26680, "text": "每天至少活动 30 分钟"}, {"start": 25760, "end": 28600, "text": "天。"}, {"start": 26680, "end": 32200, "text": "骑行、步行、"}, {"start": 28600, "end": 32200, "text": "或者尝试您喜欢的活动。"}, {"start": 32240, "end": 36400, "text": "戒烟。"}, {"start": 33960, "end": 39080, "text": "限制您的酒精摄入量。"}, {"start": 36400, "end": 41160, "text": "减少咸味食物。始终检查"}, {"start": 39080, "end": 44640, "text": "食品标签与选择产品具有"}, {"start": 41160, "end": 46640, "text": "最少的钠。保持健康的体重。"}, {"start": 44640, "end": 48240, "text": "进行这些小的改变并且已经"}, {"start": 46640, "end": 49840, "text": "定期检查血压以保持"}, {"start": 48240, "end": 53400, "text": "你的压力下降了。"}, {"start": 49840, "end": 53400, "text": "访问我们的网站以了解更多。"}]