[{"start": 0, "end": 4950, "text": "உங்கள் இதயம் இரத்தத்தை பம்ப் செய்யும் ஒரு தசை"}, {"start": 2250, "end": 6960, "text": "உங்களிடம் இருக்கும் போது உங்கள் உடலின் அனைத்து பகுதிகளுக்கும்"}, {"start": 4950, "end": 9000, "text": "இதய செயலிழப்பு உங்கள் இதயத்தில் பிரச்சனை உள்ளது"}, {"start": 6960, "end": 11309, "text": "இரத்தத்தின் அளவைக் கண்காணிப்பது"}, {"start": 9000, "end": 14009, "text": "இது இயல்பான செயல்பாட்டிற்கு பம்ப் செய்ய வேண்டும்"}, {"start": 11309, "end": 16139, "text": "இதய செயலிழப்பு கான்செஸ்டிவ் என்று அழைக்கப்படுகிறது"}, {"start": 14009, "end": 19109, "text": "ஏனெனில் இதயத்தில் அதிக பிரச்சனை உள்ளது"}, {"start": 16139, "end": 21449, "text": "இரத்தத்தை பம்ப் செய்வதால் திரவம் பின்வாங்கலாம்"}, {"start": 19109, "end": 23760, "text": "உடலில் இதய செயலிழப்பு ஏ"}, {"start": 21449, "end": 25980, "text": "நாள்பட்ட நிலைக்கு எந்த சிகிச்சையும் இல்லை"}, {"start": 23760, "end": 28980, "text": "இதய செயலிழப்பு மற்றும் உங்கள் இதயத்தை நாங்கள் விரும்புகிறோம்"}, {"start": 25980, "end": 31080, "text": "ஒவ்வொரு நாளும் உங்களால் முடிந்த அளவு வேலை செய்யுங்கள்"}, {"start": 28980, "end": 33210, "text": "பாதுகாக்க நல்ல தேர்வுகள் செய்ய வேண்டும்"}, {"start": 31080, "end": 34670, "text": "உங்கள் இதயம் உங்களுக்கு நல்லது வேண்டும் என்று நாங்கள் விரும்புகிறோம்"}, {"start": 33210, "end": 37200, "text": "வாழ்க்கைத் தரம்"}, {"start": 34670, "end": 40140, "text": "உங்கள் மருந்துகளை எடுத்துக்கொள்வதைத் தவிர"}, {"start": 37200, "end": 42300, "text": "இருதய மறுவாழ்வுக்குச் செல்வது எப்படி"}, {"start": 40140, "end": 44070, "text": "நீங்கள் சாப்பிடுவது உதவுவதில் மிகவும் முக்கியமானது"}, {"start": 42300, "end": 47579, "text": "உங்கள் இதயம் முடிந்தவரை நன்றாக வேலை செய்கிறது"}, {"start": 44070, "end": 50190, "text": "இங்கே மூன்று முக்கிய ஊட்டச்சத்து விஷயங்கள் உள்ளன"}, {"start": 47579, "end": 51210, "text": "ஆரோக்கியமான இதயத்திற்காக நீங்கள் எப்போது செய்யலாம்"}, {"start": 50190, "end": 54930, "text": "உங்களுக்கு இதய செயலிழப்பு உள்ளது"}, {"start": 51210, "end": 58230, "text": "முதலில் குறைந்த உப்பு அல்லது குறைந்த அளவைப் பின்பற்ற வேண்டும்"}, {"start": 54930, "end": 61320, "text": "சோடியம் உணவு 2,000க்கு மேல் இல்லை"}, {"start": 58230, "end": 63870, "text": "மில்லிகிராம் சோடியம் இது உங்களுக்கு உதவும்"}, {"start": 61320, "end": 66600, "text": "இதய வேலை மிகவும் சிறப்பாக உள்ளது தயவுசெய்து பார்க்கவும்"}, {"start": 63870, "end": 69510, "text": "குறைந்த சோடியம் உணவு எப்படி என்பது பற்றிய விவரங்களுக்கு வீடியோ"}, {"start": 66600, "end": 71490, "text": "குறைந்த சோடியம் உணவைப் பின்பற்ற இது ஒரு"}, {"start": 69510, "end": 75810, "text": "இதயத்திற்கான உணவின் முக்கிய பகுதி"}, {"start": 71490, "end": 79200, "text": "தோல்வி இரண்டாவதாக 64க்கு மேல் குடிக்கக்கூடாது\nநீங்கள் விரும்பும் ஒரு நாளைக்கு"}, {"start": 75810, "end": 81900, "text": "அவுன்ஸ் மொத்த திரவங்கள்"}, {"start": 79200, "end": 85200, "text": "உங்கள் திரவங்களை 64க்கு மிகாமல் கட்டுப்படுத்துங்கள்\nஒரு நாளைக்கு"}, {"start": 81900, "end": 88049, "text": "அவுன்ஸ் அல்லது 2,000 மில்லிலிட்டர்கள்"}, {"start": 85200, "end": 90150, "text": "என்பது இரண்டு லிட்டர் பாட்டிலின் அளவு a"}, {"start": 88049, "end": 92310, "text": "பாப் நீங்கள் பாப் குடிப்பதை நாங்கள் விரும்பவில்லை"}, {"start": 90150, "end": 94530, "text": "ஏனெனில் அது உங்கள் உடலுக்கு நல்லதல்ல ஆனால்"}, {"start": 92310, "end": 96390, "text": "அளவு மற்றும் இரண்டு லிட்டர் பாட்டில் a"}, {"start": 94530, "end": 98670, "text": "நல்ல படம் எப்போது மனதில் இருக்க வேண்டும்"}, {"start": 96390, "end": 100770, "text": "உங்கள் திரவ உட்கொள்ளலை நிர்வகித்தல்"}, {"start": 98670, "end": 103950, "text": "உங்கள் திரவங்களை சமநிலைப்படுத்துவது முக்கியம்"}, {"start": 100770, "end": 106320, "text": "ஆரோக்கியமான இதய உணவுக்கான உப்பு சேர்த்துக்கொள்ளுங்கள்"}, {"start": 103950, "end": 109170, "text": "நீங்கள் உப்பு குறைவாக சாப்பிட்டால் நீங்கள் இருப்பீர்கள்"}, {"start": 106320, "end": 112950, "text": "குறைந்த தாகத்தை கட்டுப்படுத்தும் திரவங்கள் அடங்கும்"}, {"start": 109170, "end": 116490, "text": "தண்ணீர் சாறு பால் போன்ற பொதுவான திரவங்கள்"}, {"start": 112950, "end": 118290, "text": "காபி மற்றும் தேநீர் மற்றும் உணவுகள்"}, {"start": 116490, "end": 122009, "text": "பனி போன்ற அறை வெப்பநிலையில் திரவம்"}, {"start": 118290, "end": 124560, "text": "கிரீம் பாப்சிகல்ஸ் மற்றும் ஜெல்லோ சூப்களும் செய்யலாம்"}, {"start": 122009, "end": 127079, "text": "அவை அதிக திரவத்தின் முக்கிய ஆதாரமாக இருக்கும்"}, {"start": 124560, "end": 129989, "text": "பொதுவாக சோடியம் உள்ளது, எனவே இது சிறந்தது"}, {"start": 127079, "end": 132540, "text": "இவற்றை முற்றிலுமாகத் தவிர்க்கவும்"}, {"start": 129989, "end": 133040, "text": "உங்கள் திரவங்களைக் கண்காணிப்பதற்கான வழிகளைத் தேர்ந்தெடுக்கவும்"}, {"start": 132540, "end": 135680, "text": "முறை\nஉங்கள் மருத்துவமனையைப் பயன்படுத்துவதற்கு"}, {"start": 133040, "end": 138079, "text": "சிறப்பாகச் செயல்படுகிறது\nஉங்களிடம் அரை லிட்டர் இருந்தால்"}, {"start": 135680, "end": 141319, "text": "தண்ணீர் குடம்"}, {"start": 138079, "end": 145969, "text": "குடத்தை மூன்று முறை நிரப்பலாம்"}, {"start": 141319, "end": 148670, "text": "ஒரு நாளைக்கு 1500 மில்லி லிட்டருக்கு இது வெளியேறுகிறது"}, {"start": 145969, "end": 152180, "text": "திரவத்திற்கு 500 மில்லிலிட்டர்கள் அதிகம் மற்றும்"}, {"start": 148670, "end": 155090, "text": "ஐஸ்கிரீம் ஐஸ் சேர்க்கும் உணவுகள்"}, {"start": 152180, "end": 157579, "text": "மருந்துகளை உட்கொள்ளுதல் அல்லது குடிப்பது"}, {"start": 155090, "end": 159379, "text": "பற்களை துலக்கும் போது நீர்\nபிட்சரில்"}, {"start": 157579, "end": 162250, "text": "எத்தனை என்பதைக் காண்பிக்கும்"}, {"start": 159379, "end": 166069, "text": "மில்லிலிட்டர்கள் அல்லது அவுன்ஸ் நீங்கள் குடிக்கலாம்"}, {"start": 162250, "end": 169069, "text": "உங்களிடம் பெரிய மருத்துவமனை தண்ணீர் இருந்தால் கவனிக்கவும்"}, {"start": 166069, "end": 173540, "text": "வீட்டில் குடம் ஒன்று மற்றும் ஒரு வரம்பை பயன்படுத்துகிறது"}, {"start": 169069, "end": 176209, "text": "பாதி நிரப்புதல் அல்லது காலையில் 64 ஊற்றவும்"}, {"start": 173540, "end": 179629, "text": "அவுன்ஸ் அல்லது 2,000 மில்லிலிட்டர்கள் தண்ணீர்"}, {"start": 176209, "end": 182629, "text": "ஒரு பெரிய குடம் அல்லது இரண்டு லிட்டர் சோடாவில்"}, {"start": 179629, "end": 185359, "text": "பாட்டில் ஒவ்வொரு முறையும் நீங்கள் எந்த வகையிலும் குடிக்கலாம்"}, {"start": 182629, "end": 187430, "text": "திரவம் அதே அளவு தண்ணீரை ஊற்றுகிறது"}, {"start": 185359, "end": 189739, "text": "குடத்தில் இருந்து பிட்சர் இருக்கும் போது"}, {"start": 187430, "end": 192889, "text": "காலியாக உங்கள் திரவத்தை அடைந்திருப்பீர்கள்\nநீங்கள் ஊற்றக்கூடிய நாளுக்கான"}, {"start": 189739, "end": 196159, "text": "வரம்பு"}, {"start": 192889, "end": 199940, "text": "மொத்தம் 8 8 அவுன்ஸ் கப்களில் குடிக்கிறார்\n64 அவுன்ஸ் அல்லது 2,000 மில்லிலிட்டர்களில்"}, {"start": 196159, "end": 202129, "text": "பயன்படுத்தப்படுகிறது"}, {"start": 199940, "end": 204609, "text": "சிறிய கோப்பைகள் மற்றும் எண்ணிக்கையை அதிகரிக்கும்\nஅதிக பான வகைகளுக்கான"}, {"start": 202129, "end": 207590, "text": "பகுதிகள்"}, {"start": 204609, "end": 209840, "text": "உங்கள் திரவங்களைக் கட்டுப்படுத்துவதைப் பார்க்கவும்\nஉங்கள் இதய செயலிழப்பு புத்தகத்தில்"}, {"start": 207590, "end": 212540, "text": "கையேடு"}, {"start": 209840, "end": 213979, "text": "கடைசியாக இதை எப்படி செய்வது என்பது பற்றிய கூடுதல் குறிப்புகள்"}, {"start": 212540, "end": 217069, "text": "நாம் மறைக்க விரும்பும் விஷயம் எடை"}, {"start": 213979, "end": 219139, "text": "நீங்கள் ஒவ்வொரு நாளும் தயவுசெய்து இருங்கள்"}, {"start": 217069, "end": 221150, "text": "பயன்படுத்திய பிறகு உங்களை எடை போடுவது உறுதி"}, {"start": 219139, "end": 223430, "text": "குளியலறை மற்றும் காலை உணவுக்கு முன் ஒவ்வொரு"}, {"start": 221150, "end": 226099, "text": "காலை அதே எடையில் உங்களை எடைபோடுங்கள்"}, {"start": 223430, "end": 228739, "text": "ஒரே எடையுள்ள ஆடைகளை அணிந்த நேரம்"}, {"start": 226099, "end": 231859, "text": "அல்லது துல்லியமாகப் பெறுவதற்கு ஆடைகள் எதுவும் இல்லை"}, {"start": 228739, "end": 234560, "text": "எடையின் அளவை கண்டிப்பாக அழைக்கவும்"}, {"start": 231859, "end": 237290, "text": "இதய செயலிழப்பு செவிலியர் நேவிகேட்டர் அல்லது உங்கள்"}, {"start": 234560, "end": 240829, "text": "நீங்கள் இரண்டு பவுண்டுகள் பெற்றால் அல்லது இருதயநோய் நிபுணர்கள்"}, {"start": 237290, "end": 243979, "text": "ஒரே நாளில் அதிகம் அல்லது நீங்கள் 5ஐப் பெற்றால்"}, {"start": 240829, "end": 246379, "text": "பவுண்டுகள் அல்லது அதற்கு மேல்"}, {"start": 243979, "end": 248959, "text": "இந்தப் பரிந்துரைகளை நீங்கள் தீவிரமாகச் செய்யலாம்"}, {"start": 246379, "end": 250819, "text": "உங்கள் நிலையை நிர்வகித்து உதவுங்கள்"}, {"start": 248959, "end": 253400, "text": "இதயத்துடன் சிறந்த வாழ்க்கைத் தரம்"}, {"start": 250819, "end": 256720, "text": "உள்ளிட்ட கூடுதல் தகவலுக்கு தோல்வி"}, {"start": 253400, "end": 259669, "text": "திரவங்களைக் கட்டுப்படுத்துதல் குறைந்த சோடியம் உணவு மெனுக்கள்"}, {"start": 256720, "end": 262190, "text": "குறைந்த சோடியம் உணவு மற்றும் எப்படி உணவற்றது"}, {"start": 259669, "end": 264380, "text": "உப்பு இல்லாத உணவைப் பார்க்கவும்"}, {"start": 262190, "end": 266590, "text": "இதைப் பற்றிய எங்கள் நோயாளி கல்வி கையேடுகள்"}, {"start": 264380, "end": 266590, "text": "தலைப்பு"}]