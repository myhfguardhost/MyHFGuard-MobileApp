[{"start": 720, "end": 1160, "text": "Hello."}, {"start": 1160, "end": 2040, "text": "My name is Hara"}, {"start": 2040, "end": 3240, "text": "and I'm a Cardiac Rehab"}, {"start": 3240, "end": 4880, "text": "Exercise Physiologist."}, {"start": 4880, "end": 6360, "text": "Today, I'm going to take you through"}, {"start": 6360, "end": 9240, "text": "some simple resistance band exercises."}, {"start": 9240, "end": 10840, "text": "Resistance bands are excellent"}, {"start": 10840, "end": 12320, "text": "at helping with mobility,"}, {"start": 12320, "end": 14840, "text": "flexibility and strength as well."}, {"start": 14840, "end": 16200, "text": "We'll be giving you some seated"}, {"start": 16200, "end": 17960, "text": "and some standing options."}, {"start": 17960, "end": 20240, "text": "I will be doing standing and Peter,"}, {"start": 20240, "end": 22400, "text": "who has done cardiac rehab in the past."}, {"start": 22400, "end": 23960, "text": "We'll be doing the seated options."}, {"start": 23960, "end": 24640, "text": "And you can pick"}, {"start": 24640, "end": 26880, "text": "whichever ones you prefer."}, {"start": 26880, "end": 27640, "text": "When you perform"}, {"start": 27640, "end": 30680, "text": "these exercises, start by inhaling first"}, {"start": 30680, "end": 33840, "text": "and as you do the exercise, you exhale."}, {"start": 33840, "end": 35880, "text": "Now we recommend you do these exercises"}, {"start": 35880, "end": 37640, "text": "about 2 to 3 times a week,"}, {"start": 37640, "end": 39640, "text": "with at least one day off in the middle,"}, {"start": 39640, "end": 41880, "text": "so that you can recover."}, {"start": 41880, "end": 43120, "text": "If you're finding the exercise"}, {"start": 43120, "end": 44520, "text": "a little bit challenging,"}, {"start": 44520, "end": 46040, "text": "then feel free to use a lighter"}, {"start": 46040, "end": 47880, "text": "resistance band."}, {"start": 47880, "end": 49560, "text": "Here are my ten favourite exercises"}, {"start": 49560, "end": 50680, "text": "that you can do at home."}, {"start": 57000, "end": 59600, "text": "The first exercise is called pull apart."}, {"start": 59600, "end": 60920, "text": "Sit or stand with your feet"}, {"start": 60920, "end": 62480, "text": "shoulder width apart."}, {"start": 62480, "end": 63480, "text": "Hold the resistance band"}, {"start": 63480, "end": 64720, "text": "out with both hands"}, {"start": 64720, "end": 67360, "text": "at shoulder level, shoulder width apart."}, {"start": 67360, "end": 68560, "text": "Keeping your arms straight"}, {"start": 68560, "end": 70320, "text": "and your palms facing down."}, {"start": 70320, "end": 71800, "text": "Pull the band out to the side"}, {"start": 71800, "end": 72840, "text": "until you feel your shoulder"}, {"start": 72840, "end": 74560, "text": "blades squeeze together."}, {"start": 74560, "end": 77120, "text": "Slowly return to the starting position."}, {"start": 77120, "end": 80120, "text": "Repeat the exercise 8 to 12 times."}, {"start": 80720, "end": 82760, "text": "To make the exercise more challenging,"}, {"start": 82760, "end": 84320, "text": "start the exercise of your hands"}, {"start": 84320, "end": 87320, "text": "close together so the band is tighter."}, {"start": 87480, "end": 89880, "text": "This exercise is called the lat pulldown."}, {"start": 89880, "end": 91240, "text": "Sit or stand with your feet"}, {"start": 91240, "end": 92680, "text": "hip width apart."}, {"start": 92680, "end": 93960, "text": "Hold a resistance band"}, {"start": 93960, "end": 95600, "text": "shoulder width apart."}, {"start": 95600, "end": 97000, "text": "Raise the band above your head"}, {"start": 97000, "end": 98560, "text": "with straight arms."}, {"start": 98560, "end": 99640, "text": "Pull your hands apart"}, {"start": 99640, "end": 100760, "text": "and lower your elbows"}, {"start": 100760, "end": 103360, "text": "until the band is just below your chin."}, {"start": 103360, "end": 105160, "text": "Slowly bring the hands back together"}, {"start": 105160, "end": 107480, "text": "and move the band back above your head."}, {"start": 107480, "end": 108800, "text": "Repeat 8 to 12 times."}, {"start": 109800, "end": 111200, "text": "To decrease the resistance."}, {"start": 111200, "end": 114000, "text": "Start with your hands further apart."}, {"start": 114000, "end": 116320, "text": "This exercise is called the dumbwaiter."}, {"start": 116320, "end": 117840, "text": "Sit or stand with your arms"}, {"start": 117840, "end": 120840, "text": "by your side and bent at 90 degrees."}, {"start": 120840, "end": 121720, "text": "Hold the resistance band"}, {"start": 121720, "end": 123800, "text": "in front of you in both hands"}, {"start": 123800, "end": 125680, "text": "so it's slightly tight."}, {"start": 125680, "end": 127320, "text": "Keep your elbows by your side"}, {"start": 127320, "end": 129360, "text": "and move your hands out to the side"}, {"start": 129360, "end": 130800, "text": "away from each other and squeeze"}, {"start": 130800, "end": 132800, "text": "your shoulder blades together."}, {"start": 132800, "end": 134000, "text": "Slowly move your hands"}, {"start": 134000, "end": 135360, "text": "back to the centre."}, {"start": 135360, "end": 137480, "text": "Repeat 8 to 12 times."}, {"start": 137480, "end": 139200, "text": "To progress this move,"}, {"start": 139200, "end": 140760, "text": "after you've moved your hands"}, {"start": 140760, "end": 141440, "text": "to the side,"}, {"start": 141440, "end": 143520, "text": "straighten your arms out to the side"}, {"start": 143520, "end": 144800, "text": "for an extra stretch."}, {"start": 146080, "end": 148240, "text": "This exercise is called the lateral raise."}, {"start": 148240, "end": 149800, "text": "Sit or stand with your feet"}, {"start": 149800, "end": 151240, "text": "hip distance apart."}, {"start": 151240, "end": 152680, "text": "Place the middle of the resistance"}, {"start": 152680, "end": 155200, "text": "band under one or both feet."}, {"start": 155200, "end": 157080, "text": "Hold the ends of the band in each hand"}, {"start": 157080, "end": 158800, "text": "so the band is tight."}, {"start": 158800, "end": 159680, "text": "Start with your arms"}, {"start": 159680, "end": 161040, "text": "slightly bent by the sides"}, {"start": 161040, "end": 163400, "text": "with your palms facing towards you."}, {"start": 163400, "end": 164320, "text": "Raise your arms"}, {"start": 164320, "end": 165600, "text": "straight out to the sides"}, {"start": 165600, "end": 167800, "text": "until they are at shoulder height."}, {"start": 167800, "end": 169360, "text": "Then slowly move your hands"}, {"start": 169360, "end": 171160, "text": "back down to your sides."}, {"start": 171160, "end": 173240, "text": "Repeat 8 to 12 times"}, {"start": 173240, "end": 174040, "text": "If you would like"}, {"start": 174040, "end": 175720, "text": "to decrease the resistance."}, {"start": 175720, "end": 177080, "text": "Instead of doing both arms"}, {"start": 177080, "end": 177880, "text": "at the same time."}, {"start": 177880, "end": 179440, "text": "You can do one at a time."}, {"start": 179440, "end": 182240, "text": "Or don't raise your arms so high."}, {"start": 182520, "end": 184680, "text": "The next exercise is called a chest press"}, {"start": 185560, "end": 186760, "text": "Start by sitting"}, {"start": 186760, "end": 187880, "text": "or standing with your feet"}, {"start": 187880, "end": 189560, "text": "hip width apart."}, {"start": 189560, "end": 191880, "text": "Pull the resistance band behind your back"}, {"start": 191880, "end": 193440, "text": "and hold the ends with both hands,"}, {"start": 193440, "end": 196080, "text": "bringing it forward under your arms."}, {"start": 196080, "end": 197120, "text": "Bring your elbows up"}, {"start": 197120, "end": 198080, "text": "and out to the sides"}, {"start": 198080, "end": 200600, "text": "with your knuckles facing forward."}, {"start": 200600, "end": 201880, "text": "Press your hands forward"}, {"start": 201880, "end": 204080, "text": "until your arms are nearly straight."}, {"start": 204080, "end": 205520, "text": "Slowly bring your arms"}, {"start": 205520, "end": 207640, "text": "back to the starting position."}, {"start": 207640, "end": 209840, "text": "Repeat 8 to 12 times."}, {"start": 209840, "end": 211360, "text": "To increase the resistance,"}, {"start": 211360, "end": 212560, "text": "start by holding the band"}, {"start": 212560, "end": 213880, "text": "tighter across your back."}, {"start": 217200, "end": 219920, "text": "This exercise is called the bicep curl."}, {"start": 219920, "end": 221880, "text": "Position the middle of the resistance band"}, {"start": 221880, "end": 223960, "text": "under one or both feet."}, {"start": 223960, "end": 226640, "text": "With your feet hip distance apart."}, {"start": 226640, "end": 228960, "text": "Hold the end of the band by your side."}, {"start": 228960, "end": 229640, "text": "With your arms"}, {"start": 229640, "end": 232680, "text": "straight down and palms facing upwards."}, {"start": 232680, "end": 234000, "text": "Slowly curl your hands"}, {"start": 234000, "end": 235280, "text": "up to your shoulders."}, {"start": 235280, "end": 237320, "text": "Whilst keeping the elbows by your sides"}, {"start": 237320, "end": 239600, "text": "and squeezing your upper arms."}, {"start": 239600, "end": 241000, "text": "Slowly release your arms"}, {"start": 241000, "end": 242800, "text": "back down to your sides."}, {"start": 242800, "end": 244840, "text": "Repeat 8 to 12 times."}, {"start": 244840, "end": 246600, "text": "To slightly reduce the resistance,"}, {"start": 246600, "end": 248520, "text": "instead of doing both arms together"}, {"start": 248520, "end": 250600, "text": "to one arm at a time,"}, {"start": 250600, "end": 252960, "text": "This is the tricep extension."}, {"start": 252960, "end": 255480, "text": "Sit or stand hip width apart."}, {"start": 255480, "end": 256400, "text": "Hold the resistance band"}, {"start": 256400, "end": 258160, "text": "on your right hip or thigh"}, {"start": 258160, "end": 259880, "text": "with your left hand."}, {"start": 259880, "end": 261560, "text": "Hold the other end of the band"}, {"start": 261560, "end": 262520, "text": "with your right hand"}, {"start": 262520, "end": 264080, "text": "and just behind your hip,"}, {"start": 264080, "end": 266760, "text": "with your elbow pointing behind you."}, {"start": 266760, "end": 268400, "text": "Slowly straighten and lift"}, {"start": 268400, "end": 270440, "text": "your right hand behind you."}, {"start": 270440, "end": 271600, "text": "As you move your arm,"}, {"start": 271600, "end": 272840, "text": "try not to move your elbow"}, {"start": 272840, "end": 274840, "text": "and avoid arching your back."}, {"start": 274840, "end": 276320, "text": "Slowly return your right hand"}, {"start": 276320, "end": 277800, "text": "back to your side."}, {"start": 277800, "end": 280160, "text": "Repeat 8 to 12 times."}, {"start": 280160, "end": 281480, "text": "To reduce resistance,"}, {"start": 281480, "end": 282840, "text": "instead of straightening the arm"}, {"start": 282840, "end": 283640, "text": "all the way."}, {"start": 283640, "end": 286040, "text": "You can straighten it some of the way."}, {"start": 286040, "end": 287880, "text": "This is the leg press."}, {"start": 287880, "end": 289160, "text": "If you're standing, stand"}, {"start": 289160, "end": 290520, "text": "hip width apart and place"}, {"start": 290520, "end": 291800, "text": "the middle of the resistance band"}, {"start": 291800, "end": 293720, "text": "under the middle of one foot."}, {"start": 293720, "end": 294880, "text": "Hold the ends of the band"}, {"start": 294880, "end": 297320, "text": "tight in front of you at chest height."}, {"start": 297320, "end": 298720, "text": "Slowly lift your knee up,"}, {"start": 298720, "end": 300920, "text": "keeping the band under your foot."}, {"start": 300920, "end": 302080, "text": "Slowly press your foot"}, {"start": 302080, "end": 304800, "text": "down to the band and towards the floor."}, {"start": 304800, "end": 305960, "text": "If you're sitting down,"}, {"start": 305960, "end": 307720, "text": "sit hip width apart and move your knee"}, {"start": 307720, "end": 309400, "text": "towards your chest."}, {"start": 309400, "end": 310680, "text": "Place the middle of the resistance"}, {"start": 310680, "end": 312960, "text": "band under the middle of one foot."}, {"start": 312960, "end": 314000, "text": "Hold the ends of the band"}, {"start": 314000, "end": 316040, "text": "tight at chest height."}, {"start": 316040, "end": 317080, "text": "Fully extend"}, {"start": 317080, "end": 317720, "text": "and straighten"}, {"start": 317720, "end": 319040, "text": "your leg out in front of you"}, {"start": 319040, "end": 320880, "text": "as far as you can."}, {"start": 320880, "end": 321640, "text": "Slowly lift"}, {"start": 321640, "end": 322400, "text": "your knee back up,"}, {"start": 322400, "end": 324640, "text": "keeping the band under your foot."}, {"start": 324640, "end": 327000, "text": "Repeat 12 to 16 times per leg."}, {"start": 328600, "end": 330440, "text": "To decrease the resistance here,"}, {"start": 330440, "end": 331720, "text": "instead of holding the band"}, {"start": 331720, "end": 334360, "text": "at your waist, hold it lower down."}, {"start": 335360, "end": 336600, "text": "This exercise is known"}, {"start": 336600, "end": 339120, "text": "as the hip abduction,"}, {"start": 339600, "end": 341920, "text": "Stand hip width apart and wrap a loose band"}, {"start": 341920, "end": 344120, "text": "or tie band around both ankles."}, {"start": 344120, "end": 344840, "text": "Slowly lift"}, {"start": 344840, "end": 345760, "text": "one of your feet out"}, {"start": 345760, "end": 346760, "text": "to the side with your leg"}, {"start": 346760, "end": 348960, "text": "straight and the foot pointed."}, {"start": 348960, "end": 351200, "text": "Lower your foot back to the ground."}, {"start": 351200, "end": 354200, "text": "Repeat this 12 to 16 times on each leg."}, {"start": 354640, "end": 356200, "text": "If you're seated,"}, {"start": 356200, "end": 357280, "text": "sit at the edge of a chair"}, {"start": 357280, "end": 358720, "text": "and wrap a looped band"}, {"start": 358720, "end": 359840, "text": "or tie a band around"}, {"start": 359840, "end": 362280, "text": "both legs just above the knees."}, {"start": 362280, "end": 363080, "text": "Place your feet"}, {"start": 363080, "end": 365640, "text": "slightly wider than your shoulders."}, {"start": 365640, "end": 367760, "text": "Slowly press your knees away from each other,"}, {"start": 367760, "end": 369200, "text": "keeping your feet steady"}, {"start": 369200, "end": 371480, "text": "as your legs move apart."}, {"start": 371480, "end": 373720, "text": "Then bring your knees back together."}, {"start": 373720, "end": 375480, "text": "Repeat 12 to 16 times."}, {"start": 377040, "end": 379160, "text": "When standing, if you feel wobbly,"}, {"start": 379160, "end": 380160, "text": "hold on to the wall"}, {"start": 380160, "end": 382120, "text": "or the back of the chair for support."}, {"start": 383840, "end": 385480, "text": "The next exercise is a squat"}, {"start": 385480, "end": 386920, "text": "or sit to stand."}, {"start": 388720, "end": 389840, "text": "If you are in standing"}, {"start": 389840, "end": 391000, "text": "stand hip width apart"}, {"start": 391000, "end": 392480, "text": "and place the middle of the resistance"}, {"start": 392480, "end": 394280, "text": "band under both feet."}, {"start": 394280, "end": 397040, "text": "Hold the ends of the bands at your waist."}, {"start": 397040, "end": 399160, "text": "Slowly lower your hips and bend the knees"}, {"start": 399160, "end": 401080, "text": "as far as this is comfortable."}, {"start": 401080, "end": 403880, "text": "Slowly move back up again into standing."}, {"start": 403880, "end": 406240, "text": "Repeat 12 to 16 times."}, {"start": 406240, "end": 407440, "text": "If you are seated,"}, {"start": 407440, "end": 408720, "text": "sit on a chair with your feet"}, {"start": 408720, "end": 410160, "text": "hip width apart."}, {"start": 410160, "end": 411640, "text": "Place the middle of the resistance"}, {"start": 411640, "end": 413960, "text": "band securely under both feet."}, {"start": 413960, "end": 415360, "text": "Hold the ends of the band"}, {"start": 415360, "end": 417960, "text": "in front of you at waist height."}, {"start": 417960, "end": 419120, "text": "Stand up while keeping"}, {"start": 419120, "end": 420040, "text": "the ends of the bands"}, {"start": 420040, "end": 421600, "text": "still at your waist."}, {"start": 421600, "end": 423640, "text": "Slowly sit back down again."}, {"start": 423640, "end": 425480, "text": "Repeat 12 to 16 times."}, {"start": 428160, "end": 430160, "text": "If you prefer to stay seated,"}, {"start": 430160, "end": 432320, "text": "try the seated leg press instead,"}, {"start": 432320, "end": 433440, "text": "which will still help"}, {"start": 433440, "end": 435160, "text": "build strength in the leg muscles."}, {"start": 436600, "end": 437480, "text": "I hope you've enjoyed"}, {"start": 437480, "end": 438680, "text": "completing these resistance"}, {"start": 438680, "end": 440480, "text": "band exercises today."}, {"start": 440480, "end": 442240, "text": "For more exercises, please visit"}, {"start": 442240, "end": 443920, "text": "the British Heart Foundation website."}]