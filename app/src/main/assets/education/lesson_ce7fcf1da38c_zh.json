[{"start": 0, "end": 1610, "text": "油由优质脂肪组成"}, {"start": 1610, "end": 3710, "text": "对心脏健康或动脉阻塞不利"}, {"start": 3710, "end": 5960, "text": "脂肪 好的脂肪包括单不饱和脂肪"}, {"start": 5960, "end": 8810, "text": "和多不饱和脂肪两者"}, {"start": 8810, "end": 11419, "text": "降低总胆固醇和降低LDL或"}, {"start": 11419, "end": 13910, "text": "坏胆固醇、坏脂肪包括"}, {"start": 13910, "end": 16010, "text": "饱和脂肪和反式脂肪两者"}, {"start": 16010, "end": 18560, "text": "提高LDL胆固醇将向您展示"}, {"start": 18560, "end": 20000, "text": "含有以下物质的食用油列表"}, {"start": 20000, "end": 21920, "text": "脂肪的最佳比例对你来说更好"}, {"start": 21920, "end": 23960, "text": "帮您挑选最适合的机油"}, {"start": 23960, "end": 24529, "text": "工作"}, {"start": 24529, "end": 26089, "text": "菜籽油是由菜籽油的种子制成的"}, {"start": 26089, "end": 28880, "text": "双低油菜植物的饱和脂肪含量低"}, {"start": 28880, "end": 30710, "text": "它具有中性的烟味。"}, {"start": 30710, "end": 33380, "text": "通常为468华氏度"}, {"start": 33380, "end": 35990, "text": "用于炒菜、烘烤、油炸"}, {"start": 35990, "end": 37880, "text": "腌制万能"}, {"start": 37880, "end": 40130, "text": "烹饪和调料自己做"}, {"start": 40130, "end": 41930, "text": "炉灶爆米花加热2"}, {"start": 41930, "end": 43490, "text": "汤匙菜籽油"}, {"start": 43490, "end": 46040, "text": "额外四分之一杯爆米花粒"}, {"start": 46040, "end": 47869, "text": "初榨橄榄油是由第一"}, {"start": 47869, "end": 50270, "text": "橄榄的压榨轻质橄榄油是"}, {"start": 50270, "end": 52010, "text": "其味道和颜色较淡"}, {"start": 52010, "end": 53869, "text": "同等热量的特级初榨"}, {"start": 53869, "end": 56810, "text": "特级初榨橄榄油果味浓郁"}, {"start": 56810, "end": 60560, "text": "大胆的淡色橄榄油是温和的烟熏油。"}, {"start": 60560, "end": 62180, "text": "埋入式油具有额外的"}, {"start": 62180, "end": 64039, "text": "处女底部320度"}, {"start": 64039, "end": 66560, "text": "华氏处女温度420度"}, {"start": 66560, "end": 69649, "text": "华氏温度460度的额外光"}, {"start": 69649, "end": 71750, "text": "华氏细雨特级初榨橄榄"}, {"start": 71750, "end": 74330, "text": "油汤面包饭"}, {"start": 74330, "end": 76190, "text": "和面食菜肴味道浓郁"}, {"start": 76190, "end": 77870, "text": "因为它是在没有任何加热或"}, {"start": 77870, "end": 79880, "text": "化学品特级初榨橄榄油具有"}, {"start": 79880, "end": 81859, "text": "味道最浓郁，适合做沙拉"}, {"start": 81859, "end": 83870, "text": "敷料和毛毛雨你不想要的"}, {"start": 83870, "end": 85340, "text": "用于煎炸或油炸"}, {"start": 85340, "end": 87440, "text": "花生油是由带壳花生制成的"}, {"start": 87440, "end": 89420, "text": "也是受欢迎的亚洲菜肴"}, {"start": 89420, "end": 92090, "text": "作为南方菜，它还不算温和"}, {"start": 92090, "end": 93710, "text": "在香料中通常用于"}, {"start": 93710, "end": 95990, "text": "炒炒深精"}, {"start": 95990, "end": 98390, "text": "烘烤时烟点高"}, {"start": 98390, "end": 99890, "text": "非常适合在各种范围内油炸"}, {"start": 99890, "end": 102590, "text": "其他烹饪请勿在烘焙或"}, {"start": 102590, "end": 105000, "text": "任何需要中性风味的东西"}, {"start": 105000, "end": 106950, "text": "如果你有搅拌机自制"}, {"start": 106950, "end": 109050, "text": "花生酱混合物 1 杯，去壳"}, {"start": 109050, "end": 111090, "text": "花生米2汤匙花生油"}, {"start": 111090, "end": 113310, "text": "淡香油具有坚果味和"}, {"start": 113310, "end": 115680, "text": "常用于炒黑芝麻"}, {"start": 115680, "end": 117930, "text": "油胆重且常用"}, {"start": 117930, "end": 120360, "text": "用烟熏调味品和酱汁。"}, {"start": 120360, "end": 122730, "text": "410华氏度精简版"}, {"start": 122730, "end": 124860, "text": "适合油炸且深色"}, {"start": 124860, "end": 126660, "text": "适合炒菜和沾酱"}, {"start": 126660, "end": 129030, "text": "一起黑芝麻油饭\n【0060】醋和葱一起炒"}, {"start": 129030, "end": 131610, "text": "醋和葱一起和教练一起搅拌"}, {"start": 131610, "end": 133860, "text": "糙米虾葵油是"}, {"start": 133860, "end": 135900, "text": "压榨葵花子的产量高"}, {"start": 135900, "end": 138030, "text": "维生素E含量低且饱和脂肪含量低"}, {"start": 138030, "end": 140400, "text": "其烟点高且味道清淡"}, {"start": 140400, "end": 142530, "text": "使其成为油炸的最爱，但"}, {"start": 142530, "end": 144300, "text": "也是烘焙用的好油"}, {"start": 144300, "end": 146100, "text": "不建议低热"}, {"start": 146100, "end": 148290, "text": "烹调或淋上葵花籽油"}, {"start": 148290, "end": 150210, "text": "微妙的味道使其非常适合烘焙"}, {"start": 150210, "end": 152130, "text": "并且它产生湿润的蛋糕，其保持"}, {"start": 152130, "end": 154410, "text": "我们用它来代替起酥油"}, {"start": 154410, "end": 157170, "text": "馅饼皮或糕点植物油"}, {"start": 157170, "end": 158760, "text": "通常由以下组合制成"}, {"start": 158760, "end": 161970, "text": "玉米、大豆和/或葵花籽和"}, {"start": 161970, "end": 163440, "text": "是另一种手头上有的好油"}, {"start": 163440, "end": 164880, "text": "因为它可以用于许多"}, {"start": 164880, "end": 167220, "text": "不同的烹饪手法其实很简单"}, {"start": 167220, "end": 169170, "text": "味道温和且常用"}, {"start": 169170, "end": 171810, "text": "炒、烤、腌制"}, {"start": 171810, "end": 174510, "text": "对于简单的腌料，只需混合 1 杯"}, {"start": 174510, "end": 177600, "text": "红糖1杯植物油半杯"}, {"start": 177600, "end": 179640, "text": "减钠酱油半杯"}, {"start": 179640, "end": 182009, "text": "醋然后加入你的三文鱼并让它"}, {"start": 182009, "end": 183990, "text": "腌制至少四个小时或"}, {"start": 183990, "end": 186150, "text": "将食用油储存在"}, {"start": 186150, "end": 188460, "text": "冰箱放在阴凉避光的地方是"}, {"start": 188460, "end": 195120, "text": "光热损伤油"}]