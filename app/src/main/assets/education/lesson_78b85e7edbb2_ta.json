[{"start": 5510, "end": 8700, "text": "[இசை]"}, {"start": 9650, "end": 12719, "text": "டக் மற்றும் மோலி அவர்கள் கடைக்குச் செல்கிறார்கள்"}, {"start": 12030, "end": 14849, "text": "மளிகை பொருட்கள்"}, {"start": 12719, "end": 17480, "text": "ஆரோக்கியமான உணவைப் பற்றி டக் கண்டுபிடித்தார்"}, {"start": 14849, "end": 17480, "text": "இதய செயலிழப்பு"}, {"start": 23019, "end": 29250, "text": "வாருங்கள் அன்பே எனக்கு டிராலி I கிடைத்தது"}, {"start": 25740, "end": 31930, "text": "குறைந்தபட்சம் ஏன் செய்யக்கூடாது என்பதைக் கண்டறிய வேண்டும்"}, {"start": 29250, "end": 33480, "text": "அந்த பையில் நீங்கள் ஒருபோதும் பெறமாட்டீர்கள்"}, {"start": 31930, "end": 35460, "text": "கண்டுபிடிக்கவும்"}, {"start": 33480, "end": 39930, "text": "இதோ"}, {"start": 35460, "end": 39930, "text": "சரி நாம் இப்போது சக்தியைப் பெறலாம் நான் தயாராக இருக்கிறேன்"}, {"start": 50210, "end": 55339, "text": "மளிகை சாமான்களை வாங்குவது நன்றாக இருந்தது"}, {"start": 53010, "end": 57480, "text": "ஷாப்பிங் முடிந்தது"}, {"start": 55339, "end": 58309, "text": "எங்களிடம் இருக்கும் முன் அவற்றைத் திறக்கலாம்"}, {"start": 57480, "end": 60870, "text": "மதிய உணவு"}, {"start": 58309, "end": 63140, "text": "உறுதிப்படுத்துவது அவ்வளவு கடினம் அல்ல என்பது உங்களுக்குத் தெரியும்"}, {"start": 60870, "end": 66780, "text": "இது போன்ற ஆரோக்கியமான உணவை நாங்கள் உண்கிறோம்"}, {"start": 63140, "end": 68970, "text": "உணவியல் நிபுணர் நாங்கள் எப்பொழுதும் நன்றாகப் பேசினார்"}, {"start": 66780, "end": 70940, "text": "காய்கறிகள் மற்றும் புதிய பழங்கள் சாப்பிட்டது அதனால் தான்"}, {"start": 68970, "end": 73610, "text": "உண்மையில் வேறு இல்லை"}, {"start": 70940, "end": 76530, "text": "எப்போதும் ஆப்பிள்களை விரும்புவார்"}, {"start": 73610, "end": 77840, "text": "எங்களிடம் சில அழகான திராட்சைகள் கிடைத்தன"}, {"start": 76530, "end": 81090, "text": "நல்ல விலையாக இருந்தது"}, {"start": 77840, "end": 85229, "text": "ஆம், எனக்கும் ஆப்பிள் பிடிக்கும்"}, {"start": 81090, "end": 89810, "text": "காய்கறிகள் இன்றும் எனக்கு ஒரு அடிப்படை கிடைத்தது"}, {"start": 85229, "end": 92149, "text": "நல்ல தக்காளி சில கேரட் மற்றும்"}, {"start": 89810, "end": 94920, "text": "ஒரு வெண்ணெய் பழம்"}, {"start": 92149, "end": 97020, "text": "எனவே சாலட் சாண்ட்விச் சாப்பிடலாம்"}, {"start": 94920, "end": 98940, "text": "நாங்கள் வழக்கமாக சாப்பிடும் சூப்பிற்கு பதிலாக மதிய உணவு"}, {"start": 97020, "end": 100640, "text": "அவரை வைத்திருங்கள், அது இனி இருக்கும் என்று நான் நினைக்கவில்லை"}, {"start": 98940, "end": 105350, "text": "முயற்சி ஓ"}, {"start": 100640, "end": 109399, "text": "எங்களிடம் சில உருளைக்கிழங்குகள் உள்ளன"}, {"start": 105350, "end": 112500, "text": "இந்த புதிய பச்சை பீன்ஸ்"}, {"start": 109399, "end": 114440, "text": "நாம் டேட்டர்ஸ் கேரட் மற்றும் சமைக்கலாம்"}, {"start": 112500, "end": 117660, "text": "பீன்ஸ் 14 ஆம்"}, {"start": 114440, "end": 119970, "text": "நீங்கள் இரண்டு சாப்பிட வேண்டும் என்று உணவியல் நிபுணர் கூறினார்"}, {"start": 117660, "end": 123539, "text": "பழத் துண்டுகள் மற்றும் தலா ஐந்து காய்கறிகள்"}, {"start": 119970, "end": 126330, "text": "நாள் நாம் அதை நிர்வகிக்க முடியும்"}, {"start": 123539, "end": 128220, "text": "எங்களின் சாண்ட்விச்களுக்கு கொஞ்சம் ரொட்டி கிடைக்கிறது"}, {"start": 126330, "end": 129289, "text": "அந்த நல்ல வீட்டை நீங்கள் எடுக்கவில்லையா?"}, {"start": 128220, "end": 131819, "text": "வாழ்க்கை ஓ"}, {"start": 129289, "end": 133560, "text": "இது மிகவும் நன்றாக இருக்கிறது நான் தொடங்கலாம்"}, {"start": 131819, "end": 136110, "text": "சாண்ட்விச்களை உருவாக்குதல் ஓ ஹேங் ஆன் ஏ"}, {"start": 133560, "end": 137790, "text": "நிமிடம் நாம் மீதமுள்ளவற்றைத் திறக்க வேண்டும்"}, {"start": 136110, "end": 141060, "text": "இந்த மளிகை சாமான்களை நாங்கள் தொடங்குவதற்கு முன்"}, {"start": 137790, "end": 143540, "text": "மதிய உணவை நான் திறக்கிறேன், நீங்கள் அவற்றை வைக்கலாம்"}, {"start": 141060, "end": 148110, "text": "பரவாயில்லை"}, {"start": 143540, "end": 150690, "text": "இங்கே பால் மற்றும் தயிர் தெரிகிறது"}, {"start": 148110, "end": 153629, "text": "எங்களுக்கு குறைந்த கொழுப்பு விருப்பங்கள் கிடைத்தது போல் ஆம்"}, {"start": 150690, "end": 156810, "text": "அது சரி குறைந்த கொழுப்பு தான் நீங்கள் இவற்றை வைக்கலாம்"}, {"start": 153629, "end": 159750, "text": "குளிர்சாதனப்பெட்டியில் நாங்கள் நன்றாக உறைந்தோம்"}, {"start": 156810, "end": 162390, "text": "சால்மன் ஸ்டீக்ஸ் நாம் தேநீருக்காக சாப்பிடலாம்"}, {"start": 159750, "end": 165890, "text": "இன்றிரவு இதோ தோல் இல்லாத கோழி"}, {"start": 162390, "end": 169680, "text": "நாம் நாளை இரவு மற்றும்"}, {"start": 165890, "end": 171720, "text": "இங்கே நாம் வைத்திருக்கக்கூடிய ஒரு டின் டுனா உள்ளது"}, {"start": 169680, "end": 174360, "text": "வாரத்தில் இது என்னை உருவாக்குகிறது"}, {"start": 171720, "end": 176300, "text": "பசிக்கிறது சீக்கிரம் வாருங்கள், அதனால் நாம் சாப்பிடலாம்"}, {"start": 174360, "end": 180510, "text": "நிறைய ஓ"}, {"start": 176300, "end": 185220, "text": "எங்களிடம் கிடைத்த சரக்கறைக்கான டின்கள் இங்கே உள்ளன"}, {"start": 180510, "end": 187319, "text": "சில வேகவைத்த பீன்ஸ் மற்றும் தக்காளிகளை நான் சோதித்தேன்"}, {"start": 185220, "end": 189930, "text": "சூப்பர் மார்க்கெட்டில் உள்ள அனைத்து லேபிள்களும்"}, {"start": 187319, "end": 192120, "text": "அவற்றில் எவ்வளவு உப்பு உள்ளது என்பதைக் கண்டறியவும்"}, {"start": 189930, "end": 193319, "text": "குறைக்கப்பட்ட உப்பைக் கண்டுபிடிக்க முடிந்தது"}, {"start": 192120, "end": 196680, "text": "அது நல்லது"}, {"start": 193319, "end": 199379, "text": "ஓ தானியங்களுக்கு ஒரு டிக் கிடைத்தது, அது இருக்க வேண்டும்"}, {"start": 196680, "end": 203629, "text": "ஒரு நல்ல தேர்வு டிக் என்றால் அது ஒரு"}, {"start": 199379, "end": 203629, "text": "ஒரு தானியத்திற்கான ஆரோக்கியமான தேர்வு ஹ்ம்ம்"}, {"start": 204260, "end": 210480, "text": "பைகளில் வேறு எதுவும் இல்லை"}, {"start": 206599, "end": 213540, "text": "ஆம் எங்களிடம் கொஞ்சம் மார்கரின் கிடைத்தது அது வேறு"}, {"start": 210480, "end": 215750, "text": "நாங்கள் பயன்படுத்தியதில் இருந்து அது குறைவு"}, {"start": 213540, "end": 219390, "text": "உப்பு பல்நிறைவுற்றது"}, {"start": 215750, "end": 221720, "text": "இது மிகவும் மலிவானது, அது ஒரு வீடு"}, {"start": 219390, "end": 221720, "text": "பிராண்ட்"}, {"start": 228500, "end": 234540, "text": "சரி, அது மதிய உணவுக்கான நேரம்"}, {"start": 232430, "end": 236549, "text": "அவர் தேர்வு செய்ய வேண்டும் என்று துகர்ஸ் கற்றுக்கொண்டார்"}, {"start": 234540, "end": 239940, "text": "இரண்டு பழங்கள் மற்றும் ஐந்து துண்டுகளை சாப்பிடுங்கள்"}, {"start": 236549, "end": 243510, "text": "காய்கறிகள் ஒவ்வொரு நாளும் குறைந்த உப்பு அல்லது குறைக்கப்பட்டது"}, {"start": 239940, "end": 245280, "text": "உப்பு உணவுகள் மற்றும் குறைந்த கொழுப்புள்ள பால் பொருட்கள் அவர்"}, {"start": 243510, "end": 247350, "text": "உப்பு அதிகம் உள்ள உணவுகளை தவிர்க்க வேண்டும்"}, {"start": 245280, "end": 250109, "text": "மற்றும் அவரது சமையலில் அல்லது உணவில் உப்பு சேர்ப்பது"}, {"start": 247350, "end": 252780, "text": "அட்டவணை அவர் ஊட்டச்சத்து படிக்க வேண்டும்"}, {"start": 250109, "end": 255120, "text": "அவர் தேர்ந்தெடுத்து வாங்கும் உணவின் மீது லேபிள்கள்"}, {"start": 252780, "end": 258139, "text": "ஹார்ட் ஃபவுண்டேஷன் டிக் கொண்ட உணவுகள்"}, {"start": 255120, "end": 258139, "text": "ஆரோக்கியமான தேர்வு"}]