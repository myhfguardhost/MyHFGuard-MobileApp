[{"start": 1170, "end": 10320, "text": "[இசை]"}, {"start": 7550, "end": 11360, "text": "நீங்கள் போது வழக்கமான உடற்பயிற்சி முக்கியமானது"}, {"start": 10320, "end": 14009, "text": "இதய செயலிழப்பு உள்ளது"}, {"start": 11360, "end": 16680, "text": "உடற்பயிற்சி லேசானது முதல் மிதமானது"}, {"start": 14009, "end": 18420, "text": "தீவிரம் உங்களுக்கு நன்மை பயக்கும்"}, {"start": 16680, "end": 21390, "text": "உங்கள் ஜிம் திட்டத்தில் கலந்துகொள்ள விரும்புகிறேன்"}, {"start": 18420, "end": 24269, "text": "மருத்துவமனை இந்த சிறப்பு குழு வகுப்புகள்"}, {"start": 21390, "end": 26910, "text": "பிசியோதெரபிஸ்ட் மற்றும் அல்லது"}, {"start": 24269, "end": 28920, "text": "நீங்கள் பேசக்கூடிய சுகாதார நிபுணர்"}, {"start": 26910, "end": 30800, "text": "பற்றி உங்கள் மருத்துவர் அல்லது பிசியோதெரபிஸ்ட்"}, {"start": 28920, "end": 33030, "text": "உங்களுக்கு சிறந்த உடற்பயிற்சி வகை"}, {"start": 30800, "end": 35390, "text": "குறைந்த எடையை நீங்கள் தேர்வு செய்யலாம்"}, {"start": 33030, "end": 38219, "text": "சைக்கிள் ஓட்டுதல் அல்லது நடைபயிற்சி"}, {"start": 35390, "end": 41070, "text": "டக் ஒவ்வொரு முறையும் 30 நிமிடங்கள் நடக்க வேண்டும்"}, {"start": 38219, "end": 43620, "text": "நாள் நீங்கள் நண்பருடன் நடக்க பரிந்துரைக்கிறோம்"}, {"start": 41070, "end": 45809, "text": "அல்லது மொபைல் போனை எடுத்துச் செல்லுங்கள்"}, {"start": 43620, "end": 48570, "text": "நீங்கள் கடுமையான மூச்சுத் திணறல் உணர்வைப் பெறுவீர்கள்"}, {"start": 45809, "end": 50610, "text": "தலைசுற்றல் அல்லது நெஞ்சு வலி இருந்தால் நினைவில் கொள்ளுங்கள்"}, {"start": 48570, "end": 53809, "text": "நீங்கள் நடக்கக்கூடிய அளவிற்கு உடற்பயிற்சி செய்யுங்கள்"}, {"start": 50610, "end": 53809, "text": "மற்றும் வசதியாக பேசுங்கள்"}, {"start": 54980, "end": 59789, "text": "ஆம், தயவுசெய்து என்னை மறைக்கச் சொன்னீர்கள்"}, {"start": 58019, "end": 61320, "text": "குறைந்த மற்றும் உங்கள் நடைகள் டக் நான் ஒரு வைக்கிறேன்"}, {"start": 59789, "end": 62940, "text": "லேசாக வெள்ளை மற்றும் நான் மட்டும்"}, {"start": 61320, "end": 64860, "text": "எந்த உடற்பயிற்சியும் செய்ய வேண்டாம்"}, {"start": 62940, "end": 66090, "text": "மனைவி எப்போதும் நான் செல்ல வேண்டும் என்று விரும்புகிறாள்"}, {"start": 64860, "end": 68460, "text": "உடற்பயிற்சி கூடம் ஆனால் நான் உண்மையில் படிக்கவே இல்லை"}, {"start": 66090, "end": 70890, "text": "அந்த லீலா பிளஸ் எனக்கு இடம் இல்லை என்று உணர்கிறேன்"}, {"start": 68460, "end": 73229, "text": "ஆமாம், அவர்கள் மருத்துவமனையில் நான் இருக்கிறேன் என்று சொன்னார்கள்"}, {"start": 70890, "end": 76530, "text": "தினமும் அரை மணி நேரம் நடைப்பயிற்சி கிடைத்தது"}, {"start": 73229, "end": 78990, "text": "மற்றும் பிசியோ நான் அதிகரிக்க வேண்டும் என்று கூறினார்"}, {"start": 76530, "end": 81600, "text": "எனது இதய செயலிழப்புக்கு உதவ எனது உடற்பயிற்சி மற்றும்"}, {"start": 78990, "end": 83930, "text": "என்னை நன்றாக உணரச் செய்யுங்கள், நாங்கள் தொடங்கினோம்"}, {"start": 81600, "end": 87229, "text": "30 நிமிடங்களுக்கு மெதுவான நடை"}, {"start": 83930, "end": 87229, "text": "போகலாம்"}, {"start": 94810, "end": 98800, "text": "ஓ தயவு செய்து நாங்கள் இதை ஒரு தந்திரமான நிலத்தைத் தொடங்குகிறோம்"}, {"start": 97270, "end": 101260, "text": "மரம் அது நன்றாகவும் தட்டையாகவும் இருக்கிறது, ஏனென்றால் நான் இருக்கிறேன்"}, {"start": 98800, "end": 103150, "text": "இதற்குப் பழக்கமில்லை, இது ஒரு நல்ல இடம்"}, {"start": 101260, "end": 105670, "text": "நடக்க நான் உடற்பயிற்சி செய்யவில்லை\nஎனக்கும்"}, {"start": 103150, "end": 108580, "text": "ஆண்டுகள், நாங்கள் உறுதி செய்ய வேண்டும்"}, {"start": 105670, "end": 109960, "text": "இதை தினமும் செய்து வருகிறோம் அது நல்லது"}, {"start": 108580, "end": 112720, "text": "உடன் நடக்க யாரையாவது வைத்திருக்க வேண்டும், ஏனென்றால் நான்"}, {"start": 109960, "end": 115300, "text": "நான் போகாமல் இருக்க சாக்குப்போக்கு சொல்வேன் என்று தெரியும்"}, {"start": 112720, "end": 116890, "text": "அதுவும் விசியோ அப்படித்தான்"}, {"start": 115300, "end": 119170, "text": "நான் நடக்கும்போது என்னால் முடியும்"}, {"start": 116890, "end": 120850, "text": "நான் உணர்ந்தால் பேசவும் அதே போல் நடக்கவும்"}, {"start": 119170, "end": 123210, "text": "பேசுவதற்கு மூச்சுத் திணறல், பின்னர் நான் பேச வேண்டும்"}, {"start": 120850, "end": 123210, "text": "ஓய்வு"}, {"start": 126540, "end": 132390, "text": "சரி ஒரு அரை மணி நேரம் ஏய் ஏன் செய்தாய்"}, {"start": 130570, "end": 134070, "text": "தொடங்குங்கள் இது மிகவும் சுவாரஸ்யமாக இருக்கிறது"}, {"start": 132390, "end": 136450, "text": "அனைத்து"}, {"start": 134070, "end": 139860, "text": "சரி நாம் நாளை மீண்டும் சந்திக்கலாம் ஆம்"}, {"start": 136450, "end": 139860, "text": "பிறகு சந்திப்போம்"}, {"start": 143220, "end": 149260, "text": "நாம் செய்யும் அளவிற்கு உடற்பயிற்சி செய்ய நினைவில் கொள்ளுங்கள்"}, {"start": 145840, "end": 151209, "text": "சுறுசுறுப்பாக நடக்கவும் பேசவும்"}, {"start": 149260, "end": 153220, "text": "நீங்கள் நன்றாக உணர உதவும்"}, {"start": 151209, "end": 156010, "text": "உந்துதலாக உணர வேண்டாம் அது முக்கியம்"}, {"start": 153220, "end": 159330, "text": "ஒவ்வொரு நாளும் சில உடற்பயிற்சிகளைச் செய்யுங்கள்"}, {"start": 156010, "end": 159330, "text": "நடை உங்கள் மனநிலையை உயர்த்தும்"}]