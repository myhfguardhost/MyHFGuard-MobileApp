[{"start": 200, "end": 3320, "text": "今天我们将向您展示如何在家测量血压。"}, {"start": 6520, "end": 7480, "text": "你好，我是艾米丽，"}, {"start": 7480, "end": 10240, "text": "英国心脏基金会的高级心脏护士。"}, {"start": 10440, "end": 11600, "text": "为了确定您的血压"}, {"start": 11600, "end": 15440, "text": "读数准确，重要的是您感到放松并且没有压力。"}, {"start": 15520, "end": 19000, "text": "检查血压前请至少休息 5 分钟。"}, {"start": 19240, "end": 20760, "text": "背部坐直"}, {"start": 20760, "end": 24520, "text": "靠在椅背上并将双脚平放在地板上。"}, {"start": 24720, "end": 28600, "text": "将您的手臂放在桌子上并确保您的手放松。"}, {"start": 28760, "end": 30680, "text": "不要握紧拳头。"}, {"start": 30680, "end": 32760, "text": "您可以测量任一手臂的血压，"}, {"start": 32760, "end": 35440, "text": "只要记住始终使用同一个即可。"}, {"start": 35440, "end": 39760, "text": "将袖带放在您的上臂上，就在肘部弯曲的上方"}, {"start": 39760, "end": 41240, "text": "且不宜过度衣物。"}, {"start": 46040, "end": 49000, "text": "管子应该沿着你手臂前部的中心延伸"}, {"start": 49000, "end": 52000, "text": "或者稍微向右。"}, {"start": 54240, "end": 55520, "text": "拉紧你手臂上的袖带，"}, {"start": 55520, "end": 58520, "text": "但确保下面仍然可以容纳 2 个手指。"}, {"start": 61240, "end": 63760, "text": "别说话。"}, {"start": 63760, "end": 65760, "text": "按下开机按钮。"}, {"start": 65760, "end": 68840, "text": "您会感觉到袖带快速充气和放气，"}, {"start": 68840, "end": 72640, "text": "这可能会感觉有点不舒服，但这只是短暂的。"}, {"start": 73600, "end": 75480, "text": "您的阅读将会显示。"}, {"start": 75480, "end": 78080, "text": "大多数血压监测仪都会保存您的读数。"}, {"start": 78080, "end": 81080, "text": "如果您的没有，请将其写下来。"}, {"start": 82040, "end": 84040, "text": "如果您的袖带太不舒服，"}, {"start": 84040, "end": 88000, "text": "只需按下停止按钮，袖带就会立即放气。"}, {"start": 88360, "end": 91200, "text": "几分钟后再次检查您的血压是个好主意"}, {"start": 91200, "end": 92240, "text": "稍后检查得知"}, {"start": 92240, "end": 94400, "text": "读数相似且准确。"}, {"start": 94400, "end": 97680, "text": "第二读数稍低是正常的。"}, {"start": 97680, "end": 100800, "text": "如果您的家庭医生要求您检查血压，请检查"}, {"start": 100800, "end": 103800, "text": "每天两次，早上一次，晚上一次。"}, {"start": 104000, "end": 105800, "text": "如果您的血压读数较高"}, {"start": 105800, "end": 109360, "text": "或者您不确定应该是什么，请咨询您的全科医生或药剂师。"}]