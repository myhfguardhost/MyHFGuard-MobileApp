[{"start": 0, "end": 3199, "text": "您知道吗？高"}, {"start": 1280, "end": 5839, "text": "胆固醇会增加您"}, {"start": 3199, "end": 8720, "text": "患心脏病或中风的风险。"}, {"start": 5839, "end": 10960, "text": "胆固醇是一种蜡状脂肪样物质，"}, {"start": 8720, "end": 13360, "text": "对新陈代谢至关重要，"}, {"start": 10960, "end": 15360, "text": "人体利用它来合成激素。"}, {"start": 13360, "end": 17440, "text": "然而，过量的胆固醇会导致"}, {"start": 15360, "end": 20560, "text": "严重的健康问题，例如"}, {"start": 17440, "end": 22640, "text": "心脏病。低密度脂蛋白胆固醇（LDL，俗称“坏"}, {"start": 20560, "end": 24960, "text": "胆固醇”）会粘附在"}, {"start": 22640, "end": 26800, "text": "动脉壁上，造成血管阻塞，"}, {"start": 24960, "end": 28800, "text": "阻碍血液流向"}, {"start": 26800, "end": 30350, "text": "心脏，从而增加您患"}, {"start": 28800, "end": 31519, "text": "心脏病或中风的风险。高密度脂蛋白"}, {"start": 31519, "end": 37440, "text": "胆固醇（HDL，俗称“好胆固醇”）则负责将"}, {"start": 34880, "end": 39600, "text": "低密度脂蛋白胆固醇从"}, {"start": 37440, "end": 43280, "text": "动脉运回肝脏进行"}, {"start": 39600, "end": 45600, "text": "分解代谢，最终作为废物排出体外，因此也被称为“"}, {"start": 43280, "end": 47840, "text": "沉默的杀手”。高"}, {"start": 45600, "end": 50160, "text": "胆固醇通常没有"}, {"start": 47840, "end": 52079, "text": "明显的症状，因此"}, {"start": 52079, "end": 57120, "text": "即使您感觉良好，定期就医检查也至关重要。虽然"}, {"start": 57120, "end": 61199, "text": "高胆固醇并非由单一原因引起，但有一些"}, {"start": 59120, "end": 63520, "text": "风险因素"}, {"start": 61199, "end": 66400, "text": "会导致这种情况，"}, {"start": 63520, "end": 69360, "text": "包括年龄、吸烟、缺乏"}, {"start": 66400, "end": 73360, "text": "运动、肥胖或超重、"}, {"start": 69360, "end": 75280, "text": "家族史以及不健康的饮食。"}, {"start": 73360, "end": 77280, "text": "大多数心脏病风险因素都"}, {"start": 75280, "end": 79439, "text": "可以通过"}, {"start": 77280, "end": 82000, "text": "改变生活方式来控制，例如改善"}, {"start": 79439, "end": 84799, "text": "饮食、增加运动量和"}, {"start": 82000, "end": 87040, "text": "戒烟。您的医生也可能会建议您服用"}, {"start": 84799, "end": 89520, "text": "某些药物来帮助降低胆固醇。"}, {"start": 87040, "end": 92479, "text": "如果您年满"}, {"start": 89520, "end": 94479, "text": "45岁（"}, {"start": 92479, "end": 96320, "text": "原住民和托雷斯海峡"}, {"start": 94479, "end": 98640, "text": "岛民30岁及以上），请定期进行"}, {"start": 96320, "end": 100880, "text": "胆固醇检测，作为心脏"}, {"start": 98640, "end": 102799, "text": "健康检查的一部分。如果您有"}, {"start": 100880, "end": 104880, "text": "早发性心脏病或"}, {"start": 102799, "end": 106560, "text": "高胆固醇家族史，也应尽早与"}, {"start": 104880, "end": 109560, "text": "医生讨论您的心脏健康状况。"}]