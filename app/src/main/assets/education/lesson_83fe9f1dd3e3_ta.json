[{"start": 819, "end": 6649, "text": "வகை 2 நீரிழிவு வகை 2 ஐப் புரிந்துகொள்வது"}, {"start": 4609, "end": 8959, "text": "நீரிழிவு என்பது உங்கள் இரத்தத்தின் ஒரு நிலை"}, {"start": 6649, "end": 11430, "text": "சர்க்கரை அளவு இல்லையெனில் குளுக்கோஸ் என்று அழைக்கப்படுகிறது"}, {"start": 8959, "end": 13830, "text": "அளவுகள் மிக அதிகமாக உள்ளன"}, {"start": 11430, "end": 17510, "text": "உங்கள் உடலால் பயன்படுத்த முடியாத போது இது நிகழ்கிறது"}, {"start": 13830, "end": 17510, "text": "நீங்கள் உணவில் இருந்து பெறும் குளுக்கோஸ்"}, {"start": 19600, "end": 26380, "text": "ஆரோக்கியமான மக்களில் கணையம் வெளியிடுகிறது"}, {"start": 22270, "end": 28210, "text": "நாம் சாப்பிடும் போது இன்சுலின் என்ற ஹார்மோன்"}, {"start": 26380, "end": 31480, "text": "சுற்றியுள்ள செல்களை இன்சுலின் மாற்றுகிறது"}, {"start": 28210, "end": 33550, "text": "உங்கள் உடல் குளுக்கோஸை உறிஞ்சி அதைப் பயன்படுத்துகிறது"}, {"start": 31480, "end": 36760, "text": "ஆற்றலுக்கான எரிபொருளாக"}, {"start": 33550, "end": 40130, "text": "ஆனால் வகை 2 நீரிழிவு நோயாளிகளுக்கு"}, {"start": 36760, "end": 42860, "text": "உடல் இன்சுலினுக்கு பதிலளிக்காது"}, {"start": 40130, "end": 43970, "text": "இதன் விளைவாக குளுக்கோஸ் உருவாகிறது"}, {"start": 42860, "end": 46370, "text": "இரத்தம்"}, {"start": 43970, "end": 49010, "text": "இது தமனிகளை சேதப்படுத்தும்"}, {"start": 46370, "end": 53030, "text": "இரத்த ஆக்ஸிஜன் மற்றும் ஊட்டச்சத்துக்களை வழங்குதல்"}, {"start": 49010, "end": 55360, "text": "உங்கள் உறுப்புகள் சேதமடைந்த தமனி சுவர்கள் அதை உருவாக்குகின்றன"}, {"start": 53030, "end": 58190, "text": "கொழுப்பு படிவுகளை உருவாக்குவது எளிது"}, {"start": 55360, "end": 60650, "text": "இது இரத்த ஓட்டத்தை கட்டுப்படுத்தலாம்"}, {"start": 58190, "end": 63110, "text": "மற்றும் ஆக்ஸிஜன் மற்றும் அதை இரண்டு முதல் மூன்றாக ஆக்குகிறது"}, {"start": 60650, "end": 64760, "text": "உங்களுக்கு ஒரு மடங்கு அதிக வாய்ப்பு உள்ளது"}, {"start": 63110, "end": 70320, "text": "மாரடைப்பு"}, {"start": 64760, "end": 73410, "text": "பக்கவாதம் அல்லது வாஸ்குலர் டிமென்ஷியா வளர்ச்சி"}, {"start": 70320, "end": 75750, "text": "B H F எப்படி ஆராய்ச்சிக்கு நிதியளிக்கிறது"}, {"start": 73410, "end": 78690, "text": "நீரிழிவு உங்கள் இதய ஆபத்தை அதிகரிக்கிறது"}, {"start": 75750, "end": 81140, "text": "மற்றும் சுற்றோட்ட நோய்கள் மற்றும் கண்டுபிடிப்பு"}, {"start": 78690, "end": 85020, "text": "அபாயங்களை எதிர்கொள்ள புதிய சிகிச்சைகள்"}, {"start": 81140, "end": 87600, "text": "நீரிழிவு நோயின் சாத்தியமான அறிகுறிகள் அடங்கும்"}, {"start": 85020, "end": 91010, "text": "அதிக தாகமாக இருப்பது"}, {"start": 87600, "end": 94510, "text": "மற்றும் வழக்கத்தை விட அதிகமாக சோர்வாக உள்ளது"}, {"start": 91010, "end": 94510, "text": "மற்றும் மங்கலான பார்வை"}, {"start": 94939, "end": 100180, "text": "சிலருக்கு எந்த அறிகுறிகளும் இல்லாமல் இருக்கலாம்"}, {"start": 97340, "end": 102770, "text": "அவர்களுக்கு சர்க்கரை நோய் இருப்பது தெரியாது"}, {"start": 100180, "end": 106250, "text": "சிலர் ஏன் பெறுகிறார்கள் என்பது எங்களுக்கு இன்னும் தெரியவில்லை"}, {"start": 102770, "end": 108470, "text": "வகை-2 நீரிழிவு மற்றும் சில இல்லை ஆனால் நாம் செய்கிறோம்"}, {"start": 106250, "end": 112039, "text": "உங்களுக்கு நீரிழிவு நோய் வருவதற்கான வாய்ப்புகள் அதிகம் என்பதை அறிவீர்கள்"}, {"start": 108470, "end": 114049, "text": "நீங்கள் அதிக எடையுடன் இருந்தால், குறிப்பாக நீங்கள்"}, {"start": 112039, "end": 116079, "text": "சுற்றி நிறைய எடையை சுமக்கிறார்கள்"}, {"start": 114049, "end": 116079, "text": "நடுத்தர"}, {"start": 116590, "end": 123010, "text": "உங்கள் உணவை மேம்படுத்துதல் மற்றும் 20 முதல் 30 வரை செய்தல்\nஒரு நாளைக்கு"}, {"start": 120430, "end": 124810, "text": "நிமிட உடற்பயிற்சி"}, {"start": 123010, "end": 129520, "text": "வளரும் அபாயத்தைக் குறைக்க உதவும்"}, {"start": 124810, "end": 132120, "text": "வகை 2 நீரிழிவு தொடர்பான சிக்கல்கள்"}, {"start": 129520, "end": 134580, "text": "சர்க்கரையை குறைக்கவும்"}, {"start": 132120, "end": 138450, "text": "மற்றும் நிறைவுற்ற கொழுப்பு"}, {"start": 134580, "end": 141080, "text": "பெரிய உணவுப் பகுதிகளைத் தவிர்த்து, அதிகமாக சாப்பிடுங்கள்"}, {"start": 138450, "end": 141080, "text": "பழங்கள் மற்றும் காய்கறிகள்"}, {"start": 141990, "end": 150230, "text": "நீங்கள் புகைபிடித்தால், வெளியேற வேண்டிய நேரம் இது"}, {"start": 145700, "end": 153680, "text": "உங்கள் வகை-2 நீரிழிவு நோயைக் கட்டுப்படுத்துங்கள்"}, {"start": 150230, "end": 157480, "text": "மேலும் தகவலுக்கு BHF org UK ஐப் பார்வையிடவும்"}, {"start": 153680, "end": 157480, "text": "முன்னோக்கி ஸ்லாஷ் நீரிழிவு"}]