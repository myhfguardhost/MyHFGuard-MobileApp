[{"start": 203, "end": 2812, "text": "与缺点共存"}, {"start": 1861, "end": 4324, "text": "心脏状况可能会恶化"}, {"start": 3372, "end": 6989, "text": "有时会出现症状。称呼"}, {"start": 6044, "end": 8951, "text": "和你的医生或护士一起"}, {"start": 8006, "end": 10423, "text": "哪些工人"}, {"start": 9477, "end": 12384, "text": "24小时内，医疗专业人员将赶到。"}, {"start": 11439, "end": 14564, "text": "如果你的脚踝肿胀"}, {"start": 13619, "end": 16308, "text": "或者你的腿或肚子，"}, {"start": 15362, "end": 18324, "text": "你可以观察到"}, {"start": 17379, "end": 21427, "text": "当你感到紧绷时"}, {"start": 20474, "end": 23028, "text": "你的鞋子或袜子或"}, {"start": 22075, "end": 25651, "text": "你的裤子。如果你体重增加"}, {"start": 24705, "end": 27114, "text": "或者减少 2"}, {"start": 26168, "end": 29226, "text": "两天一公斤。"}, {"start": 28280, "end": 31338, "text": "或者这对你来说变得很困难。"}, {"start": 30392, "end": 33451, "text": "步行正常距离，"}, {"start": 32505, "end": 35617, "text": "或者你的呼吸变得更加困难。"}, {"start": 34617, "end": 37621, "text": "请咨询医疗团队。"}, {"start": 36675, "end": 40690, "text": "健康。咳嗽"}, {"start": 39730, "end": 42020, "text": "新连续体或"}, {"start": 41061, "end": 43633, "text": "难以入睡"}, {"start": 42673, "end": 45245, "text": "使用更多"}, {"start": 44286, "end": 46374, "text": "坐垫"}, {"start": 45414, "end": 47624, "text": "平静地呼吸着"}, {"start": 46664, "end": 49075, "text": "警告标志"}, {"start": 48115, "end": 50244, "text": "这需要提出请求"}, {"start": 49284, "end": 51996, "text": "帮助。在某些"}, {"start": 51051, "end": 54170, "text": "有时，你的心脏可能会"}, {"start": 53224, "end": 56181, "text": "他正在承受巨大的痛苦，你需要"}, {"start": 55235, "end": 61404, "text": "急需帮助。如果"}, {"start": 60457, "end": 63491, "text": "我感觉到了预警信号"}, {"start": 62545, "end": 65150, "text": "例如心脏病发作"}, {"start": 64204, "end": 66863, "text": "疼痛或压力或"}, {"start": 65917, "end": 68576, "text": "沉重感或紧绷感"}, {"start": 67629, "end": 70663, "text": "你的胸部、手臂或背部"}, {"start": 69717, "end": 72430, "text": "或者你的下巴或脖子，或者"}, {"start": 71483, "end": 74357, "text": "你的肩膀出了问题，所以停下来休息一下。"}, {"start": 76128, "end": 78856, "text": "如果症状持续存在"}, {"start": 77907, "end": 80482, "text": "超过10分钟，"}, {"start": 79533, "end": 82261, "text": "拨打紧急电话"}, {"start": 81312, "end": 83990, "text": "打电话叫救护车。"}, {"start": 84552, "end": 87619, "text": "如果你感到心跳加速"}, {"start": 86672, "end": 89421, "text": "你心跳加速，感到头晕目眩或失去意识"}, {"start": 88474, "end": 91170, "text": "提高意识，请拨打该号码"}, {"start": 90223, "end": 93131, "text": "紧急情况，叫车"}, {"start": 92184, "end": 95541, "text": "急救。如果你觉得"}, {"start": 94596, "end": 97115, "text": "非常困难地"}, {"start": 96169, "end": 99014, "text": "即使身处舒适之中，也要呼吸。"}, {"start": 98069, "end": 101185, "text": "拨打紧急电话（000）"}, {"start": 100185, "end": 103231, "text": "）。你需要一辆车"}, {"start": 102284, "end": 106189, "text": "急救。如果您是赞助商"}, {"start": 105235, "end": 107755, "text": "患有这种疾病的人"}, {"start": 106801, "end": 109228, "text": "紧急症状"}, {"start": 108274, "end": 110747, "text": "让他休息"}, {"start": 109793, "end": 113113, "text": "陪着他。拨打该号码"}, {"start": 112175, "end": 115105, "text": "紧急电话（000）"}, {"start": 114168, "end": 117166, "text": "救护车。知道"}, {"start": 116204, "end": 118260, "text": "更多内容"}, {"start": 117298, "end": 119770, "text": "应对心力衰竭"}, {"start": 118770, "end": 120977, "text": "观看视频"}, {"start": 120015, "end": 122487, "text": "本系列的另一部作品"}, {"start": 121487, "end": 122525, "text": "。"}]