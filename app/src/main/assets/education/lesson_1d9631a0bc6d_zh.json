[{"start": 0, "end": 3000, "text": "那么，我们来谈谈心力衰竭是如何发生的"}, {"start": 3000, "end": 4960, "text": "可以让你感觉到。"}, {"start": 4960, "end": 8000, "text": "有时您可能会感到呼吸困难，"}, {"start": 8000, "end": 9960, "text": "尤其是当您躺着时"}, {"start": 9960, "end": 12080, "text": "或试图睡觉。"}, {"start": 12080, "end": 14760, "text": "由于体内积液，"}, {"start": 14760, "end": 16720, "text": "心力衰竭可能导致肿胀"}, {"start": 16720, "end": 20400, "text": "在你的脚踝、腿部或腹部。"}, {"start": 21280, "end": 25360, "text": "胸痛，一种心跳加速的感觉，"}, {"start": 25360, "end": 28320, "text": "咳嗽得很厉害，而且头晕，"}, {"start": 28320, "end": 30360, "text": "是其他常见症状。"}, {"start": 32200, "end": 34560, "text": "其他心力衰竭症状包括，"}, {"start": 34560, "end": 38840, "text": "疲倦、食欲不振、便秘、"}, {"start": 40520, "end": 44200, "text": "或因生病而感到悲伤或担心。"}, {"start": 45640, "end": 50560, "text": "如果您发现肿胀和液体积聚，请采取行动。"}, {"start": 50560, "end": 53880, "text": "您也许能够阻止情况变得更糟。"}, {"start": 53880, "end": 56720, "text": "寻找隐藏的液体积聚的好方法"}, {"start": 56720, "end": 59080, "text": "就是每天站在体重秤上"}, {"start": 59080, "end": 61800, "text": "并遵循四个W。"}, {"start": 61800, "end": 62760, "text": "醒来。"}, {"start": 63800, "end": 65200, "text": "在厕所小便。"}, {"start": 66320, "end": 67560, "text": "称量一下自己的体重。"}, {"start": 68440, "end": 69880, "text": "并将其写下来。"}, {"start": 71720, "end": 75120, "text": "如果您发现您的体重增加了2公斤或更多"}, {"start": 75120, "end": 76960, "text": "两天之内，"}, {"start": 76960, "end": 80600, "text": "在 24 小时内致电您的医疗保健团队。"}, {"start": 80600, "end": 82520, "text": "如果您担心或有症状"}, {"start": 82520, "end": 83880, "text": "情况变得更糟，"}, {"start": 83880, "end": 86840, "text": "致电您的医生、护士很重要，"}, {"start": 86840, "end": 88400, "text": "或卫生工作者。"}, {"start": 88400, "end": 90800, "text": "有时您可能需要紧急帮助"}, {"start": 90800, "end": 92760, "text": "并且您不应该拖延。"}, {"start": 92760, "end": 94400, "text": "呼叫三个零(000)"}, {"start": 94400, "end": 96120, "text": "并要求救护车"}, {"start": 96120, "end": 100720, "text": "如果您胸部疼痛、有压力或紧绷，"}, {"start": 100720, "end": 103720, "text": "手臂、躯干或下巴。"}, {"start": 103720, "end": 106920, "text": "重要的是，拨打三个零（000）"}, {"start": 106920, "end": 110280, "text": "如果你虚脱，或者呼吸非常困难。"}, {"start": 110280, "end": 113160, "text": "为了了解更多关于管理心力衰竭的信息，"}, {"start": 113160, "end": 115840, "text": "观看本系列中的其他视频。"}]