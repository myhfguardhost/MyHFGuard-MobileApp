[{"start": 3520, "end": 8720, "text": "心力衰竭是指心脏"}, {"start": 6080, "end": 10240, "text": "无法泵出足够的血液供应"}, {"start": 8720, "end": 12240, "text": "全身。"}, {"start": 10240, "end": 14639, "text": "当怀疑存在心力衰竭等心脏问题时，"}, {"start": 12240, "end": 16480, "text": "您的医疗保健提供者"}, {"start": 14639, "end": 19279, "text": "可能会建议您进行心脏射血分数检查，以评估心脏收缩"}, {"start": 19279, "end": 22960, "text": "并将血液泵送到"}, {"start": 21520, "end": 25199, "text": "全身的能力。"}, {"start": 22960, "end": 27760, "text": "射血分数比较的是心"}, {"start": 25199, "end": 30400, "text": "腔内的血液量与泵出的血液量。"}, {"start": 30400, "end": 34640, "text": "泵出的血液量占总泵出血液量的百分比即为心脏"}, {"start": 32399, "end": 37760, "text": "射血分数。当心脏"}, {"start": 34640, "end": 40000, "text": "射血分数正常时，每次收缩时大约有 50% 到"}, {"start": 37760, "end": 42800, "text": "70% 的血液被泵出"}, {"start": 40000, "end": 45039, "text": "心腔。"}, {"start": 42800, "end": 47280, "text": "射血分数正常时，您的"}, {"start": 45039, "end": 49920, "text": "身体拥有进行日常活动所需的血液供应。"}, {"start": 49920, "end": 54320, "text": "射血分数临界值意味着"}, {"start": 52559, "end": 56399, "text": "您的心脏泵出的"}, {"start": 54320, "end": 58800, "text": "血液量略低于心腔内血液量的一半。"}, {"start": 59920, "end": 63680, "text": "射血分数临界值会导致您在日常活动中出现呼吸急促等症状，"}, {"start": 64799, "end": 70080, "text": "因为富氧血液无法"}, {"start": 67520, "end": 72640, "text": "充分泵送到全身。"}, {"start": 70080, "end": 75200, "text": "射血分数降低是指"}, {"start": 75200, "end": 79680, "text": "心脏泵出的血液量约为 40% 或更少。"}, {"start": 77439, "end": 82159, "text": "射血分数降低会导致"}, {"start": 79680, "end": 84560, "text": "症状变得明显，甚至可能出现呼吸困难。 即使"}, {"start": 82159, "end": 87360, "text": "在休息时也会发生这种情况，进行正常"}, {"start": 84560, "end": 89439, "text": "活动也会变得困难。"}, {"start": 87360, "end": 91759, "text": "好消息是，许多人"}, {"start": 91759, "end": 95119, "text": "通过适当的护理和治疗可以提高射血分数并减轻症状。请"}, {"start": 95119, "end": 98320, "text": "与您的医疗保健提供者讨论"}, {"start": 96880, "end": 100000, "text": "您的选择，"}, {"start": 98320, "end": 101040, "text": "如果您已被诊断出患有心力衰竭，"}, {"start": 101040, "end": 104799, "text": "跟踪您的症状"}, {"start": 102720, "end": 107540, "text": "对于延长寿命和保持"}, {"start": 104799, "end": 112510, "text": "健康至关重要。"}, {"start": 107540, "end": 112510, "text": "[音乐]"}, {"start": 114159, "end": 116240, "text": "你"}]