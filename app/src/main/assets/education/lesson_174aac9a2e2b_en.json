[{"start": 0, "end": 11989, "text": "foreign"}, {"start": 1180, "end": 11989, "text": "[Music]"}, {"start": 26000, "end": 33420, "text": "glucose co-transporter 2 or sglt2 is"}, {"start": 31320, "end": 36620, "text": "expressed in the proximal convoluted"}, {"start": 33420, "end": 36620, "text": "tubule of the kidney"}, {"start": 37559, "end": 42540, "text": "and is responsible for almost all of"}, {"start": 39960, "end": 45379, "text": "sodium and glucose reabsorption into the"}, {"start": 42540, "end": 45379, "text": "blood in humans"}, {"start": 53539, "end": 59660, "text": "sglt2 is overexpressed in people with"}, {"start": 57000, "end": 62960, "text": "type 2 diabetes which contributes to the"}, {"start": 59660, "end": 62960, "text": "hyperglycemic state"}, {"start": 70880, "end": 76380, "text": "sglt2 Inhibitors or"}, {"start": 73700, "end": 78600, "text": "sglt2i block the reabsorption of"}, {"start": 76380, "end": 79470, "text": "filtered sodium and glucose back into"}, {"start": 78600, "end": 83159, "text": "the blood"}, {"start": 79470, "end": 85979, "text": "[Music]"}, {"start": 83159, "end": 87560, "text": "causing increased excretion of both in"}, {"start": 85979, "end": 90479, "text": "the urine"}, {"start": 87560, "end": 93240, "text": "sglt2is have proven an effective therapy"}, {"start": 90479, "end": 96420, "text": "to lower blood glucose concentration in"}, {"start": 93240, "end": 99740, "text": "people with type 2 diabetes but not for"}, {"start": 96420, "end": 99740, "text": "those without diabetes"}, {"start": 101340, "end": 107400, "text": "outside of their blood glucose effects"}, {"start": 104180, "end": 109740, "text": "sglt2is have demonstrated cardiovascular"}, {"start": 107400, "end": 112020, "text": "and renal benefits through a variety of"}, {"start": 109740, "end": 113820, "text": "mechanisms that we are still working to"}, {"start": 112020, "end": 116040, "text": "understand"}, {"start": 113820, "end": 118740, "text": "studies indicate these drugs decrease"}, {"start": 116040, "end": 121079, "text": "cardiac preload and afterload and"}, {"start": 118740, "end": 123840, "text": "improve cardiac output by improving"}, {"start": 121079, "end": 124759, "text": "ventricular loading conditions in doing"}, {"start": 123840, "end": 127439, "text": "so"}, {"start": 124759, "end": 130140, "text": "sglt2is promotes cardiac reverse"}, {"start": 127439, "end": 132480, "text": "remodeling the additional mechanisms for"}, {"start": 130140, "end": 134760, "text": "cardiac benefit from these agents are"}, {"start": 132480, "end": 136980, "text": "still being elucidated renal"}, {"start": 134760, "end": 139739, "text": "improvements are related to changes in"}, {"start": 136980, "end": 141660, "text": "glomerular pressure and filtration that"}, {"start": 139739, "end": 145040, "text": "lead to reductions in the need for"}, {"start": 141660, "end": 148200, "text": "dialysis and Transplant together"}, {"start": 145040, "end": 151140, "text": "sglt2is protects the kidneys and hard in"}, {"start": 148200, "end": 153920, "text": "patients who may or may not yet have"}, {"start": 151140, "end": 153920, "text": "heart failure"}]