[{"start": 4220, "end": 9360, "text": "如果您的医生给您开了血管紧张素转换酶"}, {"start": 7290, "end": 11730, "text": "抑制剂（ACE抑制剂），例如雷米普利和"}, {"start": 9360, "end": 14009, "text": "依那普利，可能是因为您患有"}, {"start": 11730, "end": 15800, "text": "高血压、心力衰竭或曾"}, {"start": 14009, "end": 18750, "text": "发生过心脏病发作。ACE"}, {"start": 15800, "end": 21210, "text": "抑制剂的作用机制是抑制"}, {"start": 18750, "end": 22850, "text": "人体"}, {"start": 21210, "end": 25769, "text": "维持血压的正常机制。血管紧张素"}, {"start": 22850, "end": 28380, "text": "I是血液中的一种酶，"}, {"start": 25769, "end": 34590, "text": "血管紧张素转换"}, {"start": 28380, "end": 40800, "text": "酶（ACE）会将血管紧张素II转化"}, {"start": 34590, "end": 42899, "text": "为血管紧张素I。血管紧张素II是一种会使"}, {"start": 40800, "end": 45059, "text": "血管收缩"}, {"start": 42899, "end": 46489, "text": "并释放激素的酶，这些激素会升"}, {"start": 45059, "end": 49800, "text": "高血压。ACE"}, {"start": 46489, "end": 52020, "text": "抑制剂可以阻止ACE进行这种"}, {"start": 49800, "end": 56430, "text": "转化，从而降低"}, {"start": 52020, "end": 59160, "text": "体内"}, {"start": 56430, "end": 61140, "text": "血管紧张素II的水平。血管紧张素II水平的降低会使"}, {"start": 59160, "end": 65460, "text": "血管放松，并将"}, {"start": 61140, "end": 68250, "text": "血压降至正常水平。"}, {"start": 65460, "end": 70170, "text": "血管紧张素II水平的降低还意味着更多的"}, {"start": 68250, "end": 73040, "text": "盐分会通过肾脏排出，并将"}, {"start": 70170, "end": 75150, "text": "水分带入尿液中。"}, {"start": 73040, "end": 77520, "text": "减少体内液体量"}, {"start": 75150, "end": 81420, "text": "意味着"}, {"start": 77520, "end": 83670, "text": "心脏需要泵出的血液量减少。通过放松"}, {"start": 81420, "end": 85530, "text": "血管和减少"}, {"start": 83670, "end": 87960, "text": "血管内的液体量，"}, {"start": 85530, "end": 90479, "text": "ACE抑制剂有助于控制"}, {"start": 87960, "end": 93930, "text": "血压，从而减轻心脏的负担。"}, {"start": 90479, "end": 96479, "text": "如果您患有"}, {"start": 93930, "end": 98939, "text": "心力衰竭或曾发生过心脏病发作，"}, {"start": 96479, "end": 100890, "text": "ACE抑制剂可能会影响您的心脏和动脉。ACE抑制剂也可用于"}, {"start": 98939, "end": 103350, "text": "改善心肌泵血"}, {"start": 100890, "end": 105360, "text": "功能，因此"}, {"start": 103350, "end": 108390, "text": "即使您的血压正常，医生也可能给您开ACE抑制剂。在"}, {"start": 108390, "end": 112930, "text": "停止或更改任何药物之前，即使"}, {"start": 111610, "end": 116080, "text": "您担心"}, {"start": 112930, "end": 118479, "text": "副作用，也请先咨询您的家庭医生，因为"}, {"start": 116080, "end": 120930, "text": "更改或漏服药物可能会损害"}, {"start": 118479, "end": 120930, "text": "您的健康。"}, {"start": 121630, "end": 127189, "text": "有关ACE抑制剂的更多信息，"}, {"start": 123920, "end": 131050, "text": "请访问BHF.org.uk/aceintivers。"}]