[{"start": 243, "end": 3510, "text": "(பிரகாசமான இசை)"}, {"start": 3510, "end": 5930, "text": "- [கதையாளர்] இதய செயலிழப்பு என்பது இதயத்தைக் குறிக்கும் சொல்"}, {"start": 5930, "end": 9453, "text": "அது உடலுக்கு போதுமான இரத்தத்தை பம்ப் செய்ய முடியாது."}, {"start": 10310, "end": 13400, "text": "இதய செயலிழப்பு போன்ற இதய பிரச்சனை சந்தேகிக்கப்படும் போது,"}, {"start": 13400, "end": 15950, "text": "உங்கள் சுகாதார வழங்குநர் ஒரு பரிசோதனையை ஆர்டர் செய்ய விரும்பலாம்\nஉங்கள் இதயத்தின் வெளியேற்றப் பகுதியின்"}, {"start": 15950, "end": 18020, "text": ","}, {"start": 18020, "end": 20270, "text": "அல்லது நன்றாக சுருங்கும் திறன்"}, {"start": 20270, "end": 22143, "text": "மற்றும் உங்கள் உடலுக்கு இரத்தத்தை பம்ப் செய்யவும்."}, {"start": 23130, "end": 25140, "text": "வெளியேற்ற பின்னம் ஒப்பிடுகிறது"}, {"start": 25140, "end": 27003, "text": "அறையில் உள்ள இரத்தத்தின் அளவு"}, {"start": 27003, "end": 29828, "text": "வெளியேற்றப்பட்ட இரத்தத்தின் அளவு."}, {"start": 29828, "end": 34030, "text": "பம்ப் செய்யப்பட்ட சதவீதம் உங்கள் இதயத்தின் வெளியேற்றப் பகுதி."}, {"start": 34030, "end": 36810, "text": "உங்கள் இதயத்தின் வெளியேற்றப் பகுதி சாதாரணமாக இருக்கும்போது,"}, {"start": 36810, "end": 40730, "text": "சுமார் 50 முதல் 70% இரத்தம் அறையிலிருந்து வெளியேற்றப்படுகிறது"}, {"start": 40730, "end": 42970, "text": "ஒவ்வொரு சுருக்கத்தின் போதும்."}, {"start": 42970, "end": 44920, "text": "சாதாரண வெளியேற்றப் பகுதியுடன்,"}, {"start": 44920, "end": 47210, "text": "உங்கள் உடலுக்கு தேவையான இரத்த சப்ளை உள்ளது"}, {"start": 47210, "end": 49478, "text": "உங்கள் வழக்கமான செயல்பாடுகளைச் செய்ய."}, {"start": 49478, "end": 51936, "text": "ஒரு பார்டர்லைன் எஜெக்ஷன் பின்னம்"}, {"start": 51936, "end": 53692, "text": "என்பது உங்கள் இதயம் வெளியேறுகிறது என்று அர்த்தம்"}, {"start": 53692, "end": 56370, "text": "இரத்தத்தின் அளவு பாதியை விட சற்று குறைவு"}, {"start": 56370, "end": 57610, "text": "அறையில்."}, {"start": 57610, "end": 59591, "text": "எல்லைக்கோடு வெளியேற்றப் பகுதியுடன்,"}, {"start": 59591, "end": 62609, "text": "மூச்சுத் திணறல் போன்ற அறிகுறிகள் கவனிக்கப்படலாம்"}, {"start": 62609, "end": 66424, "text": "வழக்கமான செயல்பாடுகளின் போது ஆக்ஸிஜன் நிறைந்த இரத்தம்"}, {"start": 66424, "end": 69914, "text": "உங்கள் உடலுக்கு போதுமான அளவு பம்ப் செய்யப்படுவதில்லை."}, {"start": 69914, "end": 74770, "text": "குறைக்கப்பட்ட வெளியேற்றப் பகுதியானது தோராயமாக 40% அல்லது அதற்கும் குறைவாக இருக்கும்"}, {"start": 74770, "end": 77193, "text": "இரத்தம் உங்கள் இதயத்திலிருந்து வெளியேற்றப்படுகிறது."}, {"start": 77193, "end": 81172, "text": "குறைக்கப்பட்ட வெளியேற்றப் பகுதியுடன், அறிகுறிகள் கவனிக்கப்படுகின்றன"}, {"start": 81172, "end": 83710, "text": "மற்றும் ஓய்வு நேரத்தில் கூட நிகழலாம்."}, {"start": 83710, "end": 87121, "text": "சாதாரண செயல்பாடுகளைச் செய்வது கடினமாகிறது."}, {"start": 87121, "end": 89390, "text": "நல்ல செய்தி என்னவென்றால் பலர்"}, {"start": 89390, "end": 91317, "text": "அவற்றின் வெளியேற்றப் பகுதியை மேம்படுத்த முடியும்"}, {"start": 91317, "end": 95230, "text": "மற்றும் சரியான கவனிப்பு மற்றும் சிகிச்சை மூலம் அறிகுறிகளைக் குறைக்கவும்."}, {"start": 95230, "end": 98440, "text": "உங்கள் விருப்பங்களைப் பற்றி உங்கள் சுகாதார வழங்குநரிடம் பேசுங்கள்."}, {"start": 98440, "end": 100567, "text": "உங்களுக்கு இதய செயலிழப்பு இருப்பது கண்டறியப்பட்டால்,"}, {"start": 100567, "end": 103550, "text": "உங்கள் அறிகுறிகளைக் கண்காணிப்பது ஒரு முக்கியமான பகுதியாகும்"}, {"start": 103550, "end": 105653, "text": "நீண்ட மற்றும் ஆரோக்கியமான வாழ்க்கை வாழ்வது."}]