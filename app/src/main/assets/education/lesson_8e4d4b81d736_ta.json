[{"start": 30, "end": 5060, "text": "உங்கள் துடிப்பு அல்லது இதயத் துடிப்பு எண்\nஉங்கள் இதயம் நிமிடத்திற்கு துடிக்கிறது"}, {"start": 2970, "end": 7680, "text": "சில நேரங்களில் உங்கள் இதயம் நிமிடத்திற்கு துடிக்கிறது"}, {"start": 5060, "end": 9150, "text": "உங்கள் இலக்கு இதயத் துடிப்பு வரம்பாகும்\nநீங்கள் குறிவைக்க வேண்டிய நிமிடத்திற்கு"}, {"start": 7680, "end": 12240, "text": "துடிப்புகள்"}, {"start": 9150, "end": 14370, "text": "உடற்பயிற்சியின் போது அது பரிந்துரைக்கப்படுகிறது"}, {"start": 12240, "end": 17279, "text": "இது 50 முதல் 70 சதவிகிதம் ஆகும்"}, {"start": 14370, "end": 19170, "text": "உங்கள் அதிகபட்ச இதயத் துடிப்பு இந்த வரம்பு a"}, {"start": 17279, "end": 21180, "text": "வழிகாட்டி மற்றும் உங்களிடம் இருந்தால் மாறாது"}, {"start": 19170, "end": 23670, "text": "நீங்கள் சிறிது எடுத்துக் கொள்ளாத வரை இதய நிலை"}, {"start": 21180, "end": 25439, "text": "மருந்து வகைகள் உங்கள் என்றால் கவலைப்பட வேண்டாம்"}, {"start": 23670, "end": 28859, "text": "இதயத் துடிப்பு உங்களின் 70 சதவீதத்தை மீறுகிறது"}, {"start": 25439, "end": 30300, "text": "இந்த வரம்பிற்குள் அதிகபட்ச உடற்பயிற்சி செய்யலாம்"}, {"start": 28859, "end": 33270, "text": "உங்களை அதிகரிக்கவும் பராமரிக்கவும் உதவுகிறது"}, {"start": 30300, "end": 35309, "text": "நடவடிக்கை அளவை நீங்கள் பாதுகாப்பாக அளவிட முடியும்"}, {"start": 33270, "end": 37140, "text": "இரண்டை வைப்பதன் மூலம் கைமுறையாக உங்கள் இதயத் துடிப்பை"}, {"start": 35309, "end": 39559, "text": "விரல்கள் உங்கள் உள்ளே மெதுவாக"}, {"start": 37140, "end": 42600, "text": "மணிக்கட்டு உங்கள் நாடித்துடிப்பைச் சரிபார்த்தல் என்றும் அழைக்கப்படுகிறது"}, {"start": 39559, "end": 44460, "text": "அல்லது அணியக்கூடிய சாதனங்கள் உள்ளன"}, {"start": 42600, "end": 47280, "text": "ஃபிட்னஸ் டிராக்கர்கள் உங்களை கண்காணிக்கும்"}, {"start": 44460, "end": 49350, "text": "ஜிம்மில் நாள் முழுவதும் இதயத் துடிப்பு"}, {"start": 47280, "end": 52260, "text": "சில உடற்பயிற்சி உபகரணங்கள்"}, {"start": 49350, "end": 55289, "text": "ஹார்ட்ரேட் டிராக்கர்கள் பயன்பாட்டுடன் பொருத்தப்பட்டுள்ளது"}, {"start": 52260, "end": 57480, "text": "VHF dot org dot UK இல் உள்ள எங்கள் கால்குலேட்டர்"}, {"start": 55289, "end": 60860, "text": "முன்னோக்கி சாய்வு இலக்கு இதய துடிப்பு"}, {"start": 57480, "end": 60860, "text": "[இசை]"}]