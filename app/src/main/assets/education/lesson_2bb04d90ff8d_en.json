[{"start": 1280, "end": 3360, "text": "If you want to lower high blood pressure"}, {"start": 3360, "end": 5400, "text": "these simple changes to your diet"}, {"start": 5400, "end": 6480, "text": "can help."}, {"start": 8160, "end": 10200, "text": "Your blood pressure can be raised by"}, {"start": 10200, "end": 13600, "text": "eating too many foods that are high in salt"}, {"start": 13600, "end": 16040, "text": "adding salt to your food and cooking"}, {"start": 16040, "end": 17640, "text": "eating too many sugary"}, {"start": 17640, "end": 18800, "text": "and fatty foods"}, {"start": 19640, "end": 22760, "text": "and drinking too much alcohol."}, {"start": 23160, "end": 25320, "text": "These foods are high in salt"}, {"start": 25320, "end": 26960, "text": "so it's best to eat less of them."}, {"start": 27480, "end": 29680, "text": "Processed meats like ham"}, {"start": 29680, "end": 30320, "text": "bacon"}, {"start": 30320, "end": 31640, "text": "and sausages."}, {"start": 32160, "end": 34960, "text": "Savory snacks like salted nuts"}, {"start": 34960, "end": 36000, "text": "crisps"}, {"start": 36000, "end": 36880, "text": "crackers"}, {"start": 36880, "end": 38280, "text": "and breadsticks."}, {"start": 38800, "end": 41320, "text": "Some everyday staples like bread"}, {"start": 41320, "end": 42120, "text": "cheese"}, {"start": 42120, "end": 44040, "text": "cereals and biscuits."}, {"start": 44680, "end": 45960, "text": "Ready meals"}, {"start": 45960, "end": 47240, "text": "pizzas"}, {"start": 47240, "end": 49000, "text": "shop-bought soups"}, {"start": 49000, "end": 50280, "text": "sauces"}, {"start": 50280, "end": 51240, "text": "stock"}, {"start": 51240, "end": 52360, "text": "gravy"}, {"start": 52360, "end": 53360, "text": "and pickles."}, {"start": 53680, "end": 55840, "text": "Some healthy foods can also be"}, {"start": 55840, "end": 57280, "text": "surprisingly salty."}, {"start": 57720, "end": 59120, "text": "Whole meal bread"}, {"start": 59120, "end": 61600, "text": "whole wheat breakfast cereals"}, {"start": 61600, "end": 63040, "text": "cottage cheese"}, {"start": 63040, "end": 64840, "text": "and smoked oily fish."}, {"start": 65200, "end": 66920, "text": "Check the traffic light labels"}, {"start": 66920, "end": 68280, "text": "on food packs"}, {"start": 68280, "end": 70680, "text": "to see how much salt is in them."}, {"start": 70680, "end": 73160, "text": "Red means high in salt"}, {"start": 73160, "end": 75840, "text": "so try to choose lower salt options."}, {"start": 76480, "end": 78960, "text": "Foods that are high in fat and sugar"}, {"start": 78960, "end": 81160, "text": "can affect your blood pressure over time."}, {"start": 81840, "end": 83840, "text": "This is because eating too many"}, {"start": 83840, "end": 85520, "text": "high-calorie foods"}, {"start": 85520, "end": 87360, "text": "can lead to weight gain"}, {"start": 87360, "end": 89360, "text": "which is linked to high blood pressure."}, {"start": 90560, "end": 92160, "text": "Drinking too much alcohol"}, {"start": 92160, "end": 94040, "text": "can also raise blood pressure"}, {"start": 94040, "end": 95640, "text": "and lead to weight gain."}, {"start": 96400, "end": 98000, "text": "Try to drink no more than"}, {"start": 98000, "end": 100960, "text": "14 units of alcohol per week."}, {"start": 100960, "end": 103200, "text": "That's around 6 pints of beer"}, {"start": 103200, "end": 105760, "text": "or 6 medium glasses of wine."}, {"start": 107560, "end": 108960, "text": "These foods can help to"}, {"start": 108960, "end": 110600, "text": "bring your blood pressure down."}, {"start": 111080, "end": 112720, "text": "Fruit and vegetables"}, {"start": 113440, "end": 116120, "text": "whole grain foods like brown rice"}, {"start": 116120, "end": 116880, "text": "oats"}, {"start": 116880, "end": 118360, "text": "and whole wheat pasta."}, {"start": 119120, "end": 121400, "text": "Lean proteins like chicken"}, {"start": 121400, "end": 122400, "text": "fish"}, {"start": 122400, "end": 123480, "text": "and eggs"}, {"start": 123480, "end": 125240, "text": "or plant based protein"}, {"start": 125240, "end": 126320, "text": "from nuts"}, {"start": 126320, "end": 127000, "text": "beans"}, {"start": 127000, "end": 128040, "text": "and seeds"}, {"start": 128040, "end": 130880, "text": "instead of red and processed meats."}, {"start": 131000, "end": 132600, "text": "Low fat dairy"}, {"start": 132600, "end": 134360, "text": "such as semi-skimmed milk"}, {"start": 134360, "end": 135960, "text": "and natural yogurt."}]