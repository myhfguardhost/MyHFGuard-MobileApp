[{"start": 1280, "end": 3360, "text": "நீங்கள் உயர் இரத்த அழுத்தத்தைக் குறைக்க விரும்பினால்"}, {"start": 3360, "end": 5400, "text": "உங்கள் உணவில் இந்த எளிய மாற்றங்கள்"}, {"start": 5400, "end": 6480, "text": "உதவலாம்."}, {"start": 8160, "end": 10200, "text": "உங்கள் இரத்த அழுத்தத்தை உயர்த்தலாம்"}, {"start": 10200, "end": 13600, "text": "உப்பு அதிகம் உள்ள உணவுகளை அதிகமாக உண்ணுதல்"}, {"start": 13600, "end": 16040, "text": "உங்களின் உணவு மற்றும் சமையலில் உப்பு சேர்ப்பது"}, {"start": 16040, "end": 17640, "text": "சர்க்கரை அதிகம் சாப்பிடுவது"}, {"start": 17640, "end": 18800, "text": "மற்றும் கொழுப்பு உணவுகள்"}, {"start": 19640, "end": 22760, "text": "மற்றும் அதிகமாக மது அருந்துதல்."}, {"start": 23160, "end": 25320, "text": "இந்த உணவுகளில் அதிக உப்பு உள்ளது"}, {"start": 25320, "end": 26960, "text": "எனவே அவற்றை குறைவாக சாப்பிடுவது நல்லது."}, {"start": 27480, "end": 29680, "text": "ஹாம் போன்ற பதப்படுத்தப்பட்ட இறைச்சிகள்"}, {"start": 29680, "end": 30320, "text": "பன்றி இறைச்சி"}, {"start": 30320, "end": 31640, "text": "மற்றும் sausages."}, {"start": 32160, "end": 34960, "text": "உப்பு சேர்க்கப்பட்ட கொட்டைகள் போன்ற சுவையான தின்பண்டங்கள்"}, {"start": 34960, "end": 36000, "text": "மிருதுவானது"}, {"start": 36000, "end": 36880, "text": "பட்டாசுகள்"}, {"start": 36880, "end": 38280, "text": "மற்றும் பிரட்ஸ்டிக்ஸ்."}, {"start": 38800, "end": 41320, "text": "ரொட்டி போன்ற சில தினசரி ஸ்டேபிள்ஸ்"}, {"start": 41320, "end": 42120, "text": "சீஸ்"}, {"start": 42120, "end": 44040, "text": "தானியங்கள் மற்றும் பிஸ்கட்."}, {"start": 44680, "end": 45960, "text": "தயார் உணவுகள்"}, {"start": 45960, "end": 47240, "text": "பீஸ்ஸாக்கள்"}, {"start": 47240, "end": 49000, "text": "கடையில் வாங்கிய சூப்கள்"}, {"start": 49000, "end": 50280, "text": "சாஸ்கள்"}, {"start": 50280, "end": 51240, "text": "பங்கு"}, {"start": 51240, "end": 52360, "text": "குழம்பு"}, {"start": 52360, "end": 53360, "text": "மற்றும் ஊறுகாய்."}, {"start": 53680, "end": 55840, "text": "சில ஆரோக்கியமான உணவுகளும் இருக்கலாம்"}, {"start": 55840, "end": 57280, "text": "வியக்கத்தக்க உப்பு."}, {"start": 57720, "end": 59120, "text": "முழு உணவு ரொட்டி"}, {"start": 59120, "end": 61600, "text": "முழு கோதுமை காலை உணவு தானியங்கள்"}, {"start": 61600, "end": 63040, "text": "பாலாடைக்கட்டி"}, {"start": 63040, "end": 64840, "text": "மற்றும் புகைபிடித்த எண்ணெய் மீன்."}, {"start": 65200, "end": 66920, "text": "போக்குவரத்து விளக்கு லேபிள்களைச் சரிபார்க்கவும்"}, {"start": 66920, "end": 68280, "text": "உணவுப் பொதிகளில்"}, {"start": 68280, "end": 70680, "text": "அவற்றில் எவ்வளவு உப்பு உள்ளது என்பதைப் பார்க்க."}, {"start": 70680, "end": 73160, "text": "சிவப்பு என்றால் உப்பு அதிகம்"}, {"start": 73160, "end": 75840, "text": "எனவே குறைந்த உப்பு விருப்பங்களை தேர்வு செய்ய முயற்சிக்கவும்."}, {"start": 76480, "end": 78960, "text": "கொழுப்பு மற்றும் சர்க்கரை அதிகம் உள்ள உணவுகள்"}, {"start": 78960, "end": 81160, "text": "காலப்போக்கில் உங்கள் இரத்த அழுத்தத்தை பாதிக்கலாம்."}, {"start": 81840, "end": 83840, "text": "அதிகமாக சாப்பிடுவதே இதற்குக் காரணம்"}, {"start": 83840, "end": 85520, "text": "அதிக கலோரி உணவுகள்"}, {"start": 85520, "end": 87360, "text": "எடை அதிகரிப்பிற்கு வழிவகுக்கும்"}, {"start": 87360, "end": 89360, "text": "இது உயர் இரத்த அழுத்தத்துடன் இணைக்கப்பட்டுள்ளது."}, {"start": 90560, "end": 92160, "text": "அதிகமாக மது அருந்துதல்"}, {"start": 92160, "end": 94040, "text": "இரத்த அழுத்தத்தையும் அதிகரிக்கலாம்"}, {"start": 94040, "end": 95640, "text": "மற்றும் எடை அதிகரிப்புக்கு வழிவகுக்கும்."}, {"start": 96400, "end": 98000, "text": "அதிகமாக குடிக்க முயற்சிக்கவும்"}, {"start": 98000, "end": 100960, "text": "வாரத்திற்கு 14 யூனிட் ஆல்கஹால்."}, {"start": 100960, "end": 103200, "text": "அது சுமார் 6 பைண்ட் பீர் ஆகும்"}, {"start": 103200, "end": 105760, "text": "அல்லது 6 நடுத்தர கிளாஸ் ஒயின்."}, {"start": 107560, "end": 108960, "text": "இந்த உணவுகள் உதவலாம்"}, {"start": 108960, "end": 110600, "text": "உங்கள் இரத்த அழுத்தத்தைக் குறைக்கவும்."}, {"start": 111080, "end": 112720, "text": "பழங்கள் மற்றும் காய்கறிகள்"}, {"start": 113440, "end": 116120, "text": "பழுப்பு அரிசி போன்ற முழு தானிய உணவுகள்"}, {"start": 116120, "end": 116880, "text": "ஓட்ஸ்"}, {"start": 116880, "end": 118360, "text": "மற்றும் முழு கோதுமை பாஸ்தா."}, {"start": 119120, "end": 121400, "text": "கோழி போன்ற ஒல்லியான புரதங்கள்"}, {"start": 121400, "end": 122400, "text": "மீன்"}, {"start": 122400, "end": 123480, "text": "மற்றும் முட்டைகள்"}, {"start": 123480, "end": 125240, "text": "அல்லது தாவர அடிப்படையிலான புரதம்"}, {"start": 125240, "end": 126320, "text": "கொட்டைகளிலிருந்து"}, {"start": 126320, "end": 127000, "text": "பீன்ஸ்"}, {"start": 127000, "end": 128040, "text": "மற்றும் விதைகள்"}, {"start": 128040, "end": 130880, "text": "சிவப்பு மற்றும் பதப்படுத்தப்பட்ட இறைச்சிகளுக்கு பதிலாக."}, {"start": 131000, "end": 132600, "text": "குறைந்த கொழுப்பு பால்"}, {"start": 132600, "end": 134360, "text": "அரை நீக்கப்பட்ட பால் போன்றவை"}, {"start": 134360, "end": 135960, "text": "மற்றும் இயற்கை தயிர்."}]