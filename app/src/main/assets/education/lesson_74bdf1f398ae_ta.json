[{"start": 3040, "end": 9240, "text": "ஒரு வகை 2 நீரிழிவு நோய் கண்டறிதல் உணரலாம்\nகுறிப்பாக வரும்போது"}, {"start": 6839, "end": 12120, "text": "அதிகமாக உள்ளது"}, {"start": 9240, "end": 15400, "text": "உணவு அனைவருக்கும் பொருந்தக்கூடிய அளவு இல்லை"}, {"start": 12120, "end": 18400, "text": "நீரிழிவு உணவு ஆனால் சிறியதாக செய்வதன் மூலம்"}, {"start": 15400, "end": 21840, "text": "உங்கள் உணவுப் பழக்கத்தில் நிர்வகிக்கக்கூடிய மாற்றங்கள்"}, {"start": 18400, "end": 25039, "text": "காலப்போக்கில் பெரிய முன்னேற்றங்களைக் காணலாம்"}, {"start": 21840, "end": 28119, "text": "உணவுகள் ஐந்து முக்கிய குழுக்களாக உள்ளன"}, {"start": 25039, "end": 31640, "text": "புரதங்கள் கார்போஹைட்ரேட் பழங்கள் மற்றும்"}, {"start": 28119, "end": 35480, "text": "காய்கறிகள் பால் மற்றும் கொழுப்புகள் மற்றும் எண்ணெய்கள் ஒவ்வொன்றும்\nஇவற்றில்"}, {"start": 31640, "end": 38800, "text": "உங்கள் உடலை ஆரோக்கியமாக வைத்திருக்க உதவுகிறது"}, {"start": 35480, "end": 41320, "text": "இது உணவுகளை நல்லது அல்லது என்று முத்திரை குத்துவது அல்ல"}, {"start": 38800, "end": 44160, "text": "அவர்களைப் புரிந்துகொள்வது மோசமானது"}, {"start": 41320, "end": 47480, "text": "வெவ்வேறு ஊட்டச்சத்து மதிப்புகள் மற்றும் கண்டுபிடிப்பு"}, {"start": 44160, "end": 51320, "text": "ஆரோக்கியமான சமநிலை மிக முக்கியமானது"}, {"start": 47480, "end": 54920, "text": "விஷயம் மிதமான மற்றும் கவனம் செலுத்த வேண்டும்"}, {"start": 51320, "end": 58079, "text": "உண்ணும் பகுதி அளவுகளைக் கட்டுப்படுத்துதல் a"}, {"start": 54920, "end": 60840, "text": "விதவிதமான உணவுகள் மற்றும் உங்கள் உணவை மகிழ்வித்தல்"}, {"start": 58079, "end": 64000, "text": "ஆரோக்கியத்திற்கு முக்கியமானது"}, {"start": 60840, "end": 67080, "text": "சிலர் செய்யும் வாழ்க்கை முறை"}, {"start": 64000, "end": 70119, "text": "அவர்களுக்கு முதலில் நீரிழிவு நோய் இருப்பது கண்டறியப்பட்டது"}, {"start": 67080, "end": 73320, "text": "அவர்கள் அனைத்து சர்க்கரையையும் உண்மையில் வெட்டினர்"}, {"start": 70119, "end": 75880, "text": "ஒரு வாரம் அல்லது இரண்டு நாட்களுக்குப் பிறகு அவர்களின் உணவைக் கட்டுப்படுத்துங்கள்"}, {"start": 73320, "end": 78680, "text": "அவர்களின் ஆசைகள் கூரை வழியாக செல்கின்றன"}, {"start": 75880, "end": 82799, "text": "அவர்கள் உணவுகளை உண்கிறார்கள்"}, {"start": 78680, "end": 85280, "text": "கட் அவுட் முன்னோக்கி திட்டமிடுவதும் முக்கியம்"}, {"start": 82799, "end": 87880, "text": "வாராந்திர மளிகை கடை மற்றும் திட்டமிடல்"}, {"start": 85280, "end": 91640, "text": "உங்களின் சாப்பாடு மற்றும் சிற்றுண்டிகள் உங்களுக்கு உதவும்"}, {"start": 87880, "end": 95119, "text": "மாற்றங்களைச் செய்வது ஆரோக்கியமான தேர்வுகள்"}, {"start": 91640, "end": 99640, "text": "ஆதரவுடன் எளிதாக ஈடுபடுத்த உதவுகிறது"}, {"start": 95119, "end": 102079, "text": "உங்கள் பங்குதாரர் குடும்பம் அல்லது நண்பர்கள் உணவு ஒரு"}, {"start": 99640, "end": 105399, "text": "எப்படி என்ற அடிப்படையில் நமது கலாச்சாரத்தின் பெரும் பகுதி"}, {"start": 102079, "end": 108360, "text": "நாம் ஒரு சமூகமாகப் பிணைக்கிறோம் மற்றும் ஒன்றுபடுகிறோம்"}, {"start": 105399, "end": 112040, "text": "நீங்கள் இழக்க விரும்பவில்லை"}, {"start": 108360, "end": 115479, "text": "முடி என்பது ஒரு நிலையான பங்கோல் தட்டு"}, {"start": 112040, "end": 118640, "text": "உணவு இப்போது முடி ஒரு சிறந்த தட்டு"}, {"start": 115479, "end": 121680, "text": "வகை 2 உள்ள ஒருவருக்கு போங்கோல் உணவு"}, {"start": 118640, "end": 124280, "text": "நீரிழிவு நோயை நீங்கள் பார்க்க முடியும்"}, {"start": 121680, "end": 126759, "text": "நீங்கள் விரும்பும் ஒரே உணவை உண்ணுதல்"}, {"start": 124280, "end": 129200, "text": "நாங்கள் மாற்றியிருப்பது பகுதி"}, {"start": 126759, "end": 132120, "text": "அளவு மற்றும் ஒவ்வொரு பொருளின் அளவும்"}, {"start": 129200, "end": 134640, "text": "சாப்பாட்டில் பாதி தட்டில் சாப்பிடுவது"}, {"start": 132120, "end": 138720, "text": "காய்கறிகள் தட்டில் கால் பகுதி"}, {"start": 134640, "end": 141319, "text": "புரதம் மற்றும் தட்டில் கால் பகுதி"}, {"start": 138720, "end": 144319, "text": "கார்போஹைட்ரேட்டுகள் இன்னும் சில விஷயங்கள்"}, {"start": 141319, "end": 146720, "text": "சரிவிகித உணவை உட்கொள்வதை நினைவில் கொள்ள வேண்டும்"}, {"start": 144319, "end": 149680, "text": "நிறைய காய்கறிகள் முழு தானியங்கள் மெலிந்தன"}, {"start": 146720, "end": 152440, "text": "இறைச்சி மற்றும் ஆரோக்கியமான கொழுப்புகளை கவனத்தில் கொள்ள வேண்டும்"}, {"start": 149680, "end": 155640, "text": "உங்கள் பகுதி அளவுகள் குறிப்பாக கார்போஹைட்ரேட்டுகள்"}, {"start": 152440, "end": 157720, "text": "நிறைவுற்ற கொழுப்புகள் மற்றும் மிகவும் பதப்படுத்தப்பட்ட உணவுகள்"}, {"start": 155640, "end": 160440, "text": "தட்டு முறையைப் பயன்படுத்துகிறோம்"}, {"start": 157720, "end": 163319, "text": "உங்கள் தட்டில் பாதியை நிரப்புவதைப் பார்த்தேன்"}, {"start": 160440, "end": 166760, "text": "காய்கறிகள் கார்போஹைட்ரேட் மற்றும் ஏ"}, {"start": 163319, "end": 170000, "text": "புரதத்துடன் கூடிய காலாண்டு கார்போஹைட்ரேட்டுகள் முயற்சி செய்கின்றன"}, {"start": 166760, "end": 173200, "text": "நாள் முழுவதும் கார்போஹைட்ரேட்டுகளை சமமாக சாப்பிடுங்கள்"}, {"start": 170000, "end": 176000, "text": "முழு தானிய பீன்ஸ் மற்றும் காய்கறிகளை தேர்வு செய்யவும்"}, {"start": 173200, "end": 178840, "text": "வெள்ளை ரொட்டி அல்லது சர்க்கரை உணவுகளுக்கு பதிலாக"}, {"start": 176000, "end": 181440, "text": "காய்கறிகள் போன்ற நார்ச்சத்து உணவுகளை அதிகம் சாப்பிடுங்கள்"}, {"start": 178840, "end": 184959, "text": "பழங்கள் முழு தானியங்கள் மற்றும் பீன்ஸ் அதிகம்"}, {"start": 181440, "end": 188120, "text": "நார்ச்சத்து மற்றும் இரத்த சர்க்கரையை நிர்வகிக்க உதவுகிறது"}, {"start": 184959, "end": 190680, "text": "நீங்கள் சிற்றுண்டி சாப்பிட்டால், உணவைத் தவிர்க்காதீர்கள்"}, {"start": 188120, "end": 195519, "text": "பழம் போன்ற ஆரோக்கியமான விருப்பங்களைத் தேர்வு செய்யவும்"}, {"start": 190680, "end": 198599, "text": "கொட்டைகள் தண்ணீர் குடிக்கும் தண்ணீர் சிறந்த பானம்"}, {"start": 195519, "end": 202319, "text": "கோலா அல்லது பழம் போன்ற சர்க்கரை பானங்களைத் தவிர்க்கவும்"}, {"start": 198599, "end": 204400, "text": "சாறுகள் உங்கள் இரத்த சர்க்கரையை அதிகரிக்கின்றன"}, {"start": 202319, "end": 207200, "text": "உங்களிடம் உள்ளது அது இருப்பது பற்றி அல்ல"}, {"start": 204400, "end": 209799, "text": "சரியானது சிறிய நிலையானதாக ஆக்குவது"}, {"start": 207200, "end": 213519, "text": "நிர்வகிக்க உதவும் உங்கள் உணவில் மேம்பாடுகள்"}, {"start": 209799, "end": 213519, "text": "உங்கள் வகை இரண்டு நீரிழிவு நோய்"}]