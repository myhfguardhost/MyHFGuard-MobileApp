[{"start": 829, "end": 6279, "text": "了解血压"}, {"start": 3490, "end": 8410, "text": "你的心脏泵送血液氧气并且"}, {"start": 6279, "end": 9990, "text": "营养物质通过您体内的动脉"}, {"start": 8410, "end": 12090, "text": "本体"}, {"start": 9990, "end": 14890, "text": "血压是血液的力量"}, {"start": 12090, "end": 16810, "text": "靠在你的动脉壁上"}, {"start": 14890, "end": 19810, "text": "有两个读数测量"}, {"start": 16810, "end": 22600, "text": "血压是收缩压"}, {"start": 19810, "end": 24670, "text": "较高的数字测量的力"}, {"start": 22600, "end": 27570, "text": "血液被推到你的身体周围"}, {"start": 24670, "end": 29669, "text": "当你的心脏收缩时"}, {"start": 27570, "end": 32120, "text": "舒张压是较低的数字"}, {"start": 29669, "end": 35300, "text": "它测量心脏何时放松"}, {"start": 32120, "end": 37310, "text": "节拍之间"}, {"start": 35300, "end": 39620, "text": "高血压是指当您的血液"}, {"start": 37310, "end": 41060, "text": "压力总是高于应有的压力"}, {"start": 39620, "end": 44180, "text": "是"}, {"start": 41060, "end": 47060, "text": "这也称为高血压和"}, {"start": 44180, "end": 50120, "text": "通常当您的水平"}, {"start": 47060, "end": 52360, "text": "90毫米以上始终在140以上"}, {"start": 50120, "end": 52360, "text": "汞"}, {"start": 52530, "end": 57540, "text": "高血压使你的动脉"}, {"start": 55020, "end": 59290, "text": "弹性较小并且损坏壁"}, {"start": 57540, "end": 62290, "text": "你的动脉"}, {"start": 59290, "end": 64960, "text": "这使得脂肪更容易沉积"}, {"start": 62290, "end": 67830, "text": "建立并限制流通"}, {"start": 64960, "end": 67830, "text": "血液和氧气"}, {"start": 67860, "end": 73310, "text": "这可能导致心脏病发作或"}, {"start": 70310, "end": 73310, "text": "中风"}, {"start": 73500, "end": 78100, "text": "高血压通常没有"}, {"start": 76110, "end": 80740, "text": "症状"}, {"start": 78100, "end": 83530, "text": "如果不及时治疗，可能会导致心脏病"}, {"start": 80740, "end": 86980, "text": "与循环系统疾病"}, {"start": 83530, "end": 89370, "text": "任何人都可能患有高血压呢"}, {"start": 86980, "end": 92979, "text": "可能是吃盐过多引起的"}, {"start": 89370, "end": 97650, "text": "饮酒过量"}, {"start": 92979, "end": 100479, "text": "超重或不够活跃"}, {"start": 97650, "end": 102880, "text": "控制你的血压并且"}, {"start": 100479, "end": 105490, "text": "了解更多关于救生的信息"}, {"start": 102880, "end": 110110, "text": "我们资助的研究"}, {"start": 105490, "end": 114510, "text": "欲了解更多信息，请访问 BHS 组织点"}, {"start": 110110, "end": 114510, "text": "英国正斜线血压"}]