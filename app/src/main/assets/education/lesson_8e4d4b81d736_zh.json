[{"start": 30, "end": 5060, "text": "脉搏或心率是指"}, {"start": 2970, "end": 7680, "text": "心脏每分钟跳动的次数。"}, {"start": 5060, "end": 9150, "text": "目标心率是指运动时应"}, {"start": 7680, "end": 12240, "text": "达到的每分钟跳动次数范围。"}, {"start": 9150, "end": 14370, "text": "建议目标心率保持在"}, {"start": 14370, "end": 19170, "text": "最大心率的 50% 到 70% 之间。此范围仅供"}, {"start": 17279, "end": 21180, "text": "参考，即使患有"}, {"start": 19170, "end": 23670, "text": "心脏疾病，除非服用某些"}, {"start": 21180, "end": 25439, "text": "药物，否则无需改变。如果"}, {"start": 23670, "end": 28859, "text": "心率超过最大心率的 70%，也不用担心。"}, {"start": 25439, "end": 30300, "text": "在此范围内运动"}, {"start": 28859, "end": 33270, "text": "有助于您安全地提高和保持"}, {"start": 30300, "end": 35309, "text": "运动水平。您可以"}, {"start": 33270, "end": 37140, "text": "手动测量心率，方法是将两根"}, {"start": 35309, "end": 39559, "text": "手指轻轻放在"}, {"start": 37140, "end": 42600, "text": "手腕内侧，也称为测量脉搏。"}, {"start": 39559, "end": 44460, "text": "或者，您也可以使用健身追踪器等可穿戴设备，它们"}, {"start": 42600, "end": 47280, "text": "可以全天监测您"}, {"start": 44460, "end": 49350, "text": "在健身房的心率。"}, {"start": 47280, "end": 52260, "text": "一些健身器材"}, {"start": 49350, "end": 55289, "text": "也配备了心率追踪器。请访问"}, {"start": 52260, "end": 57480, "text": "VHF.org.uk/targetheartrate 使用我们的计算器。"}, {"start": 57480, "end": 60860, "text": "[音乐]"}]