[{"start": 0, "end": 5650, "text": "[音乐]"}, {"start": 2370, "end": 8800, "text": "为什么地中海饮食对"}, {"start": 5650, "end": 10870, "text": "心脏有益？说到健康"}, {"start": 8800, "end": 14440, "text": "饮食，我们可以从世界各地的研究中学到很多。"}, {"start": 10870, "end": 16179, "text": "研究表明，遵循"}, {"start": 14440, "end": 18759, "text": "传统"}, {"start": 16179, "end": 20380, "text": "地中海饮食的人们享有诸多健康益处，"}, {"start": 18759, "end": 24519, "text": "包括降低心脏病、"}, {"start": 20380, "end": 26529, "text": "中风和2型糖尿病的发病率。你可能"}, {"start": 24519, "end": 30390, "text": "认为地中海饮食意味着"}, {"start": 26529, "end": 34480, "text": "大量的披萨和意大利面，但事实并非如此。"}, {"start": 30390, "end": 36730, "text": "地中海饮食包含哪些内容？"}, {"start": 34480, "end": 38800, "text": "实际的饮食结构在地中海地区可能有所不同，"}, {"start": 36730, "end": 41530, "text": "但其核心要素包括：大量的"}, {"start": 38800, "end": 44170, "text": "水果和蔬菜；鱼类，包括白肉"}, {"start": 41530, "end": 46450, "text": "鱼和油性鱼，例如沙丁鱼和"}, {"start": 44170, "end": 49180, "text": "鲑鱼；全谷物，例如"}, {"start": 46450, "end": 51180, "text": "全麦面包和糙米；豆类，"}, {"start": 49180, "end": 54730, "text": "例如鹰嘴豆和扁豆；"}, {"start": 51180, "end": 57460, "text": "无盐坚果和种子；少量"}, {"start": 54730, "end": 60790, "text": "瘦肉和低脂乳制品；橄榄油；"}, {"start": 57460, "end": 62829, "text": "新鲜香草、洋葱和大蒜。有些"}, {"start": 60790, "end": 66939, "text": "人认为葡萄酒也是这种"}, {"start": 62829, "end": 68710, "text": "饮食方式的一部分，但其实并非必需。如果你"}, {"start": 66939, "end": 71109, "text": "饮酒，重要的是要"}, {"start": 68710, "end": 73840, "text": "适量，每周饮酒量不要超过14个"}, {"start": 71109, "end": 76600, "text": "单位。但健康不仅仅关乎"}, {"start": 73840, "end": 78579, "text": "食物和饮料，其他传统的"}, {"start": 76600, "end": 81369, "text": "地中海生活方式习惯也"}, {"start": 78579, "end": 83679, "text": "可能对其产生影响，例如"}, {"start": 81369, "end": 85479, "text": "细嚼慢咽，以及与他人一起进餐。"}, {"start": 85479, "end": 91209, "text": "研究发现，地中海饮食习惯的人，如果生活方式更轻松，并坚持规律的体育锻炼，患"}, {"start": 93369, "end": 99880, "text": "心脏和循环系统疾病的风险就会降低。地中海饮食如何"}, {"start": 97030, "end": 101649, "text": "帮助降低风险呢？"}, {"start": 99880, "end": 103709, "text": "地中海饮食的健康益处并非"}, {"start": 101649, "end": 106479, "text": "源于单一食物，而是整体"}, {"start": 106479, "end": 113350, "text": "饮食的结果。地中海饮食"}, {"start": 109149, "end": 115539, "text": "富含不饱和脂肪，橄榄油就是"}, {"start": 113350, "end": 118029, "text": "一个众所周知的例子，但"}, {"start": 115539, "end": 120880, "text": "坚果和油性鱼类也富含不饱和脂肪。"}, {"start": 118029, "end": 123039, "text": "从"}, {"start": 120880, "end": 125439, "text": "高饱和脂肪饮食转向富含不饱和脂肪的饮食，"}, {"start": 123039, "end": 128110, "text": "例如食用这些不饱和脂肪的食物，可以帮助降低"}, {"start": 125439, "end": 130540, "text": "胆固醇水平，从而降低"}, {"start": 128110, "end": 132760, "text": "心脏病和中风的风险。"}, {"start": 130540, "end": 134810, "text": "注重食用新鲜未加工的食物"}, {"start": 132760, "end": 137180, "text": "有助于减少盐的摄入。"}, {"start": 134810, "end": 139490, "text": "研究表明，摄入过多的盐"}, {"start": 137180, "end": 141020, "text": "会导致高血压，因此"}, {"start": 139490, "end": 144890, "text": "减少盐的摄入有助于将血压维持"}, {"start": 141020, "end": 147050, "text": "在健康水平。富含纤维的饮食"}, {"start": 144890, "end": 150319, "text": "也与较低的心脏病发病率相关。"}, {"start": 150319, "end": 154959, "text": "豆类、水果和蔬菜中富含可溶性纤维，"}, {"start": 152870, "end": 157040, "text": "有助于降低胆固醇水平。"}, {"start": 154959, "end": 159140, "text": "研究表明，遵循"}, {"start": 157040, "end": 162050, "text": "地中海饮食还有助于人们"}, {"start": 159140, "end": 165590, "text": "保持健康的体重。想了解如何"}, {"start": 162050, "end": 170530, "text": "制作地中海餐食，请访问"}, {"start": 165590, "end": 170530, "text": "bhf.org.uk/makeit。 医学"}]