[{"start": 0, "end": 1960, "text": "இதய செயலிழப்பு என்றால் என்ன?"}, {"start": 1960, "end": 3920, "text": "உங்கள் இதயம் ஒரு தசை"}, {"start": 3920, "end": 6400, "text": "உங்கள் உடலின் ஒவ்வொரு பகுதிக்கும் இரத்தத்தை பம்ப் செய்கிறது."}, {"start": 8720, "end": 10680, "text": "இதய செயலிழப்பு ஒரு நிபந்தனை"}, {"start": 10680, "end": 12760, "text": "அங்கு உங்கள் இதய தசை இரத்தத்தை பம்ப் செய்யாது"}, {"start": 12760, "end": 14320, "text": "உடலைச் சரியாகச் சுற்றி."}, {"start": 15800, "end": 18640, "text": "உங்கள் இதயம் பெரிதாகும்போது இது நிகழ்கிறது,"}, {"start": 18640, "end": 20360, "text": "பலவீனமான, அல்லது கடினமான."}, {"start": 22320, "end": 24560, "text": "மாரடைப்பு மற்றும் உயர் இரத்த அழுத்தம்"}, {"start": 24560, "end": 27080, "text": "இதய செயலிழப்புக்கான பொதுவான காரணங்கள்."}, {"start": 27080, "end": 29520, "text": "ஆனால் இன்னும் பல உள்ளன."}, {"start": 29520, "end": 31160, "text": "உங்கள் சுகாதாரக் குழுவிடம் கேளுங்கள்"}, {"start": 31160, "end": 33120, "text": "உங்கள் காரணம் பற்றி."}, {"start": 34080, "end": 36520, "text": "உங்கள் இதயம் சரியாக பம்ப் செய்யாதபோது,"}, {"start": 36520, "end": 39960, "text": "உங்கள் உடலின் முக்கியமான உறுப்புகளுக்கு குறைவான இரத்தம் செல்கிறது."}, {"start": 39960, "end": 43120, "text": "இது உங்களை சோர்வாகவும் மயக்கமாகவும் உணரலாம்."}, {"start": 43120, "end": 44840, "text": "இதய செயலிழப்பு உள்ளவர்கள்"}, {"start": 44840, "end": 47240, "text": "மூச்சுத் திணறல் ஏற்படலாம்,"}, {"start": 47240, "end": 50520, "text": "அல்லது சிறிதளவு முயற்சிக்குப் பிறகு வீங்கிய உணர்வு."}, {"start": 50520, "end": 54760, "text": "உடலைச் சுற்றி திரவம் குவிவதும் அடிக்கடி நிகழ்கிறது."}, {"start": 54760, "end": 57520, "text": "இதய உந்தி செயல்பாடு அசாதாரணமாக இருக்கும்போது,"}, {"start": 57520, "end": 59240, "text": "உடல் சமாளிக்க முயற்சிக்கிறது"}, {"start": 59240, "end": 62680, "text": "இரத்த ஓட்டத்தில் திரவத்தின் அளவை அதிகரிப்பதன் மூலம்."}, {"start": 62680, "end": 65280, "text": "இந்த திரவம் பின்னர் இரத்த ஓட்டத்தில் இருந்து கசியும்"}, {"start": 65280, "end": 69120, "text": "நுரையீரல், கணுக்கால், கால்கள் அல்லது வயிற்றில்,"}, {"start": 69120, "end": 71080, "text": "நீங்கள் வீக்கத்தைக் கவனிக்கலாம்."}, {"start": 71080, "end": 74080, "text": "இதய செயலிழப்பு ஒரு தீவிர பிரச்சனை."}, {"start": 74080, "end": 77000, "text": "ஆனால் குடும்பத்தினரின் ஆதரவுடன், அன்புக்குரியவர்கள்,"}, {"start": 77000, "end": 78840, "text": "மற்றும் உங்கள் சுகாதாரக் குழு,"}, {"start": 78840, "end": 82440, "text": "நீங்கள் உங்கள் நிலையை நிர்வகிக்கலாம், உங்கள் ஆரோக்கியத்தை மேம்படுத்தலாம்,"}, {"start": 82440, "end": 84600, "text": "மற்றும் விஷயங்களைச் செய்வதை எளிதாக்குங்கள்"}, {"start": 84600, "end": 86640, "text": "அது உங்களுக்கு முக்கியமானது."}, {"start": 86640, "end": 88000, "text": "உங்கள் மருத்துவரிடம் பேசுங்கள்"}, {"start": 88000, "end": 90600, "text": "உங்கள் இதய செயலிழப்புக்கு என்ன வழிவகுத்தது என்பது பற்றி."}, {"start": 90600, "end": 93520, "text": "மேலும் இதய செயலிழப்பை நிர்வகிப்பது பற்றி மேலும் அறிய,"}, {"start": 93520, "end": 96160, "text": "இந்தத் தொடரில் உள்ள மற்ற வீடியோக்களைப் பார்க்கவும்."}]