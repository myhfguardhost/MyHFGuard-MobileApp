[{"start": 3439, "end": 9960, "text": "为什么盐吃太多对身体不好？"}, {"start": 6200, "end": 14240, "text": "你呢？吃太多"}, {"start": 9960, "end": 14240, "text": "盐对你的血液有害"}, {"start": 15080, "end": 19680, "text": "压力。你的肾脏有助于控制你的"}, {"start": 17440, "end": 19680, "text": "血液"}, {"start": 19880, "end": 26480, "text": "通过从你的身体中取出水来施加压力"}, {"start": 23560, "end": 28160, "text": "血液。盐含有钠。太"}, {"start": 26480, "end": 30400, "text": "血液中的钠过多会导致"}, {"start": 28160, "end": 33320, "text": "水回流。更多的盐意味着更多"}, {"start": 30400, "end": 35239, "text": "你的血管中有水并且"}, {"start": 33320, "end": 38719, "text": "[音乐]"}, {"start": 35239, "end": 38719, "text": "表示更高"}, {"start": 38760, "end": 44879, "text": "压力。时间长了，血压就会升高"}, {"start": 41440, "end": 44879, "text": "使你的血管正常工作"}, {"start": 45960, "end": 50960, "text": "难以应对。他们的墙变厚，"}, {"start": 49200, "end": 53960, "text": "减少血液内部的空间"}, {"start": 50960, "end": 53960, "text": "船只。"}, {"start": 54559, "end": 61800, "text": "你的血压甚至升高"}, {"start": 57480, "end": 64559, "text": "越来越少的血液可能会到达您的"}, {"start": 61800, "end": 67159, "text": "机关。血液携带氧气和其他物质"}, {"start": 64559, "end": 69760, "text": "周围营养物质"}, {"start": 67159, "end": 74880, "text": "本体。心脏供血减少会导致"}, {"start": 69760, "end": 74880, "text": "称为心绞痛甚至心脏的疼痛"}, {"start": 78040, "end": 85280, "text": "攻击。大脑的血液减少可以"}, {"start": 80880, "end": 87040, "text": "引起中风或一种类型的痴呆。"}, {"start": 85280, "end": 91119, "text": "高血压有助于"}, {"start": 87040, "end": 91119, "text": "大约一半的心脏病发作和"}, {"start": 91720, "end": 99040, "text": "笔画。成人及11岁以上儿童"}, {"start": 94720, "end": 99040, "text": "吃盐不宜超过6克"}, {"start": 101880, "end": 108759, "text": "天。 6克是一个级别"}, {"start": 105479, "end": 110960, "text": "茶匙。相当于 2.4 克"}, {"start": 108759, "end": 113960, "text": "钠。年幼的孩子应该吃"}, {"start": 110960, "end": 113960, "text": "较少。"}, {"start": 114000, "end": 118759, "text": "我们吃的盐有3/4隐藏在"}, {"start": 116399, "end": 121520, "text": "现成的"}, {"start": 118759, "end": 126000, "text": "食物。它们甚至可能尝起来不咸，"}, {"start": 121520, "end": 126000, "text": "喜欢面包和早餐"}, {"start": 126759, "end": 133040, "text": "谷物。你能做什么"}, {"start": 130120, "end": 135760, "text": "做什么？检查食品标签。使用颜色"}, {"start": 133040, "end": 137840, "text": "代码等于低盐。选择品牌"}, {"start": 135760, "end": 141160, "text": "用较少的盐。有的甚至更低"}, {"start": 137840, "end": 141160, "text": "盐版本。"}, {"start": 141360, "end": 146239, "text": "烹饪时请勿加盐。添加"}, {"start": 143440, "end": 148959, "text": "香料用黑胡椒、香草、香料，"}, {"start": 146239, "end": 148959, "text": "和柠檬"}, {"start": 151160, "end": 155840, "text": "果汁。你能发现咸的食物吗？"}, {"start": 154239, "end": 158840, "text": "ph.org.uk/salty-surprises。"}, {"start": 155840, "end": 158840, "text": "英国/咸味-惊喜。"}]