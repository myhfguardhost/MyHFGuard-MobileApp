[{"start": 8559, "end": 13200, "text": "வழக்கமான உடல் செயல்பாடு உங்களை குறைக்கலாம்"}, {"start": 10719, "end": 16200, "text": "இதயம் மற்றும் சுற்றோட்ட நோய் ஆபத்து மூலம்"}, {"start": 13200, "end": 16200, "text": "35%."}, {"start": 19439, "end": 23279, "text": "நீங்கள் சுறுசுறுப்பாக இருக்கும்போது, வெப்பம் உருவாகிறது"}, {"start": 21439, "end": 27359, "text": "உங்கள் தசைகளால் உங்கள் உடலை அதிகரிக்கிறது"}, {"start": 23279, "end": 29359, "text": "வெப்பநிலை, உங்களை வெப்பமாக உணர வைக்கிறது."}, {"start": 27359, "end": 31279, "text": "உங்கள் இதயம் வேகமாக துடிக்கத் தொடங்குகிறது,"}, {"start": 29359, "end": 34079, "text": "உங்கள் தசைகளுக்கு அதிக இரத்தத்தை செலுத்துகிறது"}, {"start": 31279, "end": 36160, "text": "பயன்படுத்துகின்றனர். உங்கள் இதயமும் ஒரு தசைதான்."}, {"start": 34079, "end": 38480, "text": "நீங்கள் தொடர்ந்து செயலில் இருந்தால், அது கிடைக்கும்"}, {"start": 36160, "end": 40640, "text": "பெரியது மற்றும் வலிமையானது. உங்கள் தசைகள்"}, {"start": 38480, "end": 42239, "text": "கடினமாக உழைக்கிறார்கள், அதனால் அவர்களுக்கு இன்னும் தேவை"}, {"start": 40640, "end": 44079, "text": "ஆக்ஸிஜன்."}, {"start": 42239, "end": 46000, "text": "நீங்கள் வேகமாக சுவாசிக்க ஆரம்பிக்கிறீர்கள், அதனால் உங்கள்"}, {"start": 44079, "end": 48480, "text": "இரத்தம் உங்களிடமிருந்து அதிக ஆக்ஸிஜனை எடுக்க முடியும்"}, {"start": 46000, "end": 50800, "text": "நுரையீரல். உங்கள் நுரையீரல் உருவாக்க கடினமாக உழைக்கிறது"}, {"start": 48480, "end": 53440, "text": "இது நடக்கும். உங்கள் இரத்தம் எடுத்தவுடன்"}, {"start": 50800, "end": 56930, "text": "அதிக ஆக்ஸிஜன்,"}, {"start": 53440, "end": 58960, "text": "இது நீங்கள் பயன்படுத்தும் தசைகளை நகர்த்துகிறது,"}, {"start": 56930, "end": 62640, "text": "[இசை]"}, {"start": 58960, "end": 64879, "text": "அவர்களுக்குத் தேவையான கூடுதல் ஆக்ஸிஜனைக் கொடுக்கிறது."}, {"start": 62640, "end": 66560, "text": "நீங்கள் தொடர்ந்து செயலில் இருந்தால், மேலும்"}, {"start": 64879, "end": 69200, "text": "உங்கள் தசைகளில் நுண்குழாய்கள் வளரும்"}, {"start": 66560, "end": 71439, "text": "பணியாற்றி வருகிறார். இதுவும் ஒரு காரணம்"}, {"start": 69200, "end": 73200, "text": "செயல்பாடு எளிதாக உணரத் தொடங்குகிறது"}, {"start": 71439, "end": 75040, "text": "நேரம்."}, {"start": 73200, "end": 78240, "text": "சுறுசுறுப்பாக செயல்படுவது உள்ளவர்களுக்கு மிகவும் நல்லது"}, {"start": 75040, "end": 80479, "text": "நீரிழிவு நோய். உங்களுக்கு டைப் 2 நீரிழிவு நோய் இருந்தால்,"}, {"start": 78240, "end": 82159, "text": "உங்கள் இரத்தத்தில் குளுக்கோஸ் அதிகமாக உள்ளது,"}, {"start": 80479, "end": 85119, "text": "உங்களிடம் போதுமான அளவு இல்லாததால் இருக்கலாம்"}, {"start": 82159, "end": 87600, "text": "இன்சுலின். உடல் செயல்பாடு நீங்கள் பயன்படுத்த உதவுகிறது"}, {"start": 85119, "end": 89759, "text": "உங்களிடம் உள்ள இன்சுலின். இதுவும் உதவுகிறது"}, {"start": 87600, "end": 92799, "text": "உங்கள் செல்கள் குளுக்கோஸைப் பயன்படுத்துகின்றன"}, {"start": 89759, "end": 94720, "text": "இன்சுலின் இல்லை. வழக்கமான உடல் செயல்பாடு"}, {"start": 92799, "end": 97439, "text": "உங்கள் நினைவாற்றலையும் கவனத்தையும் மேம்படுத்தலாம்"}, {"start": 94720, "end": 99520, "text": "இடைவெளி. காலப்போக்கில், மூளையின் பிட்"}, {"start": 97439, "end": 102759, "text": "நினைவகம் மற்றும் கற்றலில் ஈடுபாடு தெரிகிறது"}, {"start": 99520, "end": 102759, "text": "பெரிதாகும்."}, {"start": 104479, "end": 108880, "text": "நீண்ட கால உடல் செயல்பாடு ஏ"}, {"start": 106720, "end": 111280, "text": "குறைந்த இதய துடிப்பு மற்றும் குறைந்த இரத்தம்"}, {"start": 108880, "end": 114159, "text": "அழுத்தம். இது உங்கள் ஆபத்தை குறைக்க உதவுகிறது"}, {"start": 111280, "end": 116960, "text": "இதயம் மற்றும் இரத்த ஓட்ட நோய்."}, {"start": 114159, "end": 119119, "text": "மேலும் சிரிக்க இன்னும் பல காரணங்கள் உள்ளன."}, {"start": 116960, "end": 121439, "text": "நீங்கள் சுறுசுறுப்பாக இருக்கும்போது, உங்கள் மூளை உற்பத்தி செய்கிறது"}, {"start": 119119, "end": 123200, "text": "எண்டோர்பின்கள் எனப்படும் இரசாயனங்கள். இவை"}, {"start": 121439, "end": 125520, "text": "வலியின் உணர்வுகளைக் குறைத்து உங்களை உருவாக்குங்கள்"}, {"start": 123200, "end": 127680, "text": "மேலும் நேர்மறையாக உணர்கிறேன். செயலில் வெட்டுக்களைப் பெறுதல்"}, {"start": 125520, "end": 130080, "text": "மன அழுத்த ஹார்மோன்களைக் குறைக்கிறது"}, {"start": 127680, "end": 132000, "text": "பதட்டம். செயல்பாட்டை ஒரு உடன் இணைக்கவும்"}, {"start": 130080, "end": 134800, "text": "சரிவிகித உணவு மற்றும் நீங்களே உதவுவீர்கள்"}, {"start": 132000, "end": 137520, "text": "ஆரோக்கியமான எடையை அடையவும் பராமரிக்கவும். இலக்கு"}, {"start": 134800, "end": 140160, "text": "150 நிமிடங்களுக்கு மிதமான தீவிரம்\nவாரத்திற்கு"}, {"start": 137520, "end": 145480, "text": "செயல்பாடு. சுறுசுறுப்பாக இருக்க முயற்சி செய்யுங்கள்"}, {"start": 140160, "end": 145480, "text": "ஒவ்வொரு நாளும். ஒவ்வொரு 10 நிமிடமும் கணக்கிடப்படுகிறது."}]