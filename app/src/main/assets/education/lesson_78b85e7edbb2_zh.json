[{"start": 5510, "end": 8700, "text": "[音乐]"}, {"start": 9650, "end": 12719, "text": "道格和莫莉去购物"}, {"start": 12030, "end": 14849, "text": "杂货"}, {"start": 12719, "end": 17480, "text": "道格发现健康饮食"}, {"start": 14849, "end": 17480, "text": "心力衰竭"}, {"start": 23019, "end": 29250, "text": "来吧爱我有手推车我"}, {"start": 25740, "end": 31930, "text": "只需要找到最少的为什么不"}, {"start": 29250, "end": 33480, "text": "你在那个包里得到了很多你永远不会得到的东西"}, {"start": 31930, "end": 35460, "text": "找到它"}, {"start": 33480, "end": 39930, "text": "在这里"}, {"start": 35460, "end": 39930, "text": "好的，我们现在可以通电了，我准备好了"}, {"start": 50210, "end": 55339, "text": "嗯，去杂货店真好"}, {"start": 53010, "end": 57480, "text": "购物完毕"}, {"start": 55339, "end": 58309, "text": "在我们得到我们的之前，让我们打开它们的包装"}, {"start": 57480, "end": 60870, "text": "午餐"}, {"start": 58309, "end": 63140, "text": "你知道这并不难确定"}, {"start": 60870, "end": 66780, "text": "我们正在吃健康的饮食，例如"}, {"start": 63140, "end": 68970, "text": "营养师一直讲得很好"}, {"start": 66780, "end": 70940, "text": "吃过蔬菜和新鲜水果所以"}, {"start": 68970, "end": 73610, "text": "确实没有什么不同"}, {"start": 70940, "end": 76530, "text": "一直喜欢苹果"}, {"start": 73610, "end": 77840, "text": "我们得到了一些漂亮的葡萄"}, {"start": 76530, "end": 81090, "text": "价格不错"}, {"start": 77840, "end": 85229, "text": "是的，我也喜欢苹果，我们有一些好的"}, {"start": 81090, "end": 89810, "text": "今天的蔬菜也是我有基础的"}, {"start": 85229, "end": 92149, "text": "漂亮的西红柿、一些胡萝卜和"}, {"start": 89810, "end": 94920, "text": "鳄梨"}, {"start": 92149, "end": 97020, "text": "这样我们就可以吃沙拉三明治了"}, {"start": 94920, "end": 98940, "text": "午餐代替了我们平时的汤\n【0029】有了他我想就不会再这样了"}, {"start": 97020, "end": 100640, "text": "有了他我想就不会再这样了"}, {"start": 98940, "end": 105350, "text": "努力使哦"}, {"start": 100640, "end": 109399, "text": "我们有一些土豆和"}, {"start": 105350, "end": 112500, "text": "这些新鲜的青豆"}, {"start": 109399, "end": 114440, "text": "我们可以煮马铃薯胡萝卜和\n【0034】豆14耶"}, {"start": 112500, "end": 117660, "text": "豆子 14 是的"}, {"start": 114440, "end": 119970, "text": "营养师说你必须有两个"}, {"start": 117660, "end": 123539, "text": "水果块和蔬菜各五块"}, {"start": 119970, "end": 126330, "text": "我们应该能够做到的那一天"}, {"start": 123539, "end": 128220, "text": "我们买一些面包做三明治是的"}, {"start": 126330, "end": 129289, "text": "你不是在 买了那个好房子吗\n【0040】生命哦"}, {"start": 128220, "end": 131819, "text": "生活哦"}, {"start": 129289, "end": 133560, "text": "这看起来真的很好我可以开始"}, {"start": 131819, "end": 136110, "text": "制作三明治哦，挂在"}, {"start": 133560, "end": 137790, "text": "我们需要解压其余部分的分钟"}, {"start": 136110, "end": 141060, "text": "这些杂货在我们开始之前"}, {"start": 137790, "end": 143540, "text": "午餐我会打开包装，你可以把它们放进去\n【0046】走开还好"}, {"start": 141060, "end": 148110, "text": "离开好吧"}, {"start": 143540, "end": 150690, "text": "这是牛奶和酸奶的样子"}, {"start": 148110, "end": 153629, "text": "就像我们有低脂选择一样，是的"}, {"start": 150690, "end": 156810, "text": "那就对了，低脂可以放这些吗"}, {"start": 153629, "end": 159750, "text": "在冰箱里我们有一些很好的冷冻食品"}, {"start": 156810, "end": 162390, "text": "三文鱼排我们可以喝茶"}, {"start": 159750, "end": 165890, "text": "今晚这里有一些去皮鸡肉"}, {"start": 162390, "end": 169680, "text": "我们可以有明天晚上和"}, {"start": 165890, "end": 171720, "text": "这是我们可以吃的一罐金枪鱼"}, {"start": 169680, "end": 174360, "text": "本周哦，这让我\n【0056】饿了我们快点去吃一顿吧\n【0057】多多哦"}, {"start": 171720, "end": 176300, "text": "饿了我们快点去吃吧"}, {"start": 174360, "end": 180510, "text": "很多哦"}, {"start": 176300, "end": 185220, "text": "这是我们拿到的食品储藏室的罐头"}, {"start": 180510, "end": 187319, "text": "我检查了一些烤豆子和西红柿"}, {"start": 185220, "end": 189930, "text": "超市内所有标签为"}, {"start": 187319, "end": 192120, "text": "找出它们含有多少盐，以及"}, {"start": 189930, "end": 193319, "text": "我们设法找到了减盐的一种\n【0063】这样就好了"}, {"start": 192120, "end": 196680, "text": "所以这样很好"}, {"start": 193319, "end": 199379, "text": "哦，谷物有蜱虫，所以它一定是"}, {"start": 196680, "end": 203629, "text": "一个不错的选择，打勾表示这是一个"}, {"start": 199379, "end": 203629, "text": "麦片的更健康选择嗯"}, {"start": 204260, "end": 210480, "text": "袋子里的其他东西"}, {"start": 206599, "end": 213540, "text": "是的，我们有一些人造黄油，它是不同的"}, {"start": 210480, "end": 215750, "text": "从我们曾经得到的那一个来看，它是低的"}, {"start": 213540, "end": 219390, "text": "多不饱和盐\n【0071】它也很便宜，它只是一个家"}, {"start": 215750, "end": 221720, "text": "它也很便宜，它只是一个家"}, {"start": 219390, "end": 221720, "text": "品牌"}, {"start": 228500, "end": 234540, "text": "好的，午餐时间到了"}, {"start": 232430, "end": 236549, "text": "达格斯得知他应该选择"}, {"start": 234540, "end": 239940, "text": "吃两块水果和五块"}, {"start": 236549, "end": 243510, "text": "每天蔬菜低盐或减少"}, {"start": 239940, "end": 245280, "text": "盐类食品和低脂乳制品"}, {"start": 243510, "end": 247350, "text": "应避免高盐食物"}, {"start": 245280, "end": 250109, "text": "并在他的烹饪中或在烹饪时添加盐"}, {"start": 247350, "end": 252780, "text": "他应该阅读的营养表"}, {"start": 250109, "end": 255120, "text": "他所购买的食品上的标签通过选择"}, {"start": 252780, "end": 258139, "text": "食物与心脏基础蜱他"}, {"start": 255120, "end": 258139, "text": "做出更健康的选择"}]