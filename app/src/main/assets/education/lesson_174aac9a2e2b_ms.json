[{"start": 1180, "end": 11989, "text": "[Muzik]"}, {"start": 26000, "end": 33420, "text": "pengangkut bersama glukosa 2 atau sglt2"}, {"start": 31320, "end": 36620, "text": "diekspresikan dalam tubul berbelit proksimal"}, {"start": 33420, "end": 36620, "text": "buah pinggang"}, {"start": 37559, "end": 42540, "text": "dan bertanggungjawab untuk hampir semua"}, {"start": 39960, "end": 45379, "text": "penyerapan semula natrium dan glukosa ke dalam"}, {"start": 42540, "end": 45379, "text": "darah pada manusia"}, {"start": 53539, "end": 59660, "text": "sglt2 diekspresikan secara berlebihan pada penghidap"}, {"start": 57000, "end": 62960, "text": "diabetes jenis 2 yang menyumbang kepada"}, {"start": 59660, "end": 62960, "text": "keadaan hiperglisemia"}, {"start": 70880, "end": 76380, "text": "sglt2 Perencat atau"}, {"start": 73700, "end": 78600, "text": "sglt2i menyekat penyerapan semula"}, {"start": 76380, "end": 79470, "text": "natrium dan glukosa yang ditapis kembali ke dalam"}, {"start": 78600, "end": 83159, "text": "darah"}, {"start": 79470, "end": 85979, "text": "[Muzik]"}, {"start": 83159, "end": 87560, "text": "menyebabkan peningkatan perkumuhan kedua-duanya dalam"}, {"start": 85979, "end": 90479, "text": "air kencing"}, {"start": 87560, "end": 93240, "text": "sglt2is telah terbukti sebagai terapi yang berkesan"}, {"start": 90479, "end": 96420, "text": "untuk menurunkan kepekatan glukosa darah pada"}, {"start": 93240, "end": 99740, "text": "penghidap diabetes jenis 2 tetapi bukan untuk"}, {"start": 96420, "end": 99740, "text": "mereka yang tidak menghidap diabetes"}, {"start": 101340, "end": 107400, "text": "di luar kesan glukosa darah mereka"}, {"start": 104180, "end": 109740, "text": "sglt2is telah menunjukkan"}, {"start": 107400, "end": 112020, "text": "manfaat kardiovaskular dan buah pinggang melalui pelbagai"}, {"start": 109740, "end": 113820, "text": "mekanisme yang masih kami usahakan untuk"}, {"start": 112020, "end": 116040, "text": "fahami"}, {"start": 113820, "end": 118740, "text": "kajian menunjukkan ubat ini mengurangkan"}, {"start": 116040, "end": 121079, "text": "pramuat dan selepas beban jantung dan"}, {"start": 118740, "end": 123840, "text": "meningkatkan output jantung dengan meningkatkan"}, {"start": 121079, "end": 124759, "text": "keadaan pemuatan ventrikel dengan berbuat"}, {"start": 123840, "end": 127439, "text": "demikian"}, {"start": 124759, "end": 130140, "text": "sglt2is menggalakkan pembentukan semula terbalik jantung"}, {"start": 127439, "end": 132480, "text": "mekanisme tambahan untuk"}, {"start": 130140, "end": 134760, "text": "manfaat jantung daripada agen ini"}, {"start": 132480, "end": 136980, "text": "masih dijelaskan penambahbaikan buah pinggang"}, {"start": 134760, "end": 139739, "text": "berkaitan dengan perubahan dalam"}, {"start": 136980, "end": 141660, "text": "tekanan glomerular dan penapisan yang"}, {"start": 139739, "end": 145040, "text": "membawa kepada  Pengurangan keperluan"}, {"start": 141660, "end": 148200, "text": "dialisis dan pemindahan bersama"}, {"start": 145040, "end": 151140, "text": "sglt2is melindungi buah pinggang dan keras pada"}, {"start": 148200, "end": 153920, "text": "pesakit yang mungkin atau mungkin belum mengalami"}, {"start": 151140, "end": 153920, "text": "kegagalan jantung"}]