[{"start": 1170, "end": 10320, "text": "[音乐]"}, {"start": 7550, "end": 11360, "text": "当您"}, {"start": 10320, "end": 14009, "text": "患有心力衰竭"}, {"start": 11360, "end": 16680, "text": "轻度至中度的运动"}, {"start": 14009, "end": 18420, "text": "强度可能对您有益"}, {"start": 16680, "end": 21390, "text": "喜欢参加您的健身计划"}, {"start": 18420, "end": 24269, "text": "医院这些专业组班"}, {"start": 21390, "end": 26910, "text": "由物理治疗师监督和/或"}, {"start": 24269, "end": 28920, "text": "您可以与之交谈的医疗保健专业人士"}, {"start": 26910, "end": 30800, "text": "您的医生或物理治疗师关于"}, {"start": 28920, "end": 33030, "text": "最适合您的运动类型"}, {"start": 30800, "end": 35390, "text": "你可以选择做轻量的"}, {"start": 33030, "end": 38219, "text": "骑自行车或步行"}, {"start": 35390, "end": 41070, "text": "Doug每次需要步行30分钟"}, {"start": 38219, "end": 43620, "text": "当天我们建议您与朋友一起散步"}, {"start": 41070, "end": 45809, "text": "或者随身携带手机，以防万一"}, {"start": 43620, "end": 48570, "text": "您感到严重的呼吸急促的感觉"}, {"start": 45809, "end": 50610, "text": "头晕或有胸痛记得"}, {"start": 48570, "end": 53809, "text": "锻炼到可以行走的程度"}, {"start": 50610, "end": 53809, "text": "舒适地交谈"}, {"start": 54980, "end": 59789, "text": "是的，请你让我来报道"}, {"start": 58019, "end": 61320, "text": "低和你走道格我会放一个\n【0022】一点点白轻轻地我就"}, {"start": 59789, "end": 62940, "text": "轻轻一点点白色，我只是"}, {"start": 61320, "end": 64860, "text": "从不抽出时间做任何运动\n【0024】老婆一直想让我去"}, {"start": 62940, "end": 66090, "text": "妻子一直想让我去"}, {"start": 64860, "end": 68460, "text": "健身房，但我从来没有真正读过\n【0026】那个Lila加上我只是觉得格格不入"}, {"start": 66090, "end": 70890, "text": "莉拉加上我感觉格格不入"}, {"start": 68460, "end": 73229, "text": "是的，他们在医院告诉我，我已经"}, {"start": 70890, "end": 76530, "text": "每天散步半小时"}, {"start": 73229, "end": 78990, "text": "理疗师说我已经增加了"}, {"start": 76530, "end": 81600, "text": "我的健身有助于我的心力衰竭和"}, {"start": 78990, "end": 83930, "text": "让我感觉更好我们有一个开始"}, {"start": 81600, "end": 87229, "text": "慢走30分钟\n【0033】我们走吧"}, {"start": 83930, "end": 87229, "text": "我们走吧"}, {"start": 94810, "end": 98800, "text": "哦拜托我们要开始一个狡猾的土地了"}, {"start": 97270, "end": 101260, "text": "是一棵树，它又好又平，因为我"}, {"start": 98800, "end": 103150, "text": "不习惯这个，这是个好地方"}, {"start": 101260, "end": 105670, "text": "散步 我还没做过锻炼"}, {"start": 103150, "end": 108580, "text": "我也是，我们需要确保"}, {"start": 105670, "end": 109960, "text": "我们每天坚持这样做很好"}, {"start": 108580, "end": 112720, "text": "有人陪我一起散步，因为我"}, {"start": 109960, "end": 115300, "text": "知道我会找借口不去，是的，我是"}, {"start": 112720, "end": 116890, "text": "Visio 说的也有点像"}, {"start": 115300, "end": 119170, "text": "当我走路时我将能够"}, {"start": 116890, "end": 120850, "text": "如果我觉得也可以说话和走路"}, {"start": 119170, "end": 123210, "text": "呼吸急促然后我需要说话"}, {"start": 120850, "end": 123210, "text": "休息"}, {"start": 126540, "end": 132390, "text": "好吧，那是半个小时，嘿，你为什么这么做"}, {"start": 130570, "end": 134070, "text": "上手还蛮过瘾的"}, {"start": 132390, "end": 136450, "text": "根本"}, {"start": 134070, "end": 139860, "text": "好吧，我们明天可以再赶上是的"}, {"start": 136450, "end": 139860, "text": "到时候见"}, {"start": 143220, "end": 149260, "text": "记得锻炼到我们的水平"}, {"start": 145840, "end": 151209, "text": "舒适地行走和说话并保持活跃"}, {"start": 149260, "end": 153220, "text": "将帮助您感觉更好，因此即使您"}, {"start": 151209, "end": 156010, "text": "不觉得有动力，这很重要"}, {"start": 153220, "end": 159330, "text": "每天做一些运动"}, {"start": 156010, "end": 159330, "text": "散步可以提升你的心情"}]