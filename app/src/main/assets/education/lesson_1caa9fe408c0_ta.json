[{"start": 0, "end": 3199, "text": "உங்களுக்குத் தெரியுமா?"}, {"start": 1280, "end": 5839, "text": "கொலஸ்ட்ரால் உங்கள் ஆபத்தை அதிகரிக்கலாம்"}, {"start": 3199, "end": 8720, "text": "மாரடைப்பு அல்லது பக்கவாதம்"}, {"start": 5839, "end": 10960, "text": "கொலஸ்ட்ரால் ஒரு மெழுகு கொழுப்பு போன்ற பொருள்"}, {"start": 8720, "end": 13360, "text": "இது வளர்சிதை மாற்றத்திற்கு முக்கியமானது"}, {"start": 10960, "end": 15360, "text": "ஹார்மோன்களை உருவாக்க உங்கள் உடலால் பயன்படுத்தப்படுகிறது"}, {"start": 13360, "end": 17440, "text": "இருப்பினும் அதிக அளவு இது வழிவகுக்கும்"}, {"start": 15360, "end": 20560, "text": "இதயம் போன்ற கடுமையான உடல்நலப் பிரச்சினைகள்"}, {"start": 17440, "end": 22640, "text": "நோய் ldl கொழுப்பு அல்லது கெட்டது"}, {"start": 20560, "end": 24960, "text": "கொலஸ்ட்ரால் சுவர்களில் ஒட்டிக்கொள்ளலாம்"}, {"start": 22640, "end": 26800, "text": "உங்கள் தமனிகள் மற்றும் அடைப்புகளை ஏற்படுத்தும்"}, {"start": 24960, "end": 28800, "text": "இரத்தம் வருவதைத் தடுக்கிறது"}, {"start": 26800, "end": 30350, "text": "இதயம் மற்றும் உங்கள் வாய்ப்புகளை அதிகரிக்கும் a"}, {"start": 28800, "end": 31519, "text": "மாரடைப்பு அல்லது பக்கவாதம்"}, {"start": 30350, "end": 34880, "text": "[இசை]"}, {"start": 31519, "end": 37440, "text": "hdl கொழுப்பு அல்லது நல்ல கொழுப்பு"}, {"start": 34880, "end": 39600, "text": "எல்.டி.எல் கொழுப்பைக் கொண்டு செல்கிறது"}, {"start": 37440, "end": 43280, "text": "தமனிகள் மற்றும் கல்லீரலுக்குத் திரும்பும்"}, {"start": 39600, "end": 45600, "text": "உடைந்து வீணாகச் சென்றது"}, {"start": 43280, "end": 47840, "text": "அமைதியான கொலையாளி உயர் என்று அறியப்படுகிறது"}, {"start": 45600, "end": 50160, "text": "கொலஸ்ட்ரால் பொதுவாக இல்லை"}, {"start": 47840, "end": 52079, "text": "வெளிப்படையான அறிகுறிகள் அதனால் தான்"}, {"start": 50160, "end": 54399, "text": "நீங்கள் பார்வையிடுவது மிகவும் முக்கியமானது"}, {"start": 52079, "end": 57120, "text": "மருத்துவராக இருந்தாலும் சரி"}, {"start": 54399, "end": 59120, "text": "நீங்கள் நன்றாகவும் ஆரோக்கியமாகவும் இருக்கிறீர்கள்"}, {"start": 57120, "end": 61199, "text": "அதே சமயம் உயர்விற்கு எந்த ஒரு காரணமும் இல்லை"}, {"start": 59120, "end": 63520, "text": "கொலஸ்ட்ரால் ஆபத்து காரணிகள் உள்ளன"}, {"start": 61199, "end": 66400, "text": "இந்த நிலைக்கு பங்களிக்க முடியும்"}, {"start": 63520, "end": 69360, "text": "வயது புகைபிடித்தல் உடல்ரீதியாக இல்லாமை அடங்கும்"}, {"start": 66400, "end": 73360, "text": "உடல் பருமன் அல்லது அதிக எடையுடன் இருப்பது"}, {"start": 69360, "end": 75280, "text": "குடும்ப வரலாறு மற்றும் ஆரோக்கியமற்ற உணவு"}, {"start": 73360, "end": 77280, "text": "இதயத்திற்கான இந்த ஆபத்து காரணிகளில் பெரும்பாலானவை"}, {"start": 75280, "end": 79439, "text": "நோயை உருவாக்குவதன் மூலம் நிர்வகிக்கலாம்"}, {"start": 77280, "end": 82000, "text": "உங்களை மேம்படுத்துவது போன்ற வாழ்க்கைமுறை மாற்றங்கள்"}, {"start": 79439, "end": 84799, "text": "டயட் அதிகமாக உடற்பயிற்சி செய்தல் மற்றும் கைவிடுதல்"}, {"start": 82000, "end": 87040, "text": "புகைபிடிப்பதை உங்கள் மருத்துவர் பரிந்துரைக்கலாம்"}, {"start": 84799, "end": 89520, "text": "குறைக்க உதவும் சில மருந்துகள் மற்றும்"}, {"start": 87040, "end": 92479, "text": "நீங்கள் இருந்தால் உங்கள் கொலஸ்ட்ரால் அளவை நிர்வகிக்கவும்"}, {"start": 89520, "end": 94479, "text": "45 அல்லது அதற்கு மேற்பட்டவர்கள் அல்லது 30 வயதுக்கு மேற்பட்டவர்கள்"}, {"start": 92479, "end": 96320, "text": "பழங்குடியினர் அல்லது டோரஸ் ஜலசந்தி தீவுவாசி"}, {"start": 94479, "end": 98640, "text": "மக்கள் உங்கள் மருத்துவரைப் பார்க்கவும்"}, {"start": 96320, "end": 100880, "text": "இதயத்தின் ஒரு பகுதியாக கொலஸ்ட்ரால் சோதனை"}, {"start": 98640, "end": 102799, "text": "உடல்நலம் மற்றும் உங்களுக்கு குடும்பம் இருந்தால்"}, {"start": 100880, "end": 104880, "text": "முன்கூட்டிய இதய நோயின் வரலாறு அல்லது"}, {"start": 102799, "end": 106560, "text": "அதிக கொலஸ்ட்ரால் நீங்கள் பேச வேண்டும்"}, {"start": 104880, "end": 109560, "text": "உங்கள் இதய ஆரோக்கியம் பற்றி உங்கள் மருத்துவர்"}, {"start": 106560, "end": 109560, "text": "முன்பு"}]