[{"start": 3439, "end": 9960, "text": "அதிக உப்பு ஏன் மோசமானது"}, {"start": 6200, "end": 14240, "text": "நீங்கள்? அதிகமாக சாப்பிடுவது"}, {"start": 9960, "end": 14240, "text": "உப்பு உங்கள் இரத்தத்திற்கு தீங்கு விளைவிக்கும்"}, {"start": 15080, "end": 19680, "text": "அழுத்தம். உங்கள் சிறுநீரகங்கள் உங்களை கட்டுப்படுத்த உதவுகிறது"}, {"start": 17440, "end": 19680, "text": "இரத்தம்"}, {"start": 19880, "end": 26480, "text": "நீரை வெளியேற்றுவதன் மூலம் அழுத்தம்"}, {"start": 23560, "end": 28160, "text": "இரத்த ஓட்டம். உப்பில் சோடியம் உள்ளது. கூட"}, {"start": 26480, "end": 30400, "text": "உங்கள் இரத்தத்தில் உள்ள சோடியம் அதிகம்"}, {"start": 28160, "end": 33320, "text": "தண்ணீர் மீண்டும் உள்ளே. அதிக உப்பு என்றால் அதிகம்"}, {"start": 30400, "end": 35239, "text": "உங்கள் இரத்த நாளங்களில் நீர் மற்றும் அது"}, {"start": 33320, "end": 38719, "text": "[இசை]"}, {"start": 35239, "end": 38719, "text": "என்றால் உயர்ந்தது"}, {"start": 38760, "end": 44879, "text": "அழுத்தம். காலப்போக்கில், உயர் இரத்த அழுத்தம்"}, {"start": 41440, "end": 44879, "text": "உங்கள் இரத்த நாளங்களைச் செயல்பட வைக்கிறது"}, {"start": 45960, "end": 50960, "text": "சமாளிப்பது கடினம். அவற்றின் சுவர்கள் தடிமனாகின்றன,"}, {"start": 49200, "end": 53960, "text": "இரத்தத்தின் உள்ளே உள்ள இடத்தைக் குறைக்கிறது"}, {"start": 50960, "end": 53960, "text": "கப்பல்கள்."}, {"start": 54559, "end": 61800, "text": "உங்கள் இரத்த அழுத்தம் சீராக உயர்கிறது"}, {"start": 57480, "end": 64559, "text": "அதிகமாகவும் குறைவாகவும் இரத்தம் உங்களுக்கு கிடைக்கலாம்"}, {"start": 61800, "end": 67159, "text": "உறுப்புகள். இரத்தம் ஆக்ஸிஜன் மற்றும் பிறவற்றை எடுத்துச் செல்கிறது"}, {"start": 64559, "end": 69760, "text": "சுற்றியுள்ள ஊட்டச்சத்துக்கள்"}, {"start": 67159, "end": 74880, "text": "உடல். உங்கள் இதயத்திற்கு குறைவான இரத்தம் ஏற்படலாம்"}, {"start": 69760, "end": 74880, "text": "ஆஞ்சினா அல்லது இதயம் எனப்படும் வலி"}, {"start": 78040, "end": 85280, "text": "தாக்குதல். உங்கள் மூளைக்கு குறைவான இரத்தம் வரலாம்"}, {"start": 80880, "end": 87040, "text": "பக்கவாதம் அல்லது ஒரு வகை டிமென்ஷியாவை ஏற்படுத்தும்."}, {"start": 85280, "end": 91119, "text": "உயர் இரத்த அழுத்தம் பங்களிக்கிறது"}, {"start": 87040, "end": 91119, "text": "பாதி மாரடைப்பு மற்றும்"}, {"start": 91720, "end": 99040, "text": "பக்கவாதம். 11 வயதுக்கு மேற்பட்ட பெரியவர்கள் மற்றும் குழந்தைகள்"}, {"start": 94720, "end": 99040, "text": "உப்பை 6 கிராமுக்கு மேல் சாப்பிடக்கூடாது a"}, {"start": 101880, "end": 108759, "text": "நாள். 6 கிராம் என்பது ஒரு நிலை"}, {"start": 105479, "end": 110960, "text": "தேக்கரண்டி அளவு. இது 2.4 கிராம் போன்றது"}, {"start": 108759, "end": 113960, "text": "சோடியம். சிறிய குழந்தைகள் சாப்பிட வேண்டும்"}, {"start": 110960, "end": 113960, "text": "குறைவு."}, {"start": 114000, "end": 118759, "text": "நாம் உண்ணும் உப்பில் 3/4 பங்கு மறைந்துள்ளது"}, {"start": 116399, "end": 121520, "text": "ஆயத்தமானது"}, {"start": 118759, "end": 126000, "text": "உணவு. அவர்கள் உப்பு கூட சுவைக்க மாட்டார்கள்,"}, {"start": 121520, "end": 126000, "text": "ரொட்டி மற்றும் காலை உணவு போன்றவை"}, {"start": 126759, "end": 133040, "text": "தானியங்கள். உங்களால் என்ன முடியும்"}, {"start": 130120, "end": 135760, "text": "செய்யவா? உணவு லேபிள்களை சரிபார்க்கவும். வண்ணத்தைப் பயன்படுத்தவும்"}, {"start": 133040, "end": 137840, "text": "குறியீடுகள் உப்பு குறைவாக உள்ளது. பிராண்டுகளைத் தேர்ந்தெடுக்கவும்"}, {"start": 135760, "end": 141160, "text": "குறைந்த உப்பு. சிலருக்கு குறைவாகவும் உள்ளது"}, {"start": 137840, "end": 141160, "text": "உப்பு பதிப்புகள்."}, {"start": 141360, "end": 146239, "text": "நீங்கள் சமைக்கும் போது உப்பு சேர்க்க வேண்டாம். சேர்"}, {"start": 143440, "end": 148959, "text": "கருப்பு மிளகு, மூலிகைகள், மசாலாப் பொருட்கள்,"}, {"start": 146239, "end": 148959, "text": "மற்றும் எலுமிச்சை"}, {"start": 151160, "end": 155840, "text": "சாறு. உப்பு நிறைந்த உணவுகளைக் கண்டுபிடிக்க முடியுமா?"}, {"start": 154239, "end": 158840, "text": "ph.org.uk/salty-surprises."}, {"start": 155840, "end": 158840, "text": "uk/salty-surprises."}]