[{"start": 0, "end": 1480, "text": "நீங்கள் செய்யக்கூடிய சில விஷயங்கள் இங்கே உள்ளன"}, {"start": 1480, "end": 2720, "text": "நன்றாக உணர,"}, {"start": 2720, "end": 5680, "text": "மற்றும் இதய செயலிழப்பு விளைவுகளை நிர்வகிக்கவும்."}, {"start": 5680, "end": 8480, "text": "முதலில், பரிந்துரைக்கப்பட்டபடி உங்கள் மருந்தை எடுத்துக் கொள்ளுங்கள்"}, {"start": 8480, "end": 10120, "text": "உங்கள் மருத்துவரால்."}, {"start": 10120, "end": 11760, "text": "உங்கள் திரவங்களை நிர்வகிக்கவும்."}, {"start": 11760, "end": 13400, "text": "உங்கள் உட்கொள்ளலைக் கண்காணியுங்கள்,"}, {"start": 13400, "end": 15480, "text": "மற்றும் உப்பு போன்றவற்றை தவிர்க்கவும்,"}, {"start": 15480, "end": 18320, "text": "இது உங்கள் உடலில் திரவத்தை வைத்திருக்கும்."}, {"start": 18320, "end": 20320, "text": "உங்கள் தினசரி திரவ வரம்புக்கு கீழே இருக்கவும்"}, {"start": 20320, "end": 21800, "text": "உங்கள் மருத்துவர் உங்களுக்கு ஒன்றைக் கொடுத்தால்."}, {"start": 23320, "end": 25600, "text": "மது அருந்துவதைக் குறைக்கவும்"}, {"start": 25600, "end": 29320, "text": "உங்கள் இதயத்தைப் பாதுகாக்க புகைபிடிக்காதீர்கள்."}, {"start": 29320, "end": 32080, "text": "உங்கள் உடல்நலப் பாதுகாப்புக் குழுவுடன் பேச நினைவில் கொள்ளுங்கள்"}, {"start": 32080, "end": 34480, "text": "குறைவாக குடிக்க உங்களுக்கு உதவி தேவைப்பட்டால்,"}, {"start": 34480, "end": 36160, "text": "அல்லது சிகரெட்டை நிறுத்த வேண்டும்."}, {"start": 37200, "end": 39840, "text": "குறைவாக உட்கார்ந்து, வழக்கமான உடல் செயல்பாடு"}, {"start": 39840, "end": 42560, "text": "உங்கள் இதயத்திற்கும், உங்கள் மனதிற்கும் முக்கியமானது,"}, {"start": 42560, "end": 44920, "text": "மற்றும் உங்கள் முழு உடலும்."}, {"start": 44920, "end": 46520, "text": "இதய ஆரோக்கியமான உணவு"}, {"start": 46520, "end": 48320, "text": "நிறைய புதிய உணவுகளுடன்,"}, {"start": 48320, "end": 51600, "text": "பழங்கள், காய்கறிகள் மற்றும் முழு தானியங்கள் நிறைந்தது,\nஉங்கள் இதயத்தை கவனித்துக்கொள்வதில்"}, {"start": 51600, "end": 54720, "text": "மிகவும் முக்கியம்."}, {"start": 55720, "end": 58080, "text": "தடுப்பூசிகளுடன் புதுப்பித்த நிலையில் இருங்கள்"}, {"start": 58080, "end": 60600, "text": "மற்றும் உங்கள் மருத்துவருடன் தொடர்ந்து தொடர்பு கொள்ளுங்கள்"}, {"start": 60600, "end": 62600, "text": "மற்றும் சுகாதாரக் குழு."}, {"start": 62600, "end": 64200, "text": "அவர்களுடன் பேச தயங்காதீர்கள்"}, {"start": 64200, "end": 65720, "text": "நீங்கள் உடல்நிலை சரியில்லாமல் இருந்தால்,"}, {"start": 65720, "end": 68360, "text": "அல்லது இதய செயலிழப்பு பற்றிய கவலைகள் உள்ளன."}, {"start": 68360, "end": 71240, "text": "மேலும் இதய செயலிழப்பை நிர்வகிப்பது பற்றி மேலும் அறிய,"}, {"start": 71240, "end": 73920, "text": "இந்தத் தொடரில் உள்ள மற்ற வீடியோக்களைப் பார்க்கவும்."}]