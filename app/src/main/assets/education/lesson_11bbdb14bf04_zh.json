[{"start": 8559, "end": 13200, "text": "定期的体力活动可以降低"}, {"start": 10719, "end": 16200, "text": "心脏病和循环系统疾病的风险"}, {"start": 13200, "end": 16200, "text": "35%。"}, {"start": 19439, "end": 23279, "text": "当您活动时，产生的热量"}, {"start": 21439, "end": 27359, "text": "通过你的肌肉增强你的身体"}, {"start": 23279, "end": 29359, "text": "温度，让您感觉温暖。"}, {"start": 27359, "end": 31279, "text": "你的心跳开始加快，"}, {"start": 29359, "end": 34079, "text": "将更多的血液泵送到您的肌肉"}, {"start": 31279, "end": 36160, "text": "正在使用。你的心脏也是一块肌肉。"}, {"start": 34079, "end": 38480, "text": "如果您经常活动，就会得到"}, {"start": 36160, "end": 40640, "text": "做大做强。你的肌肉是"}, {"start": 38480, "end": 42239, "text": "工作更加努力，所以他们需要更多"}, {"start": 40640, "end": 44079, "text": "氧气。"}, {"start": 42239, "end": 46000, "text": "你开始呼吸加快，所以你的"}, {"start": 44079, "end": 48480, "text": "血液可以从你的身体中吸收更多的氧气"}, {"start": 46000, "end": 50800, "text": "肺。你的肺部会更加努力地工作"}, {"start": 48480, "end": 53440, "text": "出现这种情况。一旦你的血液被采摘"}, {"start": 50800, "end": 56930, "text": "补氧，"}, {"start": 53440, "end": 58960, "text": "它移动您正在使用的肌肉，"}, {"start": 56930, "end": 62640, "text": "[音乐]"}, {"start": 58960, "end": 64879, "text": "给予他们所需的额外氧气。"}, {"start": 62640, "end": 66560, "text": "如果您经常活动，则更多"}, {"start": 64879, "end": 69200, "text": "毛细血管在你的肌肉中生长"}, {"start": 66560, "end": 71439, "text": "一直在工作。这就是原因之一"}, {"start": 69200, "end": 73200, "text": "活动开始感觉更容易结束"}, {"start": 71439, "end": 75040, "text": "时间。"}, {"start": 73200, "end": 78240, "text": "积极活动对于患有以下疾病的人来说非常有用"}, {"start": 75040, "end": 80479, "text": "糖尿病。如果您患有 2 型糖尿病，"}, {"start": 78240, "end": 82159, "text": "你的血液中葡萄糖含量过高，"}, {"start": 80479, "end": 85119, "text": "可能是因为你没有足够的"}, {"start": 82159, "end": 87600, "text": "胰岛素。体力活动可以帮助您使用"}, {"start": 85119, "end": 89759, "text": "你所拥有的胰岛素。这也有帮助"}, {"start": 87600, "end": 92799, "text": "即使存在，您的细胞也会使用葡萄糖"}, {"start": 89759, "end": 94720, "text": "没有胰岛素。定期进行体力活动"}, {"start": 92799, "end": 97439, "text": "可以提高你的记忆力和注意力"}, {"start": 94720, "end": 99520, "text": "跨度。随着时间的推移，大脑的一部分"}, {"start": 97439, "end": 102759, "text": "似乎参与记忆和学习"}, {"start": 99520, "end": 102759, "text": "变得更大。"}, {"start": 104479, "end": 108880, "text": "长期的体力活动会导致"}, {"start": 106720, "end": 111280, "text": "降低静息心率和降低血液"}, {"start": 108880, "end": 114159, "text": "压力。这有助于降低您的风险"}, {"start": 111280, "end": 116960, "text": "心脏和循环系统疾病。"}, {"start": 114159, "end": 119119, "text": "并且还有更多微笑的理由。"}, {"start": 116960, "end": 121439, "text": "当你活跃时，你的大脑会产生"}, {"start": 119119, "end": 123200, "text": "称为内啡肽的化学物质。这些"}, {"start": 121439, "end": 125520, "text": "减少疼痛感并使您"}, {"start": 123200, "end": 127680, "text": "感觉更加积极。积极削减"}, {"start": 125520, "end": 130080, "text": "降低应激激素，减少"}, {"start": 127680, "end": 132000, "text": "焦虑。将活动与"}, {"start": 130080, "end": 134800, "text": "均衡饮食，你会自助的"}, {"start": 132000, "end": 137520, "text": "达到并维持健康体重。目标"}, {"start": 134800, "end": 140160, "text": "中等强度150分钟"}, {"start": 137520, "end": 145480, "text": "每周活动。尝试活跃起来"}, {"start": 140160, "end": 145480, "text": "每天。每 10 分钟都很重要。"}]