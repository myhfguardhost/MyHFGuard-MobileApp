[{"start": 1080, "end": 7440, "text": "நீங்கள் அதிக கொழுப்பைக் குறைக்க விரும்பினால்,"}, {"start": 3280, "end": 7440, "text": "உங்கள் உணவுமுறையில் செய்யும் எளிய மாற்றங்கள் உதவும்."}, {"start": 12840, "end": 17320, "text": "நிறைவுற்ற கொழுப்பு அதிகம் உள்ள உணவுகளை அதிகமாகச் சாப்பிடுவது உங்கள்"}, {"start": 14720, "end": 17320, "text": "கொழுப்பின் அளவை உயர்த்தக்கூடும்."}, {"start": 19360, "end": 23160, "text": "இந்த உணவுகளில் [இசை]"}, {"start": 20600, "end": 25545, "text": "பூரிதக் கொழுப்பு அதிகமாக உள்ளது.  ஆகவே, அவற்றை குறைவாக சாப்பிடுவது நல்லது"}, {"start": 23160, "end": 27960, "text": ".  கொழுப்பு நிறைந்த மற்றும் பதப்படுத்தப்பட்ட இறைச்சிகள்,"}, {"start": 25545, "end": 29280, "text": "[இசை] அதாவது மாட்டிறைச்சி, ஆட்டு இறைச்சி, சாசேஜ்கள்"}, {"start": 27960, "end": 32119, "text": "மற்றும் பன்றி இறைச்சி போன்றவை."}, {"start": 29280, "end": 35160, "text": "வெண்ணெய், பன்றிக்கொழுப்பு மற்றும் நெய், அத்துடன் முழுக்கொழுப்புள்ள"}, {"start": 32119, "end": 38080, "text": "பால், சீஸ் மற்றும் கிரீம்."}, {"start": 35160, "end": 40640, "text": "பனை மற்றும் தேங்காய் போன்ற வெப்பமண்டல எண்ணெய்கள்."}, {"start": 38080, "end": 42040, "text": "பேஸ்ட்ரிகள், பை வகைகள், பிஸ்கட்கள் மற்றும்"}, {"start": 40640, "end": 43520, "text": "கேக்குகள் போன்ற சுடப்பட்ட உணவுப் பொருட்கள்."}, {"start": 43520, "end": 49320, "text": "உணவுப் பொட்டலங்களில் உள்ள நிறைவுற்ற கொழுப்பு அமிலங்களைக் கண்டறிய, [இசை] போக்குவரத்து விளக்குக் குறியீடுகளையும் நீங்கள் சரிபார்க்கலாம்."}, {"start": 46280, "end": 52640, "text": "சிவப்பு நிறம் என்பது நிறைவுற்ற கொழுப்பு அதிகம் உள்ளதைக் குறிக்கிறது.  ஆகவே,"}, {"start": 49320, "end": 52640, "text": "இந்த உணவுகளை உட்கொள்வதைக் குறைத்துக் கொள்ள முயற்சி செய்யுங்கள்."}, {"start": 54640, "end": 58680, "text": "முட்டைகள், சிப்பிகள் மற்றும்"}, {"start": 56800, "end": 60260, "text": "கல்லீரல், சிறுநீரகம் போன்ற உறுப்பு இறைச்சிகளில்,"}, {"start": 60260, "end": 63640, "text": "உணவுக் கொலஸ்ட்ரால் எனப்படும் ஒரு வகை கொலஸ்ட்ரால் அடங்கியுள்ளது."}, {"start": 62680, "end": 65880, "text": "ஆனால், இது"}, {"start": 63640, "end": 67960, "text": "உங்கள் இரத்தத்தில் உள்ள கொலஸ்ட்ராலிலிருந்து வேறுபட்டது."}, {"start": 65880, "end": 69560, "text": "உணவில் உள்ள கொலஸ்ட்ரால்,"}, {"start": 67960, "end": 71000, "text": "இரத்தக் கொலஸ்ட்ராலில் மிகக் குறைந்த தாக்கத்தையே ஏற்படுத்துகிறது என்று ஆய்வுகள் தெரிவிக்கின்றன"}, {"start": 69560, "end": 72960, "text": "."}, {"start": 71000, "end": 75000, "text": "எனவே, பெரும்பாலான மக்கள் முட்டைகள்,"}, {"start": 72960, "end": 77200, "text": "சிப்பிகள் மற்றும் உறுப்பு இறைச்சிகளை"}, {"start": 75000, "end": 78960, "text": "ஆரோக்கியமான உணவின் ஒரு பகுதியாக உட்கொள்ளலாம்."}, {"start": 78960, "end": 82200, "text": "நிறைவுற்ற கொழுப்புகளைக் குறைப்பதுதான் மிகவும் முக்கியம்."}, {"start": 82200, "end": 86400, "text": "ஃபேமிலியல் ஹைப்பர்கொலஸ்ட்ரோலீமியா எனப்படும் மரபணு பாதிப்பு உங்களுக்கு இருந்தால்,"}, {"start": 86400, "end": 90600, "text": "முட்டை போன்ற உணவுகளில் உள்ள கொலஸ்ட்ரால் விஷயத்தில் நீங்கள் இன்னும் கவனமாக இருக்க வேண்டியிருக்கலாம்."}, {"start": 91320, "end": 94200, "text": "சில உணவுகள் உங்கள்"}, {"start": 92640, "end": 96560, "text": "கொலஸ்ட்ராலைக் குறைக்க உதவும்."}, {"start": 94200, "end": 99080, "text": "ஆலிவ் அல்லது காய்கறி எண்ணெய்கள் போன்ற நிறைவுறாக் கொழுப்புகள்"}, {"start": 96560, "end": 101040, "text": ", மற்றும்"}, {"start": 99080, "end": 102840, "text": "ஓட்ஸ், பார்லி போன்ற நார்ச்சத்து நிறைந்த உணவுகள்."}, {"start": 101040, "end": 104840, "text": "பீன்ஸ் மற்றும் பருப்பு வகைகள்."}, {"start": 102840, "end": 107120, "text": "கொட்டைகள் மற்றும் விதைகள்."}, {"start": 104840, "end": 109240, "text": "பழங்கள் மற்றும் காய்கறிகள்."}, {"start": 107120, "end": 111760, "text": "மேலும் நிபுணர் ஆலோசனைகள் மற்றும் வீடியோக்களுக்கு எங்கள் சேனலை சப்ஸ்கிரைப் செய்யுங்கள்"}, {"start": 109240, "end": 113240, "text": ".  அல்லது, உங்கள் இதய"}, {"start": 111760, "end": 116646, "text": "ஆரோக்கியம் தொடர்பான அனைத்து கேள்விகளுக்கும்,"}, {"start": 113240, "end": 116646, "text": "bhf.org.uk/hearthealth என்ற இணையதளத்தைப் பார்வையிடவும்.  [இசை]"}]