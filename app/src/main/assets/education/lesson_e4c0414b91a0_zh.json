[{"start": 0, "end": 1480, "text": "您可以执行以下操作"}, {"start": 1480, "end": 2720, "text": "为了感觉更好，"}, {"start": 2720, "end": 5680, "text": "并管理心力衰竭的影响。"}, {"start": 5680, "end": 8480, "text": "首先，按医嘱服药"}, {"start": 8480, "end": 10120, "text": "由您的医生决定。"}, {"start": 10120, "end": 11760, "text": "管理您的液体。"}, {"start": 11760, "end": 13400, "text": "记录您的摄入量，"}, {"start": 13400, "end": 15480, "text": "并避免诸如盐之类的东西，"}, {"start": 15480, "end": 18320, "text": "其可以容纳您体内的液体。"}, {"start": 18320, "end": 20320, "text": "保持在每日液体限制以下"}, {"start": 20320, "end": 21800, "text": "如果您的医生给了您一个。"}, {"start": 23320, "end": 25600, "text": "减少酒精摄入量"}, {"start": 25600, "end": 29320, "text": "并且不吸烟以保护您的心脏。"}, {"start": 29320, "end": 32080, "text": "请记住与您的医疗保健团队交谈"}, {"start": 32080, "end": 34480, "text": "如果您需要帮助少喝酒，"}, {"start": 34480, "end": 36160, "text": "或者戒烟。"}, {"start": 37200, "end": 39840, "text": "少坐，经常锻炼身体"}, {"start": 39840, "end": 42560, "text": "对你的心、你的思想很重要，"}, {"start": 42560, "end": 44920, "text": "和你的整个身体。"}, {"start": 44920, "end": 46520, "text": "心脏健康饮食"}, {"start": 46520, "end": 48320, "text": "大量新鲜食品，"}, {"start": 48320, "end": 51600, "text": "富含水果、蔬菜和全谷物，"}, {"start": 51600, "end": 54720, "text": "照顾您的心脏非常重要。"}, {"start": 55720, "end": 58080, "text": "及时了解疫苗接种情况"}, {"start": 58080, "end": 60600, "text": "并与您的医生保持定期联系"}, {"start": 60600, "end": 62600, "text": "和医疗保健团队。"}, {"start": 62600, "end": 64200, "text": "不要犹豫与他们交谈"}, {"start": 64200, "end": 65720, "text": "如果您感觉不适，"}, {"start": 65720, "end": 68360, "text": "或担心心力衰竭。"}, {"start": 68360, "end": 71240, "text": "为了了解更多关于管理心力衰竭的信息，"}, {"start": 71240, "end": 73920, "text": "观看本系列中的其他视频。"}]