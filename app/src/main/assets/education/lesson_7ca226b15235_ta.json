[{"start": 1680, "end": 4080, "text": "கொலஸ்ட்ராலுக்கு முட்டை நல்லதா அல்லது கெட்டதா?"}, {"start": 5160, "end": 7680, "text": "முட்டையில் உணவுக் கொலஸ்ட்ரால் உள்ளது."}, {"start": 7680, "end": 9200, "text": "இது மஞ்சள் கருவில் காணப்படுகிறது."}, {"start": 9200, "end": 12000, "text": "ஆனால் அது உங்கள் இரத்தத்தில் உள்ள கொலஸ்ட்ரால் போன்றது அல்ல."}, {"start": 12440, "end": 15000, "text": "பெரும்பாலான மக்களுக்கு, உணவில் உள்ள கொலஸ்ட்ரால்"}, {"start": 15000, "end": 18000, "text": "இரத்தக் கொழுப்பில் ஒரு சிறிய விளைவை மட்டுமே கொண்டுள்ளது."}, {"start": 18160, "end": 20720, "text": "இதன் பொருள் நீங்கள் ஒவ்வொரு நாளும் முட்டைகளை அனுபவிக்கலாம்"}, {"start": 20720, "end": 23720, "text": "ஆரோக்கியமான, சமச்சீர் உணவின் ஒரு பகுதியாக."}, {"start": 24160, "end": 27920, "text": "குடும்ப ஹைபர்கொலஸ்டிரோலேமியா எனப்படும் ஒரு நிலை உங்களுக்கு இருந்தால்,"}, {"start": 28240, "end": 29960, "text": "நீங்கள் உணவுகளில் கவனமாக இருக்க வேண்டும்"}, {"start": 29960, "end": 31880, "text": "இதில் உணவுக் கொலஸ்ட்ரால் உள்ளது"}, {"start": 31880, "end": 33200, "text": "முட்டைகள் உட்பட."}, {"start": 34000, "end": 35960, "text": "நிறைவுற்ற கொழுப்பு அதிகம் உள்ள உணவுகள்"}, {"start": 35960, "end": 39200, "text": "கொழுப்பு நிறைந்த இறைச்சிகள், வெண்ணெய் மற்றும் பேஸ்ட்ரிகள் போன்றவை"}, {"start": 39560, "end": 42800, "text": "முட்டைகளை விட இரத்தத்தில் உள்ள கொழுப்பை அதிகரிக்க அதிக வாய்ப்பு உள்ளது."}, {"start": 43360, "end": 45320, "text": "நிறைவுற்ற கொழுப்பைக் குறைத்தல்\nஉங்கள் கொலஸ்ட்ராலை ஆரோக்கியமாக வைத்திருக்க சிறந்த வழிகளில் ஒன்று"}, {"start": 45320, "end": 48600, "text": "உங்கள் கொலஸ்ட்ராலை ஆரோக்கியமாக வைத்திருக்க சிறந்த வழிகளில் ஒன்றாகும்"}, {"start": 49280, "end": 51280, "text": "எனவே முட்டைகள் வெண்ணெய் இல்லாமல் சமைக்கப்படுகின்றன"}, {"start": 51280, "end": 53280, "text": "வேட்டையாடப்பட்டது அல்லது வேகவைத்தது போன்றது"}, {"start": 53280, "end": 54880, "text": "ஆரோக்கியமான தேர்வாகும்."}]