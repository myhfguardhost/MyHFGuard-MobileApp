[{"start": 480, "end": 1400, "text": "你知道吗，"}, {"start": 1400, "end": 4360, "text": "您的心脏健康、肾脏健康和糖尿病"}, {"start": 4360, "end": 5560, "text": "都是有联系的吗？"}, {"start": 5760, "end": 7360, "text": "当一个人不健康时，"}, {"start": 7360, "end": 9760, "text": "它使你身体的其他部分更加努力地工作。"}, {"start": 10040, "end": 13520, "text": "糖尿病增加心脏病发作和中风的风险，"}, {"start": 13520, "end": 16280, "text": "患有心脏病的人的可能性加倍。"}, {"start": 16880, "end": 18960, "text": "糖尿病引起的高血糖"}, {"start": 18960, "end": 20520, "text": "会损伤血管"}, {"start": 20520, "end": 23000, "text": "并对您的心肌施加额外的压力。"}, {"start": 23280, "end": 25560, "text": "患有慢性肾病的人"}, {"start": 25560, "end": 28600, "text": "患心脏病的可能性增加超过50%。"}, {"start": 29400, "end": 32800, "text": "受损的肾脏会导致体内液体和废物积聚，"}, {"start": 33320, "end": 35400, "text": "迫使心脏更加努力地工作。"}, {"start": 35600, "end": 36760, "text": "CKM-"}, {"start": 36760, "end": 39680, "text": "心血管肾代谢综合征"}, {"start": 39680, "end": 43040, "text": "帮助我们更好地理解这些条件是如何联系的"}, {"start": 43040, "end": 44840, "text": "这样我们就可以一起管理它们。"}, {"start": 45600, "end": 48000, "text": "一些药物可以治疗您的糖尿病"}, {"start": 48000, "end": 50800, "text": "同时还能保护您的心脏和肾脏。"}, {"start": 51200, "end": 54720, "text": "好消息是有益于心脏健康的习惯可以保护您的整个身体。"}, {"start": 55080, "end": 58920, "text": "您可以通过食用有益于心脏健康的食物来降低风险，"}, {"start": 58920, "end": 60680, "text": "每天移动你的身体，"}, {"start": 60680, "end": 62800, "text": "保持健康的体重，"}, {"start": 62800, "end": 64360, "text": "限制饮酒，"}, {"start": 64360, "end": 66400, "text": "戒烟和吸电子烟，"}, {"start": 66400, "end": 68040, "text": "管理压力"}, {"start": 68040, "end": 72040, "text": "并控制您的血压、胆固醇和血糖。"}, {"start": 72920, "end": 76280, "text": "与您的家庭医生讨论心脏健康检查"}, {"start": 76280, "end": 80520, "text": "了解您在未来五年内心脏病发作或中风的风险。"}, {"start": 81000, "end": 83600, "text": "在此检查期间，您的全科医生还可以"}, {"start": 83600, "end": 86040, "text": "跟踪您的肾脏健康和糖尿病。"}, {"start": 87000, "end": 89600, "text": "心脏健康的习惯有助于您的整个身体茁壮成长。"}, {"start": 89600, "end": 91680, "text": "立即预约心脏健康检查。"}]