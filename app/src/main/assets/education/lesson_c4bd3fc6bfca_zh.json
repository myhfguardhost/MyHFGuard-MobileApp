[{"start": 0, "end": 1960, "text": "什么是心力衰竭？"}, {"start": 1960, "end": 3920, "text": "你的心脏是一块肌肉"}, {"start": 3920, "end": 6400, "text": "将血液泵送到您身体的每个部位。"}, {"start": 8720, "end": 10680, "text": "心力衰竭是一种病症"}, {"start": 10680, "end": 12760, "text": "你的心肌不泵血的地方"}, {"start": 12760, "end": 14320, "text": "身体周围妥善。"}, {"start": 15800, "end": 18640, "text": "当你的心脏变大时就会发生这种情况，"}, {"start": 18640, "end": 20360, "text": "无力，或僵硬。"}, {"start": 22320, "end": 24560, "text": "心脏病发作和高血压"}, {"start": 24560, "end": 27080, "text": "是心力衰竭的常见原因。"}, {"start": 27080, "end": 29520, "text": "但还有许多其他的。"}, {"start": 29520, "end": 31160, "text": "询问您的医疗保健团队"}, {"start": 31160, "end": 33120, "text": "关于你的原因。"}, {"start": 34080, "end": 36520, "text": "当您的心脏不能正常跳动时，"}, {"start": 36520, "end": 39960, "text": "流向身体重要器官的血液减少。"}, {"start": 39960, "end": 43120, "text": "这会让您感到疲倦和头晕。"}, {"start": 43120, "end": 44840, "text": "患有心力衰竭的人"}, {"start": 44840, "end": 47240, "text": "可能会感到呼吸短促，"}, {"start": 47240, "end": 50520, "text": "或在少量努力后感觉气胀。"}, {"start": 50520, "end": 54760, "text": "身体周围的液体积聚也经常发生。"}, {"start": 54760, "end": 57520, "text": "当心脏泵血功能异常时，"}, {"start": 57520, "end": 59240, "text": "身体试图应对"}, {"start": 59240, "end": 62680, "text": "通过增加血流中的液体量。"}, {"start": 62680, "end": 65280, "text": "然后该流体可以从血流中泄漏"}, {"start": 65280, "end": 69120, "text": "进入肺、脚踝、腿或胃，"}, {"start": 69120, "end": 71080, "text": "您可能会注意到肿胀的地方。"}, {"start": 71080, "end": 74080, "text": "心力衰竭是一个严重的问题。"}, {"start": 74080, "end": 77000, "text": "但在家人、亲人的支持下，"}, {"start": 77000, "end": 78840, "text": "和您的医疗保健团队，"}, {"start": 78840, "end": 82440, "text": "您可以管理您的状况，改善您的健康，"}, {"start": 82440, "end": 84600, "text": "让事情做起来更容易"}, {"start": 84600, "end": 86640, "text": "这对您来说很重要。"}, {"start": 86640, "end": 88000, "text": "与您的医生交谈"}, {"start": 88000, "end": 90600, "text": "关于什么导致了您的心力衰竭。"}, {"start": 90600, "end": 93520, "text": "为了了解更多关于管理心力衰竭的信息，"}, {"start": 93520, "end": 96160, "text": "观看本系列中的其他视频。"}]