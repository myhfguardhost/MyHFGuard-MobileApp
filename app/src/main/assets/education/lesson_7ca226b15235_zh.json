[{"start": 1680, "end": 4080, "text": "鸡蛋对胆固醇有益还是有害？"}, {"start": 5160, "end": 7680, "text": "鸡蛋确实含有膳食胆固醇。"}, {"start": 7680, "end": 9200, "text": "它存在于蛋黄中。"}, {"start": 9200, "end": 12000, "text": "但它与血液中的胆固醇不同。"}, {"start": 12440, "end": 15000, "text": "对于大多数人来说，食物中的胆固醇"}, {"start": 15000, "end": 18000, "text": "仅对血液胆固醇有很小的影响。"}, {"start": 18160, "end": 20720, "text": "这意味着您每天都可以享用鸡蛋"}, {"start": 20720, "end": 23720, "text": "作为健康、均衡饮食的一部分。"}, {"start": 24160, "end": 27920, "text": "如果您患有家族性高胆固醇血症，"}, {"start": 28240, "end": 29960, "text": "你可能需要小心食物"}, {"start": 29960, "end": 31880, "text": "膳食中含有胆固醇"}, {"start": 31880, "end": 33200, "text": "包括鸡蛋。"}, {"start": 34000, "end": 35960, "text": "富含饱和脂肪的食物"}, {"start": 35960, "end": 39200, "text": "喜欢肥肉、黄油和糕点"}, {"start": 39560, "end": 42800, "text": "与鸡蛋相比，它们更容易升高血液胆固醇。"}, {"start": 43360, "end": 45320, "text": "减少饱和脂肪"}, {"start": 45320, "end": 48600, "text": "是保持胆固醇健康的最佳方法之一"}, {"start": 49280, "end": 51280, "text": "所以鸡蛋煮熟不用黄油"}, {"start": 51280, "end": 53280, "text": "喜欢水煮或水煮"}, {"start": 53280, "end": 54880, "text": "是更健康的选择。"}]