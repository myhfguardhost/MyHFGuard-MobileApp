[{"start": 0, "end": 5609, "text": "[音乐]"}, {"start": 1429, "end": 7500, "text": "脂肪对你的身体有何作用？"}, {"start": 5609, "end": 9840, "text": "吃少量的脂肪作为一部分"}, {"start": 7500, "end": 12570, "text": "均衡饮食它提供了必需的"}, {"start": 9840, "end": 15509, "text": "脂肪酸和脂溶性维生素"}, {"start": 12570, "end": 18960, "text": "使您的身体保持运转，但脂肪"}, {"start": 15509, "end": 20820, "text": "1克脂肪含有热量高"}, {"start": 18960, "end": 24869, "text": "1 中发现的卡路里大约是两倍"}, {"start": 20820, "end": 26910, "text": "克碳水化合物或蛋白质"}, {"start": 24869, "end": 29760, "text": "意味着摄入过多的脂肪会导致"}, {"start": 26910, "end": 31920, "text": "体重增加超重或肥胖"}, {"start": 29760, "end": 34440, "text": "增加您患心脏病的风险"}, {"start": 31920, "end": 37770, "text": "高达 28%，即使您不这样做"}, {"start": 34440, "end": 41129, "text": "健康你吃的脂肪类型很重要"}, {"start": 37770, "end": 43920, "text": "食物中脂肪的主要种类"}, {"start": 41129, "end": 45660, "text": "它们有饱和的和不饱和的"}, {"start": 43920, "end": 48899, "text": "不同结构如此表现"}, {"start": 45660, "end": 50850, "text": "你的身体差异太大了"}, {"start": 48899, "end": 53579, "text": "饱和脂肪与增加"}, {"start": 50850, "end": 56010, "text": "不良非HDL胆固醇水平\n【0020】你的血液太不好了"}, {"start": 53579, "end": 57809, "text": "你的血液太糟糕了"}, {"start": 56010, "end": 60359, "text": "胆固醇会增加您患以下疾病的风险"}, {"start": 57809, "end": 62129, "text": "心脏和循环系统疾病脂肪"}, {"start": 60359, "end": 64530, "text": "沉积物会在您的动脉中积聚"}, {"start": 62129, "end": 68250, "text": "随着时间的推移，这会导致症状"}, {"start": 64530, "end": 70890, "text": "心绞痛甚至心脏病发作都"}, {"start": 68250, "end": 74159, "text": "脂肪和油含有饱和和"}, {"start": 70890, "end": 77310, "text": "我们根据不饱和脂肪对它们进行分类"}, {"start": 74159, "end": 79860, "text": "他们最有的椰子油是什么"}, {"start": 77310, "end": 85170, "text": "酥油脂肪肉和奶酪含有"}, {"start": 79860, "end": 87750, "text": "植物油主要为饱和脂肪油类"}, {"start": 85170, "end": 91680, "text": "鱼鳄梨坚果和种子含有"}, {"start": 87750, "end": 94320, "text": "不饱和脂肪主要是反式脂肪"}, {"start": 91680, "end": 98009, "text": "另一种类型的脂肪可以在非"}, {"start": 94320, "end": 100170, "text": "少量的HDL胆固醇水平是"}, {"start": 98009, "end": 103320, "text": "存在于肉类和乳制品以及反式脂肪中"}, {"start": 100170, "end": 105659, "text": "过去被添加到食品中，但现在"}, {"start": 103320, "end": 107850, "text": "英国制造商已移除此类型"}, {"start": 105659, "end": 109950, "text": "由于其产品中的脂肪"}, {"start": 107850, "end": 113130, "text": "这是我们现在反式脂肪的摄入量"}, {"start": 109950, "end": 115950, "text": "低于推荐的最大参考值"}, {"start": 113130, "end": 118920, "text": "我们的眼睛让您了解如何"}, {"start": 115950, "end": 123650, "text": "吃多少脂肪他们都是最大的不是一个"}, {"start": 118920, "end": 126470, "text": "ri4脂肪的目标是每天70克"}, {"start": 123650, "end": 128420, "text": "一汤匙油或足够的涂抹酱"}, {"start": 126470, "end": 133910, "text": "对于一块面包都是左右"}, {"start": 128420, "end": 137750, "text": "10克即70克20以内"}, {"start": 133910, "end": 139700, "text": "英国应克饱和脂肪"}, {"start": 137750, "end": 142190, "text": "我们大多数人不需要太多的脂肪"}, {"start": 139700, "end": 146900, "text": "总体来说我们确实吃得太多饱和了"}, {"start": 142190, "end": 150290, "text": "将饱和脂肪交换为不饱和脂肪"}, {"start": 146900, "end": 154370, "text": "帮助降低你的胆固醇互换"}, {"start": 150290, "end": 158720, "text": "奶酪换为牛油果换成肥肉"}, {"start": 154370, "end": 162170, "text": "油性鱼将巧克力换成无盐的"}, {"start": 158720, "end": 165710, "text": "坚果对比食品标签做出"}, {"start": 162170, "end": 167810, "text": "最健康的选择是用油代替"}, {"start": 165710, "end": 170840, "text": "用于烹饪的黄油猪油或酥油和"}, {"start": 167810, "end": 175640, "text": "测量每茶匙油的用量"}, {"start": 170840, "end": 178940, "text": "添加25卡路里选择瘦肉这样"}, {"start": 175640, "end": 183200, "text": "如去皮火鸡或鸡肉或有"}, {"start": 178940, "end": 185570, "text": "豆类、鸡蛋或鱼代替"}, {"start": 183200, "end": 189080, "text": "bhf正在资助对脂肪的更多研究"}, {"start": 185570, "end": 191570, "text": "以及它如何影响您的健康 了解一下"}, {"start": 189080, "end": 195160, "text": "更多信息请参见 bhf dot org dot uk'"}, {"start": 191570, "end": 195160, "text": "削减脂肪研究"}]