[{"start": 1440, "end": 4920, "text": "ஆஸ்திரேலிய பெரியவர்களில் 30% பேருக்கு உயர் இரத்தம் உள்ளது"}, {"start": 3760, "end": 7280, "text": "அழுத்தம்."}, {"start": 4920, "end": 10120, "text": "இது இதய நோய், பக்கவாதம்,"}, {"start": 7280, "end": 12280, "text": "மற்றும் சிறுநீரக நோய், ஆனால் அது ஒரு வாழ்க்கை அல்ல"}, {"start": 10120, "end": 14200, "text": "வாக்கியம். உயர் இரத்த அழுத்தம் இருக்கலாம்"}, {"start": 12280, "end": 15800, "text": "ஆரோக்கியமான மூலம் தடுக்கப்பட்டது அல்லது குறைக்கப்பட்டது"}, {"start": 14200, "end": 18160, "text": "வாழ்க்கைத் தேர்வுகள்."}, {"start": 15800, "end": 20920, "text": "உங்கள் அழுத்தத்தைக் குறைப்பது எப்படி என்பது இங்கே."}, {"start": 18160, "end": 23880, "text": "ஐந்து வகையான காய்கறிகளை உண்ண வேண்டும்"}, {"start": 20920, "end": 25760, "text": "ஒவ்வொரு நாளும் இரண்டு பழங்கள்."}, {"start": 23880, "end": 26680, "text": "ஒவ்வொரு முறையும் குறைந்தது 30 நிமிடங்களாவது சுறுசுறுப்பாக இருங்கள்"}, {"start": 25760, "end": 28600, "text": "நாள்."}, {"start": 26680, "end": 32200, "text": "சவாரி, நடக்க,"}, {"start": 28600, "end": 32200, "text": "அல்லது நீங்கள் விரும்பும் செயலை முயற்சிக்கவும்."}, {"start": 32240, "end": 36400, "text": "புகைபிடிப்பதை நிறுத்துங்கள்."}, {"start": 33960, "end": 39080, "text": "மது அருந்துவதைக் கட்டுப்படுத்துங்கள்."}, {"start": 36400, "end": 41160, "text": "உப்பு நிறைந்த உணவுகளைக் குறைக்கவும். எப்போதும் சரிபார்க்கவும்"}, {"start": 39080, "end": 44640, "text": "உணவு லேபிள் மற்றும் தயாரிப்புகளைத் தேர்வு செய்யவும்"}, {"start": 41160, "end": 46640, "text": "குறைந்தது சோடியம். ஆரோக்கியமான எடையை பராமரிக்கவும்."}, {"start": 44640, "end": 48240, "text": "இந்த சிறிய மாற்றங்களைச் செய்து, அதைச் செய்யுங்கள்"}, {"start": 46640, "end": 49840, "text": "தொடர்ந்து இரத்த அழுத்த பரிசோதனைகள் செய்ய வேண்டும்"}, {"start": 48240, "end": 53400, "text": "உங்கள் அழுத்தம் குறைகிறது."}, {"start": 49840, "end": 53400, "text": "மேலும் அறிய எங்கள் இணையதளத்தைப் பார்வையிடவும்."}]