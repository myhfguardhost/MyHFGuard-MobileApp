[{"start": 0, "end": 5650, "text": "[இசை]"}, {"start": 2370, "end": 8800, "text": "ஏன் மத்திய தரைக்கடல் உணவு நல்லது"}, {"start": 5650, "end": 10870, "text": "உங்கள் இதயம் ஆரோக்கியமாக இருக்கும் போது"}, {"start": 8800, "end": 14440, "text": "சாப்பிடுவதைப் பார்த்து நாம் நிறைய கற்றுக்கொள்ளலாம்"}, {"start": 10870, "end": 16179, "text": "உலகம் முழுவதும் உள்ள ஆய்வுகள் அதைக் காட்டுகின்றன"}, {"start": 14440, "end": 18759, "text": "பாரம்பரியத்தை உண்பவர்கள்"}, {"start": 16179, "end": 20380, "text": "மத்திய தரைக்கடல் உணவு ஆரோக்கிய நன்மைகளை அனுபவிக்கிறது"}, {"start": 18759, "end": 24519, "text": "இதய நோய் குறைந்த விகிதங்கள் உட்பட"}, {"start": 20380, "end": 26529, "text": "பக்கவாதம் மற்றும் டைப் 2 நீரிழிவு உங்களுக்கு இருக்கலாம்"}, {"start": 24519, "end": 30390, "text": "ஒரு மத்திய தரைக்கடல் உணவு என்று நினைக்கிறேன்"}, {"start": 26529, "end": 34480, "text": "நிறைய பீட்சா மற்றும் பாஸ்தா ஆனால் அது இல்லை"}, {"start": 30390, "end": 36730, "text": "மத்திய தரைக்கடல் உணவில் என்ன இருக்கிறது"}, {"start": 34480, "end": 38800, "text": "உண்மையான உணவு இப்பகுதி முழுவதும் மாறுபடும்"}, {"start": 36730, "end": 41530, "text": "ஆனால் முக்கிய கூறுகள் ஏராளமாக உள்ளன"}, {"start": 38800, "end": 44170, "text": "பழங்கள் மற்றும் காய்கறிகள் மீன் இரண்டும் வெள்ளை"}, {"start": 41530, "end": 46450, "text": "மீன் மற்றும் மத்தி போன்ற எண்ணெய் மீன்கள் மற்றும்"}, {"start": 44170, "end": 49180, "text": "சால்மன் முழு தானிய தானியங்கள் போன்றவை"}, {"start": 46450, "end": 51180, "text": "முழு ரொட்டி மற்றும் பழுப்பு அரிசி பீன்ஸ் மற்றும்"}, {"start": 49180, "end": 54730, "text": "கொண்டைக்கடலை மற்றும் பருப்பு போன்ற பருப்பு வகைகள்"}, {"start": 51180, "end": 57460, "text": "உப்பு சேர்க்காத கொட்டைகள் மற்றும் விதைகள் சிறிய அளவில்"}, {"start": 54730, "end": 60790, "text": "ஒல்லியான இறைச்சி மற்றும் குறைந்த கொழுப்புள்ள பால் ஆலிவ் எண்ணெய்"}, {"start": 57460, "end": 62829, "text": "புதிய மூலிகைகள் வெங்காயம் மற்றும் பூண்டு சில"}, {"start": 60790, "end": 66939, "text": "மக்கள் மது இந்த வழியில் ஒரு பகுதியாக நினைக்கிறார்கள்"}, {"start": 62829, "end": 68710, "text": "சாப்பிடுவது ஆனால் நீங்கள் குடித்தால் அது விருப்பமானது"}, {"start": 66939, "end": 71109, "text": "மதுவை உள்ளே வைத்திருப்பது முக்கியம்"}, {"start": 68710, "end": 73840, "text": "மிதமான மற்றும் பானம் 14 க்கு மேல் இல்லை\nவாரத்திற்கு"}, {"start": 71109, "end": 76600, "text": "யூனிட்கள் ஆனால் அது எல்லாம் இல்லை"}, {"start": 73840, "end": 78579, "text": "உணவு மற்றும் பானம் மற்ற பாரம்பரிய"}, {"start": 76600, "end": 81369, "text": "மத்திய தரைக்கடல் வாழ்க்கை முறை பழக்கங்களும் உள்ளன"}, {"start": 78579, "end": 83679, "text": "போன்ற விளைவுகளின் பகுதியாக இருக்கலாம்"}, {"start": 81369, "end": 85479, "text": "மெதுவாக சாப்பிடுவது மற்றும் மற்றவர்களுடன் முன்னணி"}, {"start": 83679, "end": 89229, "text": "மிகவும் நிதானமான வாழ்க்கை முறை மற்றும் செய்வது"}, {"start": 85479, "end": 91209, "text": "வழக்கமான உடல் செயல்பாடு ஆய்வுகள் உள்ளன"}, {"start": 89229, "end": 93369, "text": "கண்டறியப்பட்டது யார் மத்திய தரைக்கடல் சமூகங்கள்"}, {"start": 91209, "end": 97030, "text": "இந்த வழியில் சாப்பிட்டு வாழ்க"}, {"start": 93369, "end": 99880, "text": "இதயம் மற்றும் இரத்த ஓட்ட நோய் எப்படி முடியும்"}, {"start": 97030, "end": 101649, "text": "உணவு உங்கள் ஆபத்தை குறைக்க உதவுகிறது"}, {"start": 99880, "end": 103709, "text": "மத்தியதரைக் கடலின் ஆரோக்கிய நன்மைகள்"}, {"start": 101649, "end": 106479, "text": "உணவுமுறையானது ஒரு உணவுடன் இணைக்கப்படவில்லை"}, {"start": 103709, "end": 109149, "text": "அதற்குப் பதிலாக அவை உண்பதன் விளைவாகும்"}, {"start": 106479, "end": 113350, "text": "ஒட்டுமொத்தமாக மத்தியதரைக் கடல் உணவுமுறை"}, {"start": 109149, "end": 115539, "text": "ஆலிவ் எண்ணெயில் நிறைவுறா கொழுப்புகள் நிறைந்துள்ளது"}, {"start": 113350, "end": 118029, "text": "நன்கு அறியப்பட்ட உதாரணம் ஆனால் நிறைவுறாதது"}, {"start": 115539, "end": 120880, "text": "கொட்டைகள் மற்றும் எண்ணெய் போன்றவற்றிலும் கொழுப்புகள் காணப்படுகின்றன"}, {"start": 118029, "end": 123039, "text": "மீன் உணவில் இருந்து மாறுகிறது"}, {"start": 120880, "end": 125439, "text": "நிறைவுற்ற கொழுப்பில் இருந்து நிறைவுற்றது"}, {"start": 123039, "end": 128110, "text": "இது போன்ற கொழுப்புகள் உங்களை குறைக்க உதவும்"}, {"start": 125439, "end": 130540, "text": "கொலஸ்ட்ரால் அளவுகள் காலப்போக்கில் குறைகிறது"}, {"start": 128110, "end": 132760, "text": "மாரடைப்பு மற்றும் பக்கவாதம் ஏற்படும் அபாயம்"}, {"start": 130540, "end": 134810, "text": "புதிய பதப்படுத்தப்படாத உணவுகளில் கவனம் செலுத்த முடியும்"}, {"start": 132760, "end": 137180, "text": "உப்பைக் குறைக்க உதவுகிறது"}, {"start": 134810, "end": 139490, "text": "அதிக உப்பு சாப்பிடுவதாக ஆராய்ச்சி காட்டுகிறது"}, {"start": 137180, "end": 141020, "text": "உயர் இரத்த அழுத்தத்தை ஏற்படுத்தலாம்"}, {"start": 139490, "end": 144890, "text": "கீழே உங்கள் இரத்த அழுத்தத்தை வைத்திருக்க உதவும்"}, {"start": 141020, "end": 147050, "text": "ஆரோக்கியமான அளவில் நார்ச்சத்து நிறைந்த உணவு"}, {"start": 144890, "end": 150319, "text": "குறைந்த அளவுகளுடன் தொடர்புடையது"}, {"start": 147050, "end": 152870, "text": "இதய நோய் கரையக்கூடிய நார்ச்சத்து காணப்படுகிறது"}, {"start": 150319, "end": 154959, "text": "பருப்பு பீன்ஸ் பழங்கள் மற்றும் காய்கறிகள் முடியும்"}, {"start": 152870, "end": 157040, "text": "உங்கள் கொலஸ்ட்ரால் அளவைக் குறைக்க உதவுகிறது"}, {"start": 154959, "end": 159140, "text": "ஆய்வுகள் பின்வருமாறு காட்டுகின்றன"}, {"start": 157040, "end": 162050, "text": "மத்திய தரைக்கடல் உணவும் மக்களுக்கு உதவும்"}, {"start": 159140, "end": 165590, "text": "ஆரோக்கியமான எடையை பராமரிப்பது எப்படி என்பதை அறியவும்"}, {"start": 162050, "end": 170530, "text": "உங்கள் உணவை மத்தியதரைக் கடலுக்குச் செல்லுங்கள் bhf"}, {"start": 165590, "end": 170530, "text": "org dot uk' slash மேக் இட் மெட்"}]