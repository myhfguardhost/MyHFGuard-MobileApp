[{"start": 0, "end": 3000, "text": "எனவே, இதய செயலிழப்பு எப்படி என்பதைப் பற்றி பேசலாம்"}, {"start": 3000, "end": 4960, "text": "உங்களை உணர வைக்கும்."}, {"start": 4960, "end": 8000, "text": "சில நேரங்களில் நீங்கள் சுவாசிக்க கடினமாக இருக்கலாம்,"}, {"start": 8000, "end": 9960, "text": "குறிப்பாக நீங்கள் படுத்திருக்கும் போது"}, {"start": 9960, "end": 12080, "text": "அல்லது தூங்க முயற்சி."}, {"start": 12080, "end": 14760, "text": "உடலில் திரவம் தேங்குவதால்,"}, {"start": 14760, "end": 16720, "text": "இதய செயலிழப்பு வீக்கத்தை ஏற்படுத்தலாம்"}, {"start": 16720, "end": 20400, "text": "உங்கள் கணுக்கால், கால்கள் அல்லது வயிற்றில்."}, {"start": 21280, "end": 25360, "text": "நெஞ்சு வலி, உங்கள் இதயம் துடிக்கிறது."}, {"start": 25360, "end": 28320, "text": "அதிக இருமல், மற்றும் தலைசுற்றல்,"}, {"start": 28320, "end": 30360, "text": "மற்ற பொதுவான அறிகுறிகளாகும்."}, {"start": 32200, "end": 34560, "text": "மற்ற இதய செயலிழப்பு அறிகுறிகள் அடங்கும்,"}, {"start": 34560, "end": 38840, "text": "சோர்வு, பசியின்மை, மலச்சிக்கல்,"}, {"start": 40520, "end": 44200, "text": "அல்லது நோய்வாய்ப்பட்டிருப்பதைப் பற்றி சோகமாகவோ அல்லது கவலையாகவோ உணர்கிறேன்."}, {"start": 45640, "end": 50560, "text": "வீக்கம் மற்றும் திரவம் குவிவதை நீங்கள் கவனித்தால் நடவடிக்கை எடுக்கவும்."}, {"start": 50560, "end": 53880, "text": "அது மோசமடைவதை உங்களால் தடுக்க முடியும்."}, {"start": 53880, "end": 56720, "text": "மறைந்திருக்கும் திரவம் உருவாக்கப்படுவதைக் கவனிக்க ஒரு நல்ல வழி"}, {"start": 56720, "end": 59080, "text": "என்பது தினமும் செதில்களில் நிற்க வேண்டும்"}, {"start": 59080, "end": 61800, "text": "மற்றும் நான்கு W களைப் பின்பற்றவும்."}, {"start": 61800, "end": 62760, "text": "எழுந்திரு."}, {"start": 63800, "end": 65200, "text": "கழிப்பறையில் வீ."}, {"start": 66320, "end": 67560, "text": "உங்களை எடைபோடுங்கள்."}, {"start": 68440, "end": 69880, "text": "அதை எழுதவும்."}, {"start": 71720, "end": 75120, "text": "உங்கள் எடை 2 கிலோகிராம் அல்லது அதற்கு மேல் அதிகரித்திருப்பதை நீங்கள் கண்டால்"}, {"start": 75120, "end": 76960, "text": "இரண்டு நாட்களுக்குள்,"}, {"start": 76960, "end": 80600, "text": "24 மணி நேரத்திற்குள் உங்கள் சுகாதாரக் குழுவை அழைக்கவும்."}, {"start": 80600, "end": 82520, "text": "நீங்கள் கவலையாக இருந்தால் அல்லது அறிகுறிகள் இருந்தால்"}, {"start": 82520, "end": 83880, "text": "மோசமாகி வருகிறது,"}, {"start": 83880, "end": 86840, "text": "உங்கள் மருத்துவர், செவிலியரை அழைப்பது முக்கியம்,"}, {"start": 86840, "end": 88400, "text": "அல்லது சுகாதார பணியாளர்."}, {"start": 88400, "end": 90800, "text": "சில நேரங்களில் உங்களுக்கு அவசர உதவி தேவைப்படலாம்"}, {"start": 90800, "end": 92760, "text": "மற்றும் நீங்கள் தாமதிக்க வேண்டாம்."}, {"start": 92760, "end": 94400, "text": "கால் டிரிபிள் ஜீரோ (000)"}, {"start": 94400, "end": 96120, "text": "மற்றும் ஆம்புலன்ஸ் கேட்கவும்"}, {"start": 96120, "end": 100720, "text": "உங்கள் மார்பில் வலி, அழுத்தம் அல்லது இறுக்கம் இருந்தால்,"}, {"start": 100720, "end": 103720, "text": "கைகள், உடற்பகுதி அல்லது தாடை."}, {"start": 103720, "end": 106920, "text": "இது முக்கியமானது, டிரிபிள் ஜீரோவை அழைக்கவும் (000)"}, {"start": 106920, "end": 110280, "text": "நீங்கள் சரிந்தால் அல்லது சுவாசிப்பது மிகவும் கடினமாக இருந்தால்."}, {"start": 110280, "end": 113160, "text": "மேலும் இதய செயலிழப்பை நிர்வகிப்பது பற்றி மேலும் அறிய,"}, {"start": 113160, "end": 115840, "text": "இந்தத் தொடரில் உள்ள மற்ற வீடியோக்களைப் பார்க்கவும்."}]