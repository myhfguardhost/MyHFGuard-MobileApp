[{"start": 1440, "end": 4920, "text": "30% orang dewasa Australia mempunyai darah tinggi"}, {"start": 3760, "end": 7280, "text": "tekanan."}, {"start": 4920, "end": 10120, "text": "Ini boleh menyebabkan penyakit jantung, strok,"}, {"start": 7280, "end": 12280, "text": "dan penyakit buah pinggang, tetapi ia bukan kehidupan"}, {"start": 10120, "end": 14200, "text": "ayat. Darah tinggi boleh"}, {"start": 12280, "end": 15800, "text": "dicegah atau diturunkan melalui sihat"}, {"start": 14200, "end": 18160, "text": "pilihan hidup."}, {"start": 15800, "end": 20920, "text": "Inilah cara untuk mengurangkan tekanan anda."}, {"start": 18160, "end": 23880, "text": "Matlamat untuk makan lima hidangan sayur-sayuran dan"}, {"start": 20920, "end": 25760, "text": "dua hidangan buah setiap hari."}, {"start": 23880, "end": 26680, "text": "Aktif sekurang-kurangnya 30 minit setiap"}, {"start": 25760, "end": 28600, "text": "hari."}, {"start": 26680, "end": 32200, "text": "Menunggang, berjalan,"}, {"start": 28600, "end": 32200, "text": "atau cuba aktiviti yang anda suka."}, {"start": 32240, "end": 36400, "text": "Berhenti merokok."}, {"start": 33960, "end": 39080, "text": "Hadkan pengambilan alkohol anda."}, {"start": 36400, "end": 41160, "text": "Kurangkan makanan masin. Sentiasa semak"}, {"start": 39080, "end": 44640, "text": "label makanan dan pilih produk dengan"}, {"start": 41160, "end": 46640, "text": "kurang natrium. Kekalkan berat badan yang sihat."}, {"start": 44640, "end": 48240, "text": "Buat perubahan kecil ini dan lakukan"}, {"start": 46640, "end": 49840, "text": "pemeriksaan tekanan darah biasa untuk dikekalkan"}, {"start": 48240, "end": 53400, "text": "tekanan anda turun."}, {"start": 49840, "end": 53400, "text": "Lawati tapak web kami untuk mengetahui lebih lanjut."}]